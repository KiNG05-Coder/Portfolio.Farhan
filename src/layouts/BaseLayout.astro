---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter, fade } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { link } from '../lib/link';

export interface Props {
  title?: string;
  description?: string;
  /** Path used for the canonical URL, e.g. "/argus-6". Defaults to current. */
  path?: string;
}

const {
  title = site.metaTitle,
  description = site.metaDescription,
  path,
} = Astro.props;

const canonicalPath = path ? link(path) : Astro.url.pathname;
const canonical = new URL(canonicalPath, Astro.site ?? site.url).href;
const fullTitle = title === site.metaTitle ? title : `${title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={link('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090b" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.metaTitle} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="sitemap" href={link('/sitemap-index.xml')} />

    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
    <main id="main" transition:animate={fade({ duration: '0.28s' })}>
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: fixed;
        top: 0.75rem;
        left: 0.75rem;
        z-index: 200;
        padding: 0.6rem 1rem;
        background: var(--accent);
        color: #04101f;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        border-radius: 6px;
        transform: translateY(-160%);
        transition: transform 0.2s var(--ease);
      }
      .skip-link:focus {
        transform: none;
      }
    </style>

    <script>
      // Shared scroll-reveal. Respects prefers-reduced-motion.
      const setup = () => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const els = [
          ...document.querySelectorAll<HTMLElement>('[data-reveal]'),
        ].filter((el) => el.dataset.revealBound !== 'true');
        els.forEach((el) => (el.dataset.revealBound = 'true'));
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
        );
        els.forEach((el) => io.observe(el));

        // Safety net: never leave content permanently hidden if the observer
        // is starved (e.g. the page was opened in a background tab).
        window.setTimeout(() => {
          els.forEach((el) => {
            const r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) {
              el.classList.add('is-visible');
            }
          });
        }, 2500);
      };

      setup();
      // Re-run after client-side navigations (view transitions).
      document.addEventListener('astro:page-load', setup);
    </script>

    <script>
      // Subtle pointer tilt for cards marked [data-tilt].
      // Skipped entirely for touch devices and reduced-motion users.
      const initTilt = () => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        const coarse = window.matchMedia('(pointer: coarse)').matches;
        if (reduce || coarse) return;

        const MAX = 4; // degrees
        document
          .querySelectorAll<HTMLElement>('[data-tilt]')
          .forEach((el) => {
            if (el.dataset.tiltBound === 'true') return;
            el.dataset.tiltBound = 'true';
            let raf = 0;

            const onMove = (e: PointerEvent) => {
              const r = el.getBoundingClientRect();
              const px = (e.clientX - r.left) / r.width - 0.5;
              const py = (e.clientY - r.top) / r.height - 0.5;
              cancelAnimationFrame(raf);
              raf = requestAnimationFrame(() => {
                el.style.transform =
                  `perspective(720px) rotateX(${(-py * MAX).toFixed(2)}deg) ` +
                  `rotateY(${(px * MAX).toFixed(2)}deg) translateY(-3px)`;
              });
            };
            const reset = () => {
              cancelAnimationFrame(raf);
              el.style.transform = '';
            };

            el.addEventListener('pointermove', onMove);
            el.addEventListener('pointerleave', reset);
            el.addEventListener('pointercancel', reset);
          });
      };

      initTilt();
      document.addEventListener('astro:page-load', initTilt);
    </script>

    <script>
      // Horizontal scroll/drag for [.scroll-x] strips (in-page TOC bars
      // and similar). Vertical wheel input maps to horizontal scroll, and
      // mouse/pen pointers can click-and-drag; touch keeps native scroll
      // untouched since it already scrolls the strip directly.
      const initScrollX = () => {
        const coarse = window.matchMedia('(pointer: coarse)').matches;

        document.querySelectorAll<HTMLElement>('.scroll-x').forEach((el) => {
          if (el.dataset.scrollxBound === 'true') return;
          el.dataset.scrollxBound = 'true';

          el.addEventListener(
            'wheel',
            (e: WheelEvent) => {
              if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
              if (el.scrollWidth <= el.clientWidth) return;
              const atStart = el.scrollLeft <= 0 && e.deltaY < 0;
              const atEnd =
                el.scrollLeft + el.clientWidth >= el.scrollWidth - 1 &&
                e.deltaY > 0;
              if (atStart || atEnd) return;
              e.preventDefault();
              el.scrollLeft += e.deltaY;
            },
            { passive: false }
          );

          if (coarse) return; // touch already drags the strip natively

          el.dataset.dragReady = 'true';
          const THRESHOLD = 6; // px of movement before a click becomes a drag
          let pending = false; // pointer is down, not yet decided click vs drag
          let dragging = false; // past the threshold — actively dragging
          let moved = false;
          let pointerId = -1;
          let startX = 0;
          let startScroll = 0;

          el.addEventListener('pointerdown', (e: PointerEvent) => {
            if (e.button !== 0 || el.scrollWidth <= el.clientWidth) return;
            pending = true;
            dragging = false;
            moved = false;
            pointerId = e.pointerId;
            startX = e.clientX;
            startScroll = el.scrollLeft;
            // Capture is deferred until real dragging starts (see
            // pointermove) — capturing on every pointerdown would
            // retarget the eventual mouseup/click to `el` and silently
            // break normal clicks on the links inside the strip.
          });
          el.addEventListener('pointermove', (e: PointerEvent) => {
            if (!pending) return;
            const dx = e.clientX - startX;
            if (!dragging) {
              if (Math.abs(dx) <= THRESHOLD) return;
              dragging = true;
              moved = true;
              el.classList.add('is-dragging');
              try {
                el.setPointerCapture(pointerId);
              } catch {}
            }
            el.scrollLeft = startScroll - dx;
          });
          const endDrag = () => {
            pending = false;
            dragging = false;
            el.classList.remove('is-dragging');
            // The browser's own trailing click (if any) fires
            // synchronously right after this and still needs to see
            // `moved` to suppress itself — clear it just after that,
            // so it never leaks into a later, unrelated click.
            window.setTimeout(() => {
              moved = false;
            }, 0);
          };
          el.addEventListener('pointerup', endDrag);
          el.addEventListener('pointercancel', endDrag);
          // Suppress the click a real drag ends on, so links inside the
          // strip aren't accidentally activated when the pointer settles
          // back over one. A plain click never sets `moved`, so it is
          // untouched here.
          el.addEventListener(
            'click',
            (e: MouseEvent) => {
              if (!moved) return;
              e.preventDefault();
              e.stopPropagation();
              moved = false;
            },
            true
          );
        });
      };

      initScrollX();
      document.addEventListener('astro:page-load', initScrollX);
    </script>

    <script>
      // ---- Scroll progress bar ----
      // ClientRouter swaps <body>, so re-resolve the bar each time.
      let bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
      const syncProgress = () => {
        if (!bar || !bar.isConnected) {
          bar = document.querySelector<HTMLElement>('[data-scroll-progress]');
        }
        if (!bar) return;
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const p = max > 4 ? Math.min(1, doc.scrollTop / max) : 0;
        bar.style.transform = `scaleX(${p.toFixed(4)})`;
      };
      window.addEventListener('scroll', syncProgress, { passive: true });
      window.addEventListener('resize', syncProgress);
      syncProgress();

      // ---- Parallax drift on [data-parallax] elements ----
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      let parallaxEls: HTMLElement[] = [];
      let ticking = false;
      const applyParallax = () => {
        ticking = false;
        const vh = window.innerHeight;
        for (const el of parallaxEls) {
          const rect = el.getBoundingClientRect();
          if (rect.bottom < -vh || rect.top > vh * 2) continue;
          const speed = parseFloat(el.dataset.parallax || '0.12');
          const mid = rect.top + rect.height / 2 - vh / 2;
          el.style.transform = `translate3d(0, ${(-mid * speed).toFixed(1)}px, 0)`;
        }
      };
      const onParallaxScroll = () => {
        if (ticking || reduceMotion) return;
        ticking = true;
        requestAnimationFrame(applyParallax);
      };
      if (!reduceMotion) {
        window.addEventListener('scroll', onParallaxScroll, { passive: true });
        window.addEventListener('resize', onParallaxScroll);
      }

      // ---- Headline decode ----
      // The final text is always restored, even if anything throws, so a
      // headline can never get stuck mid-scramble.
      const DECODE_CHARS = 'ABCDEFGHJKLMNPQRSTUVWXYZ0123456789#%<>/';
      const decode = (el: HTMLElement) => {
        const final = el.dataset.decodeText ?? el.textContent ?? '';
        el.dataset.decodeText = final;
        if (reduceMotion || !final.trim()) {
          el.textContent = final;
          return;
        }
        const chars = final.split('');
        const total = 26;
        let frame = 0;
        const settleAt = (i: number) =>
          Math.floor((i / Math.max(1, chars.length)) * (total - 8)) + 4;
        window.setTimeout(() => {
          if (el.textContent !== final) el.textContent = final;
        }, total * 32 + 400);
        const tick = () => {
          try {
            el.textContent = chars
              .map((c, i) => {
                if (c === ' ' || c === '\n') return c;
                if (frame >= settleAt(i)) return c;
                return DECODE_CHARS[
                  (Math.random() * DECODE_CHARS.length) | 0
                ];
              })
              .join('');
          } catch {
            el.textContent = final;
            return;
          }
          frame++;
          if (frame <= total) window.setTimeout(tick, 28);
          else el.textContent = final;
        };
        tick();
      };

      // ---- "In view" toggles for banded sections and signal flow ----
      const litObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-lit');
              litObserver.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.15 }
      );
      const flowObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            e.target.classList.toggle('flow-active', e.isIntersecting);
          }
        },
        { threshold: 0 }
      );

      const initMotion = () => {
        // parallax
        parallaxEls = [
          ...document.querySelectorAll<HTMLElement>('[data-parallax]'),
        ];
        if (!reduceMotion && parallaxEls.length) applyParallax();

        // decode
        document
          .querySelectorAll<HTMLElement>('[data-decode]')
          .forEach((el) => {
            if (el.dataset.decodeBound === 'true') return;
            el.dataset.decodeBound = 'true';
            decode(el);
          });

        // banded sections + flow blocks
        document
          .querySelectorAll('.section.band')
          .forEach((el) => litObserver.observe(el));
        document
          .querySelectorAll('[data-flow]')
          .forEach((el) => flowObserver.observe(el));

        syncProgress();
      };

      initMotion();
      document.addEventListener('astro:page-load', initMotion);
    </script>
  </body>
</html>
