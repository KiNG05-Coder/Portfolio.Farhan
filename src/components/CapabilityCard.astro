---
import StatusBadge from './StatusBadge.astro';
import type { Capability } from '../data/capabilities';

export interface Props {
  capability: Capability;
}
const { capability } = Astro.props;
const { name, status, statusLabel, summary, details } = capability;
---

<article class="cap panel" data-reveal tabindex="0">
  <header class="cap__head">
    <h3 class="cap__name mono">{name}</h3>
    <StatusBadge status={status} label={statusLabel} size="sm" />
  </header>
  <p class="cap__summary">{summary}</p>
  {
    details.length > 0 && (
      <ul class="cap__details">
        {details.map((d) => (
          <li>{d}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .cap {
    padding: 1.4rem;
    display: grid;
    gap: 0.9rem;
    align-content: start;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .cap:hover,
  .cap:focus-visible {
    border-color: var(--accent-line);
    transform: translateY(-3px);
    background: var(--surface-raised);
  }
  .cap__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .cap__name {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cap__summary {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .cap__details {
    display: grid;
    gap: 0.5rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }
  .cap__details li {
    position: relative;
    padding-left: 1.1rem;
    font-size: 0.88rem;
    color: var(--text-dim);
  }
  .cap__details li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    background: var(--accent-line);
    border-radius: 1px;
  }
</style>
