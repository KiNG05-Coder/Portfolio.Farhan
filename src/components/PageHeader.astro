---
export interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---

<header class="ph">
  <span class="grid-bg" aria-hidden="true"></span>
  <div class="container ph__inner">
    <span class="eyebrow" data-reveal>{eyebrow}</span>
    <h1 class="ph__title" data-reveal>{title}</h1>
    {lead && <p class="ph__lead text-muted" data-reveal>{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .ph {
    position: relative;
    padding-block: clamp(5rem, 12vw, 8rem) clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--border);
    overflow: hidden;
  }
  .ph__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    max-width: 52rem;
  }
  .ph__title {
    font-size: clamp(2.2rem, 7vw, 4rem);
  }
  .ph__lead {
    font-size: clamp(1.05rem, 2.5vw, 1.3rem);
    max-width: 44ch;
  }
</style>
