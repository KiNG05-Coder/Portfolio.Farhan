---
import type { SkillGroup } from '../data/skills';

export interface Props {
  group: SkillGroup;
  index?: number;
}
const { group, index = 0 } = Astro.props;
---

<article class="sg panel" data-reveal style={`--reveal-delay:${index * 80}ms`}>
  <header class="sg__head">
    <span class="sg__num mono">{String(index + 1).padStart(2, '0')}</span>
    <h3 class="sg__title">{group.category}</h3>
  </header>
  <p class="sg__blurb text-muted">{group.blurb}</p>
  <ul class="sg__items">
    {group.items.map((item) => <li class="sg__item mono">{item}</li>)}
  </ul>
</article>

<style>
  .sg {
    padding: 1.5rem;
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .sg__head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .sg__num {
    font-size: 0.72rem;
    color: var(--accent);
  }
  .sg__title {
    font-size: 1.1rem;
  }
  .sg__blurb {
    font-size: 0.9rem;
  }
  .sg__items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sg__item {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-elev);
    color: var(--text-muted);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .sg__item:hover {
    border-color: var(--accent-line);
    color: var(--text);
  }
</style>
