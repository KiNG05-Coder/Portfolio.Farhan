---
import fs from 'node:fs';
import path from 'node:path';
import { link } from '../lib/link';

export interface Props {
  /** Path under /public, e.g. "/assets/argus-6/argus-6-hero.jpg". */
  src: string;
  /** Meaningful alt text. For placeholders, say that it is a placeholder. */
  alt: string;
  /** CSS aspect-ratio, e.g. "16 / 9". */
  ratio?: string;
  /** Text shown on the placeholder panel. */
  label?: string;
  /** Smaller caption under the label. */
  hint?: string;
  eager?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '16 / 9',
  label,
  hint,
  eager = false,
  class: className = '',
} = Astro.props;

const abs = path.join(process.cwd(), 'public', src.replace(/^\//, ''));
const exists = fs.existsSync(abs);

const autoLabel = label ?? 'IMAGE PLACEHOLDER — REPLACE WITH YOUR ORIGINAL';
---

<figure
  class:list={['asset', className, { 'asset--empty': !exists }]}
  style={`--ratio:${ratio}`}
  data-reveal
>
  {
    exists ? (
      <img
        src={link(src)}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="asset__ph" role="img" aria-label={alt}>
        <span class="asset__corner asset__corner--tl" aria-hidden="true" />
        <span class="asset__corner asset__corner--br" aria-hidden="true" />
        <span class="asset__badge mono">Placeholder</span>
        <span class="asset__label mono">{autoLabel}</span>
        {hint && <span class="asset__hint">{hint}</span>}
        <code class="asset__path">public{src}</code>
      </div>
    )
  }
</figure>

<style>
  .asset {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .asset img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .asset--empty {
    border-style: dashed;
    border-color: var(--border-strong);
  }

  .asset__ph {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: clamp(1rem, 4vw, 2rem);
    text-align: center;
    background-image: radial-gradient(
        var(--grid-line) 1px,
        transparent 1px
      ),
      radial-gradient(var(--grid-line) 1px, transparent 1px);
    background-size: 22px 22px;
    background-position: 0 0, 11px 11px;
  }

  .asset__badge {
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
  }

  .asset__label {
    font-size: clamp(0.68rem, 1.6vw, 0.8rem);
    letter-spacing: 0.12em;
    color: var(--text-muted);
    max-width: 30ch;
  }

  .asset__hint {
    font-size: 0.8rem;
    color: var(--text-dim);
    max-width: 40ch;
  }

  .asset__path {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-dim);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.2rem 0.5rem;
    border-radius: 5px;
    border: 1px solid var(--border);
  }

  .asset__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 1px solid var(--border-strong);
  }
  .asset__corner--tl {
    top: 10px;
    left: 10px;
    border-right: 0;
    border-bottom: 0;
  }
  .asset__corner--br {
    right: 10px;
    bottom: 10px;
    border-left: 0;
    border-top: 0;
  }
</style>
