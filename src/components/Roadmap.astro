---
import type { RoadmapPhase } from '../data/roadmap';

export interface Props {
  phases: RoadmapPhase[];
}
const { phases } = Astro.props;
---

<ol class="roadmap" data-reveal data-flow>
  {phases.map((p, i) => (
    <li class="roadmap__phase" style={`--i:${i}`}>
      <div class:list={['roadmap__card', 'panel', { 'roadmap__card--done': p.status === 'done' }]}>
        <header class="roadmap__head">
          <span class="roadmap__num mono">{p.phase}</span>
          <h3 class="roadmap__title">{p.title}</h3>
          <span class:list={['roadmap__badge', 'mono', p.status === 'done' ? 'roadmap__badge--done' : 'roadmap__badge--planned']}>
            {p.status === 'done' ? 'Working now' : 'Planned'}
          </span>
        </header>
        <p class="roadmap__summary text-muted">{p.summary}</p>
        <ul class="roadmap__items">
          {p.items.map((item) => (
            <li>
              <span class:list={['roadmap__mark', item.done ? 'roadmap__mark--done' : 'roadmap__mark--planned']} aria-hidden="true">
                {item.done ? '✓' : '○'}
              </span>
              {item.label}
            </li>
          ))}
        </ul>
      </div>
      {i < phases.length - 1 && (
        <span class="roadmap__connector" aria-hidden="true">
          <span class="roadmap__arrow">↓</span>
        </span>
      )}
    </li>
  ))}
</ol>

<style>
  .roadmap {
    display: grid;
    gap: 0;
    max-width: 640px;
    margin-inline: auto;
  }

  .roadmap__phase {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease);
    transition-delay: calc(var(--i) * 90ms);
  }
  [data-reveal].is-visible .roadmap__phase,
  .is-visible .roadmap__phase {
    opacity: 1;
    transform: none;
  }

  .roadmap__card {
    padding: clamp(1.4rem, 3vw, 2rem);
    display: grid;
    gap: 0.9rem;
    border-style: dashed;
    border-color: var(--border-strong);
  }
  .roadmap__card--done {
    border-style: solid;
    border-color: color-mix(in srgb, var(--status-working) 45%, var(--border));
    background: color-mix(in srgb, var(--status-working) 6%, var(--surface));
  }

  .roadmap__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .roadmap__num {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
  }
  .roadmap__title {
    font-size: 1.15rem;
    margin-right: auto;
  }
  .roadmap__badge {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
  }
  .roadmap__badge--done {
    color: var(--status-working);
    border-color: color-mix(in srgb, var(--status-working) 45%, transparent);
  }

  .roadmap__summary {
    font-size: 0.9rem;
  }

  .roadmap__items {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }
  @media (min-width: 520px) {
    .roadmap__items {
      grid-template-columns: 1fr 1fr;
    }
  }
  .roadmap__items li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .roadmap__mark {
    flex: none;
    font-size: 0.78rem;
  }
  .roadmap__mark--done {
    color: var(--status-working);
  }
  .roadmap__mark--planned {
    color: var(--text-dim);
  }

  .roadmap__connector {
    display: grid;
    place-items: center;
    height: 2.5rem;
    position: relative;
  }
  .roadmap__connector::before {
    content: '';
    position: absolute;
    inset: 0;
    width: 1px;
    margin-inline: auto;
    background: var(--border-strong);
  }
  .roadmap__arrow {
    position: relative;
    font-size: 0.9rem;
    color: var(--text-dim);
    background: var(--bg);
    padding: 0.2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .roadmap__phase {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
