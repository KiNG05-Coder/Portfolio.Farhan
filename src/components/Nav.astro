---
import fs from 'node:fs';
import path from 'node:path';
import { nav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/$/, '') || '/';

// Optional site logo. Drop a file at public/assets/branding/logo.png
// (or .svg) to replace the text wordmark automatically.
const logoCandidates = [
  '/assets/branding/logo.svg',
  '/assets/branding/logo.png',
];
const logo = logoCandidates.find((rel) =>
  fs.existsSync(path.join(process.cwd(), 'public', rel.replace(/^\//, '')))
);

const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  if (h === '/') return current === '/';
  return current === h || current.startsWith(h + '/');
};
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      {
        logo ? (
          <img src={logo} alt={`${site.name} logo`} height="28" />
        ) : (
          <>
            <span class="brand__mark" aria-hidden="true">FS</span>
            <span class="brand__text">{site.name}</span>
          </>
        )
      }
    </a>

    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="nav__toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="nav__toggle-label">Menu</span>
      <span class="nav__toggle-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="nav__mobile" id="mobile-nav" data-nav-mobile hidden>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav__link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }

  .nav[data-scrolled='true'] {
    border-bottom-color: var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
  }

  .brand__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--accent);
    background: var(--accent-soft);
  }

  .brand__text {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
  }

  .nav__links ul {
    display: flex;
    gap: 0.35rem;
  }

  .nav__link {
    display: inline-block;
    padding: 0.5rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-radius: 6px;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .nav__link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav__link.is-active {
    color: var(--text);
  }

  .nav__link.is-active::after {
    content: '';
    display: block;
    height: 1px;
    margin-top: 3px;
    background: var(--accent);
  }

  .nav__toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 7px;
  }

  .nav__toggle-bars {
    display: grid;
    gap: 4px;
  }
  .nav__toggle-bars i {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-bars i:first-child {
    transform: translateY(2.75px) rotate(45deg);
  }
  .nav__toggle[aria-expanded='true'] .nav__toggle-bars i:last-child {
    transform: translateY(-2.75px) rotate(-45deg);
  }

  .nav__mobile {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
    overflow: hidden;
  }
  .nav__mobile ul {
    display: grid;
    padding: 0.5rem clamp(1.15rem, 4vw, 2.5rem) 1.25rem;
  }
  .nav__mobile .nav__link {
    padding: 0.85rem 0.25rem;
    font-size: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  .nav__mobile .nav__link.is-active::after {
    display: none;
  }

  @media (max-width: 920px) {
    .nav__links {
      display: none;
    }
    .nav__toggle {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__mobile {
      transition: none;
    }
  }
</style>

<script>
  const syncScroll = () => {
    const header = document.querySelector<HTMLElement>('[data-nav]');
    if (header) header.dataset.scrolled = String(window.scrollY > 8);
  };

  const closeMobile = () => {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const mobile = document.querySelector<HTMLElement>('[data-nav-mobile]');
    if (toggle && mobile) {
      toggle.setAttribute('aria-expanded', 'false');
      mobile.hidden = true;
    }
  };

  // Window-level listeners: bound exactly once for the page's lifetime.
  window.addEventListener('scroll', syncScroll, { passive: true });
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobile();
  });

  const init = () => {
    syncScroll();
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const mobile = document.querySelector<HTMLElement>('[data-nav-mobile]');
    if (!toggle || !mobile || toggle.dataset.ready === 'true') return;
    toggle.dataset.ready = 'true';

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      mobile.hidden = open;
    });
    mobile
      .querySelectorAll('a')
      .forEach((a) => a.addEventListener('click', closeMobile));
  };

  init();
  document.addEventListener('astro:page-load', init);
</script>
