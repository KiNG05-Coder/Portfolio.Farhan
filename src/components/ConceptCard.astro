---
import type { Concept } from '../data/concepts';

export interface Props {
  concept: Concept;
}
const { concept } = Astro.props;
const { term, tag, summary, detail, reference } = concept;
---

<article class="concept panel" data-reveal data-tilt tabindex="0">
  <header class="concept__head">
    <h3 class="concept__term mono">{term}</h3>
    <span class:list={['concept__tag', 'mono', { 'concept__tag--tool': tag === 'Tool / resource' }]}>
      {tag}
    </span>
  </header>
  <p class="concept__summary">{summary}</p>
  <p class="concept__detail">{detail}</p>
  <p class="concept__ref mono">{reference}</p>
</article>

<style>
  .concept {
    padding: 1.4rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .concept:hover,
  .concept:focus-visible {
    border-color: var(--accent-line);
    transform: translateY(-3px);
    background: var(--surface-raised);
  }
  .concept__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .concept__term {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .concept__tag {
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--text-dim);
    white-space: nowrap;
  }
  .concept__tag--tool {
    color: var(--accent);
    border-color: var(--accent-line);
  }
  .concept__summary {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .concept__detail {
    color: var(--text-muted);
    font-size: 0.88rem;
    padding-top: 0.3rem;
    border-top: 1px solid var(--border);
  }
  .concept__ref {
    font-size: 0.72rem;
    color: var(--text-dim);
    letter-spacing: 0.02em;
  }
  .concept__ref::before {
    content: '→ ';
    color: var(--accent-line);
  }
</style>
