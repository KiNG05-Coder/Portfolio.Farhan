---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import SkillGroup from '../components/SkillGroup.astro';
import ProjectCard from '../components/ProjectCard.astro';
import AchievementCard from '../components/AchievementCard.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../data/site';
import { skillGroups } from '../data/skills';
import { projects } from '../data/projects';
import { achievements } from '../data/achievements';
import { link } from '../lib/link';
---

<BaseLayout
  title="Portfolio — Farhan Saif"
  description="About Farhan Saif — a Bangladeshi high school student who builds and tests real robotics projects, with skills in programming, electronics and robot development."
  path="/portfolio"
>
  <PageHeader
    eyebrow="Portfolio"
    title="Building to understand"
    lead="Who Farhan is, what he works with, and what he has built."
  />

  {/* ---------------- ABOUT ---------------- */}
  <section class="section about">
    <div class="container about__grid">
      <div class="about__text">
        <SectionHeading eyebrow="About" title="A student who builds" />
        <div class="prose" data-reveal>
          <p>{site.intro}</p>
          <p>
            Most of what I know comes from making things — wiring circuits,
            soldering, writing robot software and testing until it works. I like
            projects where engineering meets a real need: protecting the
            environment, or helping in situations that are hard or dangerous for
            people to reach.
          </p>
          <p>
            My approach is practical. I pick a problem, build a system to address
            it, run into the parts that are genuinely difficult, and work through
            them. Each project teaches the next one.
          </p>
        </div>
      </div>

      <aside class="about__aside" data-reveal>
        <Placeholder
          src="/assets/profile/farhan-workspace.jpg"
          alt="Placeholder for a photo of Farhan's workspace or bench — optional, replace if desired."
          ratio="4 / 5"
          label="OPTIONAL IMAGE — WORKSPACE / BENCH"
          hint="public/assets/profile/farhan-workspace.jpg"
        />
        <dl class="about__facts panel">
          <div>
            <dt class="mono">Based in</dt>
            <dd>Bangladesh</dd>
          </div>
          <div>
            <dt class="mono">Focus</dt>
            <dd>Robotics for real-world problems</dd>
          </div>
          <div>
            <dt class="mono">Flagship project</dt>
            <dd><a href={link('/argus-6')}>ARGUS-6</a></dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  {/* ---------------- SKILLS ---------------- */}
  <section class="section skills" id="skills">
    <div class="container">
      <SectionHeading
        eyebrow="Skills"
        title="Technical skills"
        lead="Organised by area. These are tools and skills used in real projects — no skill levels or certifications are implied."
      />
      <div class="skills__grid">
        {skillGroups.map((g, i) => <SkillGroup group={g} index={i} />)}
      </div>
    </div>
  </section>

  {/* ---------------- PROJECTS ---------------- */}
  <section class="section projects" id="projects">
    <div class="container">
      <SectionHeading
        eyebrow="Projects"
        title="What I've built"
        lead="Two projects: one flagship autonomous robot in active development, and one completed environmental robotics system."
      />
      <div class="projects__list">
        {projects.map((p, i) => <ProjectCard project={p} featured={i === 0} />)}
      </div>
    </div>
  </section>

  {/* ---------------- ACHIEVEMENTS ---------------- */}
  <section class="section achievements" id="achievements">
    <div class="container">
      <SectionHeading
        eyebrow="Achievements"
        title="Confirmed achievements"
        lead="Only awards that have actually been received. Certificate images can be added when available."
      />
      <div class="achievements__grid">
        {achievements.map((a) => <AchievementCard achievement={a} />)}
      </div>
      <p class="achievements__note mono" data-reveal>
        Both Gold Medals were awarded for the EcoGuard project.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 1.3fr 0.7fr;
      gap: 3.5rem;
    }
  }
  .about__aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .about__facts {
    padding: 1.25rem;
    display: grid;
    gap: 1rem;
  }
  .about__facts div {
    display: grid;
    gap: 0.2rem;
  }
  .about__facts dt {
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .about__facts dd {
    font-size: 0.95rem;
  }
  .about__facts a {
    color: var(--accent);
  }

  .skills {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .skills__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 760px) {
    .skills__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .projects__list {
    display: grid;
    gap: 2rem;
  }

  .achievements {
    border-top: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .achievements__grid {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 680px) {
    .achievements__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .achievements__note {
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--text-dim);
  }
</style>
