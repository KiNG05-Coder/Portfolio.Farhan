---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Placeholder from '../components/Placeholder.astro';
import Pipeline from '../components/Pipeline.astro';
import ArchitectureDiagram from '../components/ArchitectureDiagram.astro';
import CapabilityCard from '../components/CapabilityCard.astro';
import StatusBadge from '../components/StatusBadge.astro';
import StatStrip from '../components/StatStrip.astro';
import Callout from '../components/Callout.astro';
import { capabilities } from '../data/capabilities';
import { decisions } from '../data/decisions';
import { testStages, evidenceSlots } from '../data/testing';

const sections = [
  ['mission', 'The Mission'],
  ['capabilities', 'Capabilities'],
  ['explore', 'Explore'],
  ['architecture', 'System Architecture'],
  ['locomotion', 'Locomotion'],
  ['arm', 'Robotic Arm'],
  ['safety', 'Safety Architecture'],
  ['ai', 'AI & Perception'],
  ['navigation', 'Navigation & Exploration'],
  ['missions', 'Mission System'],
  ['decisions', 'Engineering Decisions'],
  ['testing', 'Testing & Development'],
];

const structuralStats = [
  { value: '6', label: 'Legs' },
  { value: '2', label: 'DOF per leg' },
  { value: '12', label: 'Leg joints total' },
  { value: '2', label: 'Controllers' },
];
---

<BaseLayout
  title="ARGUS-6 — Autonomous Robotics | Farhan Saif"
  description="ARGUS-6 is an autonomous six-legged robot for human rescue and environmental conservation, built by Farhan Saif. High-level autonomy runs on a Raspberry Pi; real-time motion runs on an Arduino Mega."
  path="/argus-6"
>
  {/* ---------------- HERO ---------------- */}
  <section class="a6-hero">
    <span class="grid-bg" aria-hidden="true"></span>
    <div class="container a6-hero__inner">
      <div class="a6-hero__text">
        <p class="eyebrow" data-reveal>Flagship Project</p>
        <h1 class="a6-hero__title" data-reveal>ARGUS-6</h1>
        <p class="a6-hero__sub mono" data-reveal>
          Autonomous Robotics for Human Rescue &amp; Environmental Conservation
        </p>
        <p class="a6-hero__desc" data-reveal>
          A robot capable of assisting in human rescue and environmental
          conservation.
        </p>
        <div class="a6-hero__meta" data-reveal>
          <StatusBadge status="in-development" label="In development — evolving project" />
          <span class="mono a6-hero__by">A project by Farhan Saif</span>
        </div>
      </div>

      <div class="a6-hero__visual" data-reveal>
        <Placeholder
          src="/assets/argus-6/argus-6-hero.jpg"
          alt="Placeholder for a hero photo or video still of the ARGUS-6 robot — replace with your own media."
          ratio="4 / 3"
          label="ARGUS-6 HERO IMAGE / VIDEO — REPLACE WITH YOUR MEDIA"
          hint="public/assets/argus-6/argus-6-hero.jpg (image) — swap for a <video> in this section if preferred"
          eager
        />
      </div>
    </div>
  </section>

  {/* ---------------- IN-PAGE NAV ---------------- */}
  <nav class="a6-toc" aria-label="On this page">
    <div class="container">
      <span class="a6-toc__label mono">On this page</span>
      <ul class="scroll-x">
        {sections.map(([id, label]) => <li><a href={`#${id}`} class="mono">{label}</a></li>)}
        <li><a href="/documentation" class="mono a6-toc__doc">Documentation →</a></li>
      </ul>
    </div>
  </nav>

  {/* ---------------- MISSION ---------------- */}
  <section class="section" id="mission">
    <div class="container">
      <SectionHeading
        eyebrow="The Mission"
        title="Taking on work that puts people at risk"
        lead="What ARGUS-6 is being built to help with."
      />
      <div class="two-col">
        <div class="prose" data-reveal>
          <p>
            Some of the most urgent work in the world happens in places that are
            hard on people: disaster sites, polluted rivers and coastlines,
            unstable ground, and areas that are difficult to reach on foot.
          </p>
          <p>
            ARGUS-6 is being built to take on parts of that work — moving through
            difficult environments, helping to locate people who need
            assistance, and physically collecting waste — so that fewer people
            have to be exposed to danger to get it done.
          </p>
          <p>
            It is designed as an autonomous robotic assistant that can execute
            physical tasks, not as a replacement for trained responders. Every
            claim on this page is kept to what has actually been built and
            tested; planned work is labelled as planned.
          </p>
        </div>
        <StatStrip stats={structuralStats} />
      </div>
    </div>
  </section>

  {/* ---------------- CAPABILITIES ---------------- */}
  <section class="section band" id="capabilities">
    <div class="container">
      <SectionHeading
        eyebrow="Capabilities"
        title="What works, and what doesn't yet"
        lead="Each capability carries a status. Working means it runs on the robot today; planned means it is designed but not implemented."
      />
      <div class="cap-grid">
        {capabilities.map((c) => <CapabilityCard capability={c} />)}
      </div>
      <Callout variant="caution" title="Status honesty">
        <p>
          Human detection and autonomous exploration are planned capabilities.
          They are part of the design but are not running on ARGUS-6 yet, and are
          marked accordingly above.
        </p>
      </Callout>
    </div>
  </section>

  {/* ---------------- EXPLORE ---------------- */}
  <section class="section" id="explore">
    <div class="container">
      <SectionHeading
        eyebrow="Explore"
        title="Building understanding before acting"
        lead="At a high level, exploration is a loop: move through an unknown area, take in information, decide where to go, interpret what is found, and act."
      />
      <Pipeline
        label="Exploration loop"
        variant="stack"
        steps={[
          { label: 'Explore', note: 'Move through an area that is not yet mapped or understood.' },
          { label: 'Perceive', note: 'Take in camera and sensor information about the surroundings.' },
          { label: 'Navigate', note: 'Choose where to move next while avoiding obstacles.' },
          { label: 'Analyze', note: 'Interpret what has been found — people, objects, hazards.' },
          { label: 'Respond', note: 'Act on the mission: collect an object, mark a location, continue.' },
        ]}
      />
      <Callout variant="caution">
        <p>
          Fully autonomous exploration has not been field-proven on ARGUS-6. This
          describes the intended behaviour, not a demonstrated result.
        </p>
      </Callout>
    </div>
  </section>

  {/* ---------------- ARCHITECTURE ---------------- */}
  <section class="section band" id="architecture">
    <div class="container">
      <SectionHeading
        eyebrow="System Architecture"
        title="Two brains, one robot"
        lead="The Raspberry Pi handles high-level decisions, perception and autonomy. The Arduino Mega handles real-time motion and low-level control. Select any block to read what it does."
      />
      <ArchitectureDiagram />
      <div class="prose prose--wide" data-reveal>
        <p>
          Splitting the system this way keeps motion predictable. A general
          purpose Linux computer is excellent for perception and planning but is
          not built for precise, uninterrupted timing. A microcontroller is. By
          keeping gait, inverse kinematics and servo timing on the Mega, the
          robot keeps walking smoothly even when the Pi is busy running AI or
          planning a route. The two sides exchange messages over a custom serial
          protocol.
        </p>
      </div>
    </div>
  </section>

  {/* ---------------- LOCOMOTION ---------------- */}
  <section class="section" id="locomotion">
    <div class="container">
      <SectionHeading
        eyebrow="Locomotion"
        title="Six legs, twelve joints"
        lead="ARGUS-6 walks on six legs, each with two degrees of freedom. Movement is produced by a chain that turns a target foot position into servo commands."
      />
      <div class="two-col two-col--wide-left">
        <Pipeline
          label="Locomotion pipeline"
          variant="stack"
          steps={[
            { label: 'Inverse kinematics', note: 'Turn a desired foot position into the joint angles for that leg.', status: 'working' },
            { label: 'Gait generation', note: 'Coordinate all six legs into a walking or turning pattern.', status: 'working' },
            { label: 'Motion control', note: 'Sequence the leg movements over time.', status: 'working' },
            { label: 'Servo control', note: 'Drive each joint servo to its commanded angle.', status: 'working' },
          ]}
        />
        <div class="prose" data-reveal>
          <p>
            Each of the six legs has two joints, giving twelve controlled
            joints in total. The inverse kinematics solver works out the angles
            needed to place a foot where the gait generator wants it.
          </p>
          <p>
            The gait generator combines the legs into stable patterns for
            <strong> standing</strong>, <strong>walking</strong> and
            <strong> turning</strong>, and supports variable movement rather than
            a single fixed step. All of this runs on the Arduino Mega so the
            timing does not depend on the Linux scheduler.
          </p>
          <p class="mono locomotion__status">
            Status: locomotion is implemented and working.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- ROBOTIC ARM ---------------- */}
  <section class="section band" id="arm">
    <div class="container">
      <SectionHeading
        eyebrow="Robotic Arm"
        title="Reaching into the environment"
        lead="The arm, gripper and on-board bin work together to pick up objects such as litter and cans and carry them on board."
      />
      <div class="two-col two-col--wide-left">
        <Pipeline
          label="Manipulation pipeline"
          steps={[
            { label: 'Target', note: 'Identify the object to pick up.' },
            { label: 'Approach', note: 'Move the robot and arm toward it.' },
            { label: 'Position', note: 'Line the gripper up with the object.' },
            { label: 'Grasp', note: 'Close the gripper on the object.' },
            { label: 'Verify', note: 'Check whether the object is actually held.' },
            { label: 'Transport', note: 'Carry it toward the bin.' },
            { label: 'Release', note: 'Drop it into the on-board trash bin.' },
          ]}
        />
        <div class="prose" data-reveal>
          <p>
            The working manipulation capabilities are the
            <strong> robotic arm</strong>, the <strong>gripper</strong>, the
            <strong> trash bin</strong> and <strong>trash collection</strong> —
            the combined workflow above.
          </p>
          <p>
            The <em>verify</em> step exists because grasping is not perfectly
            reliable. A pickup attempt can miss or drop an object, so the
            pipeline checks the result rather than assuming success.
          </p>
          <Callout variant="caution">
            <p>
              ARGUS-6 does not claim perfect object manipulation or guaranteed
              pickup on every attempt.
            </p>
          </Callout>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- SAFETY ---------------- */}
  <section class="section" id="safety">
    <div class="container">
      <SectionHeading
        eyebrow="Safety Architecture"
        title="Layers of authority"
        lead="Safety is treated as its own engineering concern, arranged in layers from the operator down to low-level control."
      />
      <div class="two-col two-col--wide-left">
        <Pipeline
          label="Safety layers"
          variant="stack"
          steps={[
            { label: 'Operator', note: 'A person retains ultimate authority and can stop the robot.' },
            { label: 'System safety', note: 'Command validation and watchdogs check that instructions are sane and that components are alive.' },
            { label: 'High-level supervision', note: 'The Pi supervises the mission and can command a safe stop.' },
            { label: 'Low-level control', note: 'The Mega executes motion and halts safely if it stops receiving valid commands.' },
          ]}
        />
        <div class="prose" data-reveal>
          <p>
            The important ideas are <strong>command validation</strong> (reject
            instructions that do not make sense), <strong>watchdogs</strong>
            (detect when part of the system stops responding),
            <strong> safe stopping</strong> (bring the robot to rest in a
            controlled way), <strong>authority control</strong> (be clear about
            which layer is allowed to command what) and
            <strong> emergency handling</strong>.
          </p>
          <Callout title="Editable status">
            <p>
              The safety architecture is under active development. Update this
              section and the status labels as watchdogs, safe-stop behaviour and
              emergency handling are implemented and tested.
            </p>
          </Callout>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- AI & PERCEPTION ---------------- */}
  <section class="section band" id="ai">
    <div class="container">
      <SectionHeading
        eyebrow="AI & Perception"
        title="Lightweight YOLO on a Raspberry Pi"
        lead="ARGUS-6's planned perception system is built around a lightweight YOLO object detector chosen to run on Raspberry Pi 4 hardware."
      />

      <div class="ai-status" data-reveal>
        <StatusBadge status="planned" label="Planned / In development" />
        <p class="mono">Not yet trained or deployed on the robot.</p>
      </div>

      <div class="two-col two-col--wide-left">
        <Pipeline
          label="Perception pipeline"
          variant="stack"
          steps={[
            { label: 'Camera', note: 'A camera on the robot provides a live view.' },
            { label: 'Frame capture', note: 'Individual frames are pulled from the stream.' },
            { label: 'YOLO object detection', note: 'A lightweight YOLO model scans each frame.' },
            { label: 'Bounding boxes', note: 'Detected objects are returned as boxes.' },
            { label: 'Class + confidence', note: 'Each box has a label and a confidence score.' },
            { label: 'Tracking / interpretation', note: 'Detections are followed over time and interpreted.' },
            { label: 'Mission decision', note: 'The result informs what the robot does next.' },
          ]}
        />

        <div class="prose" data-reveal>
          <p>
            The planned detector is <strong>YOLOv8n</strong>, or another
            lightweight YOLO model depending on benchmarking. Target classes are
            configurable and may include <strong>humans</strong>,
            <strong> trash</strong>, <strong>cans</strong> and other environmental
            objects.
          </p>
          <p>
            The Raspberry Pi 4 has a CPU only — no GPU or accelerator — so
            inference speed is limited. The intended deployment uses
            <strong> YOLOv8n</strong>, an <strong>NCNN</strong> build of the model
            and a <strong>reduced input resolution</strong> to keep it usable.
            CPU-only inference is expected to run at low frame rates and needs to
            be benchmarked on the actual Pi.
          </p>

          <Callout variant="caution" title="No measured FPS yet">
            <p>
              No frame-rate number is published here because none has been
              measured on ARGUS-6. Benchmarks will be added once the model runs
              on the real hardware.
            </p>
          </Callout>

          <Callout variant="caution" title="Perception is a decision aid">
            <p>
              Object detection produces guesses with confidence scores, not
              certainties. ARGUS-6 treats perception as an input to decisions,
              not as infallible truth.
            </p>
          </Callout>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- NAVIGATION ---------------- */}
  <section class="section" id="navigation">
    <div class="container">
      <SectionHeading
        eyebrow="Navigation & Exploration"
        title="From position to movement"
        lead="The navigation system turns an idea of where the robot is and where it should go into movement intent that the low-level controller can execute."
      />
      <div class="two-col two-col--wide-left">
        <Pipeline
          label="Navigation pipeline"
          variant="stack"
          steps={[
            { label: 'Localization', note: 'Estimate where the robot is, using GPS-assisted position and IMU-based information.' },
            { label: 'Navigation', note: 'Decide how to get from here to the goal while staying aware of obstacles.' },
            { label: 'Path / mission', note: 'Follow a planned path or a sequence of waypoints.' },
            { label: 'Movement intent', note: 'Express the next move as a direction and speed.' },
            { label: 'Low-level controller', note: 'The Mega turns movement intent into gait and leg motion.' },
          ]}
        />
        <div class="prose" data-reveal>
          <p>
            Planned navigation features include <strong>GPS-assisted
            navigation</strong>, <strong>IMU-based information</strong>,
            <strong> waypoint navigation</strong>, <strong>exploration</strong>,
            <strong> obstacle-aware movement</strong> and
            <strong> mission planning</strong>.
          </p>
          <Callout variant="caution">
            <p>
              ARGUS-6 does not claim centimetre-level positioning, and navigation
              capabilities that have not been tested are marked as planned.
            </p>
          </Callout>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- MISSION SYSTEM ---------------- */}
  <section class="section band" id="missions">
    <div class="container">
      <SectionHeading
        eyebrow="Mission System"
        title="How a mission runs"
        lead="ARGUS-6 is intended to support environmental cleanup, exploration, search, search & rescue, waypoint missions and mixed missions."
      />
      <div class="two-col">
        <Pipeline
          label="Mission lifecycle"
          variant="stack"
          steps={[
            { label: 'Mission created', note: 'A mission is defined with its goal and parameters.' },
            { label: 'Safety check', note: 'The system verifies it is safe to begin.' },
            { label: 'Arm', note: 'The robot is armed and ready to move.' },
            { label: 'Execute', note: 'The mission runs.' },
            { label: 'Monitor', note: 'Progress, events and health are watched throughout.' },
            { label: 'Complete / abort', note: 'The mission finishes, or is stopped early if needed.', branch: true },
            { label: 'Mission report', note: 'A record of what happened is produced.' },
          ]}
        />
        <div class="prose" data-reveal>
          <p class="mono missions__label">Mission data can include</p>
          <ul class="missions__list">
            <li>Mission ID</li>
            <li>Timestamps</li>
            <li>Location / path</li>
            <li>Events</li>
            <li>Detections</li>
            <li>Collection results</li>
            <li>Battery information</li>
            <li>Warnings / errors</li>
          </ul>
          <Callout>
            <p>
              This describes the structure of a mission record. No real mission
              logs are shown on this site.
            </p>
          </Callout>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- ENGINEERING DECISIONS ---------------- */}
  <section class="section" id="decisions">
    <div class="container">
      <SectionHeading
        eyebrow="Engineering Decisions"
        title="Why the system is built this way"
        lead="Design reasoning behind the main choices — presented as engineering trade-offs, not marketing."
      />
      <div class="decisions" data-reveal>
        {
          decisions.map((d, i) => (
            <details class="decision" open={i === 0}>
              <summary>
                <span class="decision__q">{d.question}</span>
                <span class="decision__icon" aria-hidden="true"></span>
              </summary>
              <p class="decision__a">{d.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------- TESTING ---------------- */}
  <section class="section band" id="testing">
    <div class="container">
      <SectionHeading
        eyebrow="Testing & Development"
        title="Built in order"
        lead="ARGUS-6 is developed as a progression: each stage has to work before the next one is meaningful."
      />

      <ol class="test-track" data-reveal>
        {
          testStages.map((s, i) => (
            <li class="test-stage" style={`--i:${i}`}>
              <div class="test-stage__head">
                <span class="test-stage__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="test-stage__name mono">{s.name}</span>
                <StatusBadge status={s.status} size="sm" />
              </div>
              <p class="test-stage__note">{s.note}</p>
            </li>
          ))
        }
      </ol>

      <h3 class="evidence__title mono" data-reveal>Evidence — to be added</h3>
      <p class="evidence__intro text-muted" data-reveal>
        Slots for Farhan to add test videos, benchmark measurements, photos and
        logs as they are produced.
      </p>
      <div class="evidence__grid">
        {
          evidenceSlots.map((slot) => (
            <div class="evidence__slot panel" data-reveal>
              <span class="evidence__kind mono">{slot.kind}</span>
              <h4 class="evidence__slot-title">{slot.title}</h4>
              <p class="evidence__slot-note text-muted">{slot.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------- DOCS LINK ---------------- */}
  <section class="section a6-docs-cta">
    <div class="container">
      <div class="a6-docs-cta__panel panel" data-reveal>
        <div>
          <h2 class="mono">Go deeper</h2>
          <p class="text-muted">
            The ARGUS-6 documentation covers architecture, software, firmware,
            communication, locomotion, navigation, AI, manipulation, safety and
            testing in more detail.
          </p>
        </div>
        <a class="btn btn--primary" href="/documentation">
          Open documentation <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .a6-hero {
    position: relative;
    padding-block: clamp(4.5rem, 12vw, 8rem) clamp(3rem, 7vw, 5rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .a6-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 900px) {
    .a6-hero__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
  .a6-hero__title {
    font-size: clamp(3rem, 12vw, 6.5rem);
    letter-spacing: -0.04em;
    margin-top: 0.75rem;
  }
  .a6-hero__sub {
    margin-top: 0.75rem;
    font-size: clamp(0.85rem, 2vw, 1.05rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .a6-hero__desc {
    margin-top: 1.25rem;
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--text-muted);
    max-width: 40ch;
  }
  .a6-hero__meta {
    margin-top: 1.75rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .a6-hero__by {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  /* TOC */
  .a6-toc {
    position: sticky;
    top: 4.25rem;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .a6-toc .container {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .a6-toc ul.scroll-x {
    min-width: 0;
    flex: 1;
    -webkit-overflow-scrolling: touch;
  }
  .a6-toc__label {
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    flex: none;
    padding-block: 0.75rem;
  }
  @media (max-width: 620px) {
    .a6-toc__label {
      display: none;
    }
  }
  .a6-toc ul {
    display: flex;
    gap: 0.25rem;
    padding-block: 0.5rem;
    white-space: nowrap;
  }
  .a6-toc a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-radius: 5px;
    transition: color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .a6-toc a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }
  .a6-toc__doc {
    color: var(--accent) !important;
  }

  /* Shared layout */
  .band {
    border-block: 1px solid var(--border);
    background: var(--bg-elev);
  }
  .two-col {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      align-items: start;
    }
    .two-col--wide-left {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
  .prose--wide {
    max-width: none;
    margin-top: 2rem;
  }
  .locomotion__status {
    font-size: 0.78rem;
    color: var(--status-working);
    letter-spacing: 0.04em;
  }

  .cap-grid {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 640px) {
    .cap-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .cap-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ai-status {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .ai-status p {
