  // WICE presentation beats. Most reuse a mission state (driving the full
  // panel update); a few are narration-only "beats" layered on top of the
  // current state to cover beats the mission sequence doesn't have a
  // dedicated visual for (prototype status, architecture explanation).
  const WICE_SEQUENCE: { state: StateId; narration: string; seconds: number; scrollTo?: string }[] = [
    { state: 'idle', narration: 'ARGUS-6 — a six-legged platform for environmental cleanup and rescue.', seconds: 6 },
    { state: 'idle', narration: 'The physical prototype walks, reaches and grips today on its own ESP8266 firmware.', seconds: 5 },
    { state: 'detect', narration: 'AI perception (planned): YOLO26n scans the camera feed for trash and people.', seconds: 6 },
    { state: 'detect', narration: 'A person in view raises an incident alert — independent of what ARGUS-6 is collecting.', seconds: 6 },
    { state: 'target_lock', narration: 'The Target Manager picks one candidate and locks it, so it will not switch targets mid-approach.', seconds: 6 },
    { state: 'approach', narration: 'Planned navigation drives the robot toward the locked target.', seconds: 8 },
    { state: 'align', narration: 'The robot aligns itself so the target is centred for collection.', seconds: 5 },
    { state: 'stop', narration: 'Motion stops before the arm engages.', seconds: 3 },
    { state: 'grab', narration: 'The arm reaches out and the gripper closes on the target.', seconds: 5 },
    { state: 'verify', narration: 'The mission system records the collection as verified — a simulated status, not a physical sensor.', seconds: 4 },
    { state: 'deposit', narration: 'The bin is mounted on ARGUS-6 itself, so the arm deposits the item right there and the gripper opens.', seconds: 5 },
    { state: 'return_to_base', narration: 'With the item stowed on board, ARGUS-6 returns along its route to base.', seconds: 7 },
    { state: 'complete', narration: 'Mission complete.', seconds: 4 },
    { state: 'complete', narration: 'This entire run was a simulation: perception, navigation and mission management are planned, built on top of ESP8266 locomotion that already works.', seconds: 7, scrollTo: '#autonomy' },
  ];

  const initDashboard = () => {
    document.querySelectorAll<HTMLElement>('[data-argus-dashboard]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- collapsible on-page section nav ----
      const TOC_STORAGE_KEY = 'a6d-toc-collapsed';
      const toc = document.querySelector<HTMLElement>('[data-toc]');
      const tocToggle = toc?.querySelector<HTMLButtonElement>('[data-toc-toggle]');
      const setTocCollapsed = (collapsed: boolean) => {
        if (!toc || !tocToggle) return;
        toc.dataset.collapsed = String(collapsed);
        tocToggle.setAttribute('aria-expanded', String(!collapsed));
        tocToggle.setAttribute('aria-label', collapsed ? 'Expand section navigation' : 'Collapse section navigation');
        tocToggle.title = collapsed ? 'Expand section navigation' : 'Collapse section navigation';
        try { window.localStorage.setItem(TOC_STORAGE_KEY, String(collapsed)); } catch {}
      };
      if (toc && tocToggle) {
        let storedCollapsed = false;
        try { storedCollapsed = window.localStorage.getItem(TOC_STORAGE_KEY) === 'true'; } catch {}
        setTocCollapsed(storedCollapsed);
        tocToggle.addEventListener('click', () => setTocCollapsed(toc.dataset.collapsed !== 'true'));
      }

      // ---- synthetic demo clock ----
      let clockSeconds = 18 * 3600 + 42 * 60;
      const nextTime = () => {
        clockSeconds += 2 + Math.floor(Math.random() * 4);
        const h = String(Math.floor(clockSeconds / 3600) % 24).padStart(2, '0');
        const m = String(Math.floor(clockSeconds / 60) % 60).padStart(2, '0');
        const s = String(clockSeconds % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      };

      const logList = root.querySelector<HTMLElement>('[data-event-log]');
      let logSeeded = false;
      const logEvent = (msg: string) => {
        if (!logList) return;
        if (!logSeeded) {
          logList.innerHTML = '';
          logSeeded = true;
        }
        const li = document.createElement('li');
        li.innerHTML = `<span class="a6d-log__time mono">${nextTime()}</span><span class="a6d-log__msg">${msg}</span>`;
        logList.prepend(li);
        while (logList.children.length > 60) logList.removeChild(logList.lastElementChild as Node);
      };

      // ---- element refs ----
      const camStandby = root.querySelector<HTMLElement>('[data-cam-standby]');
      const camComplete = root.querySelector<HTMLElement>('[data-cam-complete]');
      const camFps = root.querySelector<HTMLElement>('[data-cam-fps]');
      const boxes = {
        t01: root.querySelector<HTMLElement>('[data-bbox="t01"]'),
        t02: root.querySelector<HTMLElement>('[data-bbox="t02"]'),
        t03: root.querySelector<HTMLElement>('[data-bbox="t03"]'),
        t04: root.querySelector<HTMLElement>('[data-bbox="t04"]'),
        person: root.querySelector<HTMLElement>('[data-bbox="person"]'),
      };
      const t04Status = root.querySelector<HTMLElement>('[data-bbox-status]');

      const targetSummaryEl = root.querySelector<HTMLElement>('[data-target-summary]');
      const targetDetailEl = root.querySelector<HTMLElement>('[data-target-detail]');
      const targetLockStatusEl = root.querySelector<HTMLElement>('[data-target-lock-status]');
      const decisionTraceEl = root.querySelector<HTMLElement>('[data-decision-trace]');

      const mapRobot = root.querySelector<SVGGElement>('[data-map-robot]');
      const routeOut = root.querySelector<SVGPathElement>('[data-route-out]');
      const routeBack = root.querySelector<SVGPathElement>('[data-route-back]');
      const mapTargetRing = root.querySelector<SVGCircleElement>('[data-map-target-ring]');

      const twin = root.querySelector<HTMLElement>('[data-twin]');
      const twinArmEl = root.querySelector<SVGGElement>('[data-twin-arm]');
      const twinGripperEl = root.querySelector<SVGGElement>('[data-twin-gripper]');
      const twinArmValue = root.querySelector<HTMLElement>('[data-twin-arm-value]');
      const twinGripperValue = root.querySelector<HTMLElement>('[data-twin-gripper-value]');
      const twinMovementValue = root.querySelector<HTMLElement>('[data-twin-movement-value]');

      const missionLabelEl = root.querySelector<HTMLElement>('[data-mission-label]');
      const stateItems = Array.from(root.querySelectorAll<HTMLElement>('[data-state-item]'));

      const autonomyNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-autonomy-node]'));
      const authorityNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-authority-node]'));
      const authorityCols = Array.from(root.querySelectorAll<HTMLElement>('[data-authority]'));

      const completeBanner = root.querySelector<HTMLElement>('[data-complete-banner]');
      const estopBanner = root.querySelector<HTMLElement>('[data-estop-banner]');

      const lightingValue = root.querySelector<HTMLElement>('[data-lighting-value]');

      // ---- apply a single state to every panel (the one source of truth) ----
      let currentId: StateId = 'idle';
      const applyState = (id: StateId) => {
        currentId = id;
        const s = STATE_META[id];

        // camera
        if (camStandby) camStandby.hidden = !s.cameraStandby;
        if (camComplete) camComplete.hidden = !s.cameraComplete;
        if (camFps) camFps.textContent = s.fps ? String(s.fps) : '—';

        (Object.keys(boxes) as Array<keyof typeof boxes>).forEach((key) => {
          const el = boxes[key];
          if (!el) return;
          const cfg = s.boxes?.[key];
          if (!cfg) { el.hidden = true; return; }
          el.hidden = false;
          let rect: { left: number; top: number; width: number; height: number } | null = null;
          if (cfg.pos === 'fixed') rect = cfg.fixedStyle ?? null;
          else rect = T04_BOX[cfg.pos];
          if (rect) {
            el.style.left = `${rect.left}%`;
            el.style.top = `${rect.top}%`;
            el.style.width = `${rect.width}%`;
            el.style.height = `${rect.height}%`;
          }
          el.classList.toggle('is-highlighted', !!cfg.highlighted);
          if (key === 't04' && t04Status) t04Status.textContent = cfg.status ?? '';
        });

        // target manager
        if (targetSummaryEl) targetSummaryEl.textContent = s.targetSummary;
        if (targetDetailEl) targetDetailEl.hidden = !s.showTargetDetail;
        if (targetLockStatusEl && s.targetLockStatus) targetLockStatusEl.textContent = s.targetLockStatus;

        // decision trace
        if (decisionTraceEl) {
          if (s.decisionTrace === 'locked') {
            decisionTraceEl.innerHTML = `
              <div><dt>Target</dt><dd>04</dd></div>
              <div><dt>Class</dt><dd>Plastic Bottle</dd></div>
              <div><dt>Confidence</dt><dd>91%</dd></div>
              <div><dt>Image position</dt><dd>Center-right</dd></div>
              <div><dt>Estimated proximity</dt><dd>High</dd></div>
              <div><dt>Target persistence</dt><dd>Stable</dd></div>
              <div><dt>Safety check</dt><dd>PASS</dd></div>
              <div><dt>Current lock</dt><dd>YES</dd></div>
              <div class="a6d-decision-trace__decision"><dt>Decision</dt><dd>SELECT TARGET 04</dd></div>
            `;
          } else if (s.decisionTrace === 'analyzing') {
            decisionTraceEl.innerHTML = `<div class="a6d-decision-trace__idle">ANALYZING CANDIDATES…</div>`;
          } else {
            decisionTraceEl.innerHTML = `<div class="a6d-decision-trace__idle">Awaiting perception input.</div>`;
          }
        }

        // map
        if (mapRobot && s.mapRobot) {
          mapRobot.setAttribute('transform', `translate(${s.mapRobot.x},${s.mapRobot.y}) rotate(${s.mapRobot.rot})`);
        }
        if (routeOut) routeOut.classList.toggle('is-drawn', s.mapRoute === 'out' || s.mapRoute === 'both');
        if (routeBack) routeBack.classList.toggle('is-drawn', s.mapRoute === 'back' || s.mapRoute === 'both');
        if (mapTargetRing) mapTargetRing.classList.toggle('is-locked', !!s.mapTargetLocked);

        // digital twin
        if (twin) twin.classList.toggle('is-walking', !!s.twinWalking && !reduceMotion);
        if (twinArmEl && s.twinArm) twinArmEl.setAttribute('data-pose', s.twinArm);
        if (twinGripperEl && s.twinGripper) twinGripperEl.setAttribute('data-state', s.twinGripper);
        if (twinArmValue) twinArmValue.textContent = (s.twinArm ?? 'default').replace('-', ' ').toUpperCase();
        if (twinGripperValue) twinGripperValue.textContent = (s.twinGripper ?? 'open').toUpperCase();
        if (twinMovementValue) twinMovementValue.textContent = s.twinMovement ?? 'IDLE';

        // mission timeline
        if (missionLabelEl) missionLabelEl.textContent = s.missionLabel;
        stateItems.forEach((el) => el.classList.toggle('is-current', el.dataset.stateId === id));

        // autonomy stack
        autonomyNodes.forEach((el) => el.classList.toggle('is-active', el.dataset.autonomyNode === s.autonomyNode));

        // control authority
        authorityNodes.forEach((el) => el.classList.toggle('is-active', el.dataset.authorityNode === s.authorityNode));

        // lighting ties loosely to mission activity — on while the robot is doing something
        if (lightingValue) {
          const on = id !== 'idle' && id !== 'complete' && id !== 'emergency_stop';
          lightingValue.textContent = on ? 'ON' : 'OFF';
        }

        // banners
        if (completeBanner) completeBanner.hidden = id !== 'complete';
        if (estopBanner) estopBanner.hidden = id !== 'emergency_stop';
      };

      // ---- mode ----
      const modeBtns = root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
      const setMode = (mode: string) => {
        modeBtns.forEach((b) => {
          const active = b.dataset.mode === mode;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        root.classList.toggle('is-mode-autonomous', mode === 'autonomous');
        authorityCols.forEach((el) => el.classList.toggle('is-active-mode', el.dataset.authority === mode));
      };
      modeBtns.forEach((btn) => btn.addEventListener('click', () => setMode(btn.dataset.mode || 'manual')));
      setMode('manual');

      // ---- person alert ----
      const alertPanel = root.querySelector<HTMLElement>('[data-alert-panel]');
      const alertTime = alertPanel?.querySelector<HTMLElement>('[data-alert-time]');
      const alertGps = alertPanel?.querySelector<HTMLElement>('[data-alert-gps]');
      const alertSound = alertPanel?.querySelector<HTMLAudioElement>('[data-alert-sound]');
      let alertDismissedThisRun = false;
      // Simulated position near Dhaka, jittered a little each time so it
      // reads as a live fix rather than a hardcoded constant — still just
      // demo data, same as every other "Simulated" GPS value on this page.
      const BASE_LAT = 23.8103;
      const BASE_LON = 90.4125;
      const nextGpsFix = () => {
        const lat = BASE_LAT + (Math.random() - 0.5) * 0.01;
        const lon = BASE_LON + (Math.random() - 0.5) * 0.01;
        const ns = lat >= 0 ? 'N' : 'S';
        const ew = lon >= 0 ? 'E' : 'W';
        return `${Math.abs(lat).toFixed(4)}° ${ns}, ${Math.abs(lon).toFixed(4)}° ${ew}`;
      };
      const showPersonAlert = () => {
        if (!alertPanel || alertDismissedThisRun) return;
        const wasHidden = alertPanel.hidden;
        if (alertTime) alertTime.textContent = nextTime();
        if (alertGps) alertGps.textContent = nextGpsFix();
        alertPanel.hidden = false;
        requestAnimationFrame(() => alertPanel.classList.add('is-visible'));
        if (wasHidden && alertSound) {
          alertSound.loop = true;
          alertSound.currentTime = 0;
          alertSound.play().catch(() => {});
        }
      };
      const hidePersonAlert = () => {
        if (!alertPanel) return;
        alertPanel.classList.remove('is-visible');
        window.setTimeout(() => { if (alertPanel) alertPanel.hidden = true; }, 350);
        if (alertSound) {
          alertSound.pause();
          alertSound.currentTime = 0;
        }
      };
      alertPanel?.querySelector<HTMLButtonElement>('[data-alert-dismiss]')?.addEventListener('click', () => {
        alertDismissedThisRun = true;
        hidePersonAlert();
        logEvent('OPERATOR · Person alert dismissed');
      });

      // ---- demo engine (shared by manual advance, auto demo, WICE demo, replay) ----
      let demoTimer: number | undefined;
      let wiceTimer: number | undefined;
      let isRunning = false;
      let isWiceRunning = false;
      let isWicePaused = false;
      let wiceIndex = 0;
      let wiceBeatStart = 0;
      let wiceBeatRemaining = 0;
      let wiceElapsedTotal = 0;
      let wiceProgressRaf: number | undefined;

      const runBtn = root.querySelector<HTMLButtonElement>('[data-run-demo]');
      const wiceBtn = root.querySelector<HTMLButtonElement>('[data-run-wice]');
      const wiceStrip = root.querySelector<HTMLElement>('[data-wice-strip]');
      const wiceNarration = root.querySelector<HTMLElement>('[data-wice-narration]');
      const wiceProgress = root.querySelector<HTMLElement>('[data-wice-progress]');
      const winePauseBtn = root.querySelector<HTMLButtonElement>('[data-wice-pause]');

      const clearTimers = () => {
        if (demoTimer) { window.clearTimeout(demoTimer); demoTimer = undefined; }
        if (wiceTimer) { window.clearTimeout(wiceTimer); wiceTimer = undefined; }
        if (wiceProgressRaf) { window.cancelAnimationFrame(wiceProgressRaf); wiceProgressRaf = undefined; }
      };

      const setRunning = (running: boolean) => {
        isRunning = running;
        runBtn?.toggleAttribute('disabled', running);
        wiceBtn?.toggleAttribute('disabled', running);
      };

      const enableReplay = () => {
        root.querySelectorAll<HTMLButtonElement>('[data-replay-btn]').forEach((b) => (b.disabled = false));
        root.querySelector<HTMLButtonElement>('[data-replay-run]')?.removeAttribute('disabled');
      };

      const runSequence = (onDone?: () => void) => {
        clearTimers();
        setRunning(true);
        alertDismissedThisRun = false;
        hidePersonAlert();
        let i = 0;
        const step = () => {
          const id = SEQUENCE[i];
          applyState(id);
          STATE_META[id].log?.forEach((m) => logEvent(m));
          if (id === 'detect') window.setTimeout(showPersonAlert, 900);
          i++;
          if (i < SEQUENCE.length) {
            demoTimer = window.setTimeout(step, 2600);
          } else {
            setRunning(false);
            enableReplay();
            onDone?.();
          }
        };
        logEvent('SYSTEM · Autonomous demo started');
        step();
      };

      runBtn?.addEventListener('click', () => runSequence());
      root.querySelector<HTMLButtonElement>('[data-run-again]')?.addEventListener('click', () => runSequence());
      root.querySelector<HTMLButtonElement>('[data-replay-run]')?.addEventListener('click', () => runSequence());

      // ---- WICE demo mode ----
      const updateWiceProgress = () => {
        const total = WICE_SEQUENCE.reduce((sum, b) => sum + b.seconds, 0);
        const liveSinceStart = isWiceRunning && !isWicePaused ? performance.now() - wiceBeatStart : 0;
        const elapsed = Math.min(total, Math.round((wiceElapsedTotal + liveSinceStart) / 1000));
        if (wiceProgress) wiceProgress.textContent = `${elapsed} / ${total} SEC`;
        if (isWiceRunning && !isWicePaused) wiceProgressRaf = window.requestAnimationFrame(updateWiceProgress);
      };

      const playWiceBeat = (index: number) => {
        if (index >= WICE_SEQUENCE.length) {
          isWiceRunning = false;
          setRunning(false);
          enableReplay();
          if (wiceStrip) wiceStrip.hidden = true;
          return;
        }
        wiceIndex = index;
        const beat = WICE_SEQUENCE[index];
        applyState(beat.state);
        STATE_META[beat.state].log?.forEach((m) => logEvent(m));
        if (wiceNarration) wiceNarration.textContent = beat.narration;
        if (beat.state === 'detect' && index === 2) window.setTimeout(showPersonAlert, 400);
        if (beat.scrollTo) {
          const target = document.querySelector(beat.scrollTo);
          target?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'center' });
        }
        wiceBeatStart = performance.now();
        wiceBeatRemaining = beat.seconds * 1000;
        wiceTimer = window.setTimeout(() => {
          wiceElapsedTotal += wiceBeatRemaining;
          playWiceBeat(index + 1);
        }, wiceBeatRemaining);
      };

      const startWiceDemo = () => {
        clearTimers();
        setRunning(true);
        isWiceRunning = true;
        isWicePaused = false;
        wiceElapsedTotal = 0;
        alertDismissedThisRun = false;
        hidePersonAlert();
        if (wiceStrip) wiceStrip.hidden = false;
        if (winePauseBtn) winePauseBtn.textContent = 'Pause';
        logEvent('SYSTEM · WICE demo mode started');
        updateWiceProgress();
        playWiceBeat(0);
      };

      wiceBtn?.addEventListener('click', startWiceDemo);

      winePauseBtn?.addEventListener('click', () => {
        if (!isWiceRunning) return;
        if (!isWicePaused) {
          isWicePaused = true;
          if (wiceTimer) { window.clearTimeout(wiceTimer); wiceTimer = undefined; }
          const elapsedInBeat = performance.now() - wiceBeatStart;
          wiceBeatRemaining -= elapsedInBeat;
          wiceElapsedTotal += elapsedInBeat;
          winePauseBtn.textContent = 'Resume';
          updateWiceProgress();
        } else {
          isWicePaused = false;
          wiceBeatStart = performance.now();
          wiceTimer = window.setTimeout(() => {
            wiceElapsedTotal += wiceBeatRemaining;
            playWiceBeat(wiceIndex + 1);
          }, Math.max(0, wiceBeatRemaining));
          winePauseBtn.textContent = 'Pause';
          updateWiceProgress();
        }
      });
      root.querySelector<HTMLButtonElement>('[data-wice-skip]')?.addEventListener('click', () => {
        if (!isWiceRunning) return;
        if (wiceTimer) { window.clearTimeout(wiceTimer); wiceTimer = undefined; }
        wiceElapsedTotal += wiceBeatRemaining;
        playWiceBeat(wiceIndex + 1);
      });
      root.querySelector<HTMLButtonElement>('[data-wice-restart]')?.addEventListener('click', () => startWiceDemo());

      // ---- STOP / RESET ----
      const freezeMapRobot = () => {
        if (!mapRobot) return;
        const computed = getComputedStyle(mapRobot).transform;
        if (computed && computed !== 'none') {
          mapRobot.style.transition = 'none';
          mapRobot.setAttribute('transform', mapRobot.getAttribute('transform') || '');
          void mapRobot.getBoundingClientRect();
          mapRobot.style.transition = '';
        }
      };

      const stopSimulation = () => {
        const wasIdle = !isRunning && !isWiceRunning && currentId === 'idle';
        clearTimers();
        freezeMapRobot();
        setRunning(false);
        isWiceRunning = false;
        isWicePaused = false;
        if (wiceStrip) wiceStrip.hidden = true;
        if (twin) twin.classList.remove('is-walking');
        applyState('emergency_stop');
        if (!wasIdle) logEvent('SAFETY · EMERGENCY STOP (demo) — all demo motion halted');
      };
      root.querySelectorAll<HTMLButtonElement>('[data-stop-btn]').forEach((btn) => btn.addEventListener('click', stopSimulation));

      const resetDemo = () => {
        clearTimers();
        setRunning(false);
        isWiceRunning = false;
        isWicePaused = false;
        if (wiceStrip) wiceStrip.hidden = true;
        alertDismissedThisRun = false;
        hidePersonAlert();
        applyState('idle');
        if (logList) logList.innerHTML = '<li><span class="a6d-log__time mono">—</span><span class="a6d-log__msg">System idle. Press Run Autonomous Demo to begin.</span></li>';
        logSeeded = false;
      };
      root.querySelectorAll<HTMLButtonElement>('[data-reset-demo]').forEach((btn) => btn.addEventListener('click', resetDemo));

      // ---- replay (scrub through completed states) ----
      root.querySelectorAll<HTMLButtonElement>('[data-replay-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          clearTimers();
          setRunning(false);
          isWiceRunning = false;
          if (wiceStrip) wiceStrip.hidden = true;
          const id = btn.dataset.stateId as StateId;
          applyState(id);
        });
      });

      // ---- manual control preview (independent of the mission engine) ----
      const lastCommandEl = root.querySelector<HTMLElement>('[data-last-command]');
      root.querySelectorAll<HTMLButtonElement>('[data-cmd-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.dataset.cmd || '';
          if (lastCommandEl) lastCommandEl.textContent = cmd;
          logEvent(`CONTROL · Demo command: ${cmd} (control preview — not sent to robot)`);
        });
      });

      const flashlightBtn = root.querySelector<HTMLButtonElement>('[data-flashlight-btn]');
      const flashlightState = root.querySelector<HTMLElement>('[data-flashlight-state]');
      flashlightBtn?.addEventListener('click', () => {
        const isOn = flashlightState?.textContent === 'ON';
        if (flashlightState) flashlightState.textContent = isOn ? 'OFF' : 'ON';
        logEvent(`LIGHTING · Flashlight toggled ${isOn ? 'OFF' : 'ON'} (concept demo)`);
      });

      // ---- initial paint ----
      applyState('idle');
    });
  };

  initDashboard();
  document.addEventListener('astro:page-load', initDashboard);
</script>

<style>
  .a6d {
    --a6d-danger: #e5484d;
    --a6d-danger-bg: rgba(229, 72, 77, 0.12);
    --a6d-danger-line: rgba(229, 72, 77, 0.4);
  }

  /* Several elements in this component set their own `display` (grid/flex)
     for when they're shown, which otherwise silently beats the browser's
     default `[hidden]{display:none}` UA rule (author origin always wins
     over UA origin for non-important declarations, regardless of
     specificity). Force it explicitly so `hidden` always works here. */
  .a6d [hidden] { display: none !important; }

  /* ---------------- Persistent banner ---------------- */
  .a6d-banner {
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }
  .a6d-banner__inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--status-dev);
  }
  .a6d-banner__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--status-dev);
    box-shadow: 0 0 0 3px var(--status-dev-bg);
  }

  /* ---------------- Hero ---------------- */
  .a6d-hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .a6d-hero__inner { position: relative; z-index: 1; max-width: 46rem; }
  .a6d-hero__title { font-size: clamp(2rem, 5.5vw, 3.2rem); letter-spacing: -0.03em; margin-top: 0.75rem; }
  .a6d-hero__desc { margin-top: 1rem; font-size: clamp(1rem, 2.2vw, 1.1rem); color: var(--text-muted); max-width: 58ch; }
  .a6d-hero__links { margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ---------------- TOC ---------------- */
  .a6d-toc {
    position: sticky; top: 4.25rem; z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .a6d-toc .container { display: flex; align-items: center; gap: 1rem; }
  .a6d-toc__label { font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); flex: none; padding-block: 0.75rem; }
  @media (max-width: 620px) { .a6d-toc__label { display: none; } }
  .a6d-toc ul { display: flex; gap: 0.25rem; padding-block: 0.5rem; white-space: nowrap; min-width: 0; flex: 1; -webkit-overflow-scrolling: touch; }
  .a6d-toc a { display: inline-block; padding: 0.4rem 0.7rem; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); border-radius: 5px; transition: color 0.2s var(--ease), background 0.2s var(--ease); }
  .a6d-toc__toggle {
    flex: none;
    display: grid; place-items: center;
    width: 1.8rem; height: 1.8rem;
    border: 1px solid var(--border-strong); border-radius: 6px;
    color: var(--text-muted);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .a6d-toc__toggle:hover { color: var(--accent); border-color: var(--accent-line); }
  .a6d-toc__toggle-icon { display: inline-block; font-size: 0.7rem; transition: transform 0.25s var(--ease); }
  .a6d-toc[data-collapsed="true"] .a6d-toc__toggle-icon { transform: rotate(180deg); }
  .a6d-toc[data-collapsed="true"] .a6d-toc__label,
  .a6d-toc[data-collapsed="true"] ul { display: none; }
  .a6d-toc[data-collapsed="true"] .container { padding-block: 0.3rem; }
  .a6d-toc a:hover { color: var(--text); background: rgba(255, 255, 255, 0.04); }

  .a6d-section { padding-block: clamp(2.75rem, 6vw, 5rem); }
  .band { border-block: 1px solid var(--border); background: var(--bg-elev); }

  /* Local copies of page-scoped grid utilities from the main ARGUS-6 page. */
  .two-col { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .two-col { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
    .two-col--wide-left { grid-template-columns: 0.85fr 1.15fr; }
  }
  .prose--wide { max-width: none; margin-top: 2rem; }

  /* ---------------- Shared bits ---------------- */
  .a6d-demo-chip {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--status-dev); background: var(--status-dev-bg);
    border: 1px solid color-mix(in srgb, var(--status-dev) 40%, transparent);
    padding: 0.18rem 0.5rem; border-radius: 999px; white-space: nowrap;
  }
  .a6d-panel-title { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text); margin-bottom: 0.75rem; }
  .a6d-panel-subtitle { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin: 1rem 0 0.6rem; }
  .a6d-microcaveat { font-size: 0.66rem; letter-spacing: 0.04em; color: var(--text-dim); }

  .a6d-metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin: 0.75rem 0; }
  .a6d-metric-grid--wide { grid-template-columns: 1fr; }
  @media (min-width: 420px) { .a6d-metric-grid--wide { grid-template-columns: repeat(2, 1fr); } }
  .a6d-metric-grid > div { padding: 0.55rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .a6d-metric-grid dt { font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-metric-grid dd { font-size: 0.86rem; color: var(--text); margin-top: 0.15rem; }

  /* ---------------- Command center grid ---------------- */
  .a6d-command { padding-block: clamp(1.75rem, 4vw, 2.5rem); }
  .a6d-command__container { display: grid; gap: 1.25rem; }
  .a6d-grid-2 { display: grid; gap: 1.25rem; }
  @media (min-width: 940px) {
    .a6d-grid-2 { grid-template-columns: 1fr 1fr; align-items: start; }
    .a6d-grid-2--camera { grid-template-columns: 1.7fr 1fr; }
    .a6d-grid-2--log { grid-template-columns: 1.2fr 1fr; }
  }
  /* Grid/flex items default to a content-based min-width, which lets
     unbroken content (long button rows, long labels) force a track wider
     than the viewport instead of wrapping within it. Force them to
     actually respect their track/container width everywhere in this
     layout. */
  .a6d-command__container > *,
  .a6d-grid-2 > *,
  .a6d-statusbar > *,
  .a6d-decision-trace > *,
  .a6d-metric-grid > * {
    min-width: 0;
  }

  /* ---------------- Status bar ---------------- */
  .a6d-statusbar {
    padding: 0.9rem 1.2rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.4rem;
  }
  .a6d-statusbar__id { display: grid; gap: 0.1rem; }
  .a6d-statusbar__name { font-size: 1rem; letter-spacing: 0.08em; font-weight: 600; }
  .a6d-statusbar__task { font-size: 0.62rem; letter-spacing: 0.1em; color: var(--text-dim); text-transform: uppercase; }
  .a6d-statusbar__flag { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--status-dev); }
  .a6d-statusbar__flag-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--status-dev); box-shadow: 0 0 0 3px var(--status-dev-bg); }

  .a6d-mode-select { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.2rem; gap: 0.2rem; }
  .a6d-mode-btn { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.4rem 0.85rem; border-radius: 999px; color: var(--text-muted); transition: background 0.2s var(--ease), color 0.2s var(--ease); }
  .a6d-mode-btn.is-active { background: var(--accent-soft); color: var(--accent); }

  .a6d-demo-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-left: auto; }
  .a6d-run-btn, .a6d-wice-btn { font-size: 0.7rem; padding: 0.6rem 1rem; }
  .a6d-run-btn:disabled, .a6d-wice-btn:disabled { opacity: 0.45; pointer-events: none; }

  .a6d-stop-btn {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
    padding: 0.6rem 1.1rem;
    color: var(--a6d-danger); background: var(--a6d-danger-bg);
    border: 1px solid var(--a6d-danger-line); border-radius: var(--radius-sm);
    transition: background 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .a6d-stop-btn:hover { background: color-mix(in srgb, var(--a6d-danger) 20%, transparent); }
  .a6d-stop-btn:active { transform: scale(0.97); }

  /* ---------------- WICE strip ---------------- */
  .a6d-wice-strip {
    padding: 0.85rem 1.1rem;
    display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 0.9rem;
    border-left: 2px solid var(--accent);
  }
  @media (max-width: 780px) { .a6d-wice-strip { grid-template-columns: 1fr; } }
  .a6d-wice-strip__label { font-size: 0.62rem; letter-spacing: 0.14em; color: var(--accent); }
  .a6d-wice-strip__narration { font-size: 0.86rem; color: var(--text-muted); margin: 0; }
  .a6d-wice-strip__progress { font-size: 0.68rem; color: var(--text-dim); }
  .a6d-wice-strip__controls { display: flex; gap: 0.4rem; }
  .a6d-wice-ctrl { font-size: 0.62rem; letter-spacing: 0.06em; padding: 0.35rem 0.65rem; border: 1px solid var(--border-strong); border-radius: 6px; color: var(--text-muted); }
  .a6d-wice-ctrl:hover { color: var(--accent); border-color: var(--accent-line); }

  /* ---------------- Camera ---------------- */
  .a6d-camera { padding: 1rem; }
  .a6d-camera__viewport {
    position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-sm); overflow: hidden;
    background: radial-gradient(ellipse at 30% 20%, rgba(91,157,255,0.08), transparent 55%), linear-gradient(180deg, #0c1016 0%, #0a0d12 55%, #05070a 100%);
    border: 1px solid var(--border-strong);
  }
  .a6d-camera__horizon { position: absolute; left: 0; right: 0; bottom: 0; height: 42%; background: linear-gradient(180deg, transparent, rgba(63,185,80,0.05) 40%, rgba(20,26,20,0.35)); border-top: 1px solid rgba(255,255,255,0.05); }
  .a6d-camera__scanlines { position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 3px); mix-blend-mode: overlay; pointer-events: none; }
  .a6d-camera__vignette { position: absolute; inset: 0; box-shadow: inset 0 0 6rem rgba(0,0,0,0.6); pointer-events: none; }

  .a6d-camera__corner { position: absolute; width: 16px; height: 16px; border: 1.5px solid rgba(91,157,255,0.55); }
  .a6d-camera__corner--tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .a6d-camera__corner--tr { top: 10px; right: 10px; border-left: 0; border-bottom: 0; }
  .a6d-camera__corner--bl { bottom: 10px; left: 10px; border-right: 0; border-top: 0; }
  .a6d-camera__corner--br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  .a6d-camera__tag { position: absolute; top: 12px; left: 34px; display: flex; align-items: center; gap: 0.4rem; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--status-dev); background: rgba(8,9,11,0.55); padding: 0.2rem 0.5rem; border-radius: 4px; }

  .a6d-camera__standby, .a6d-camera__complete {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 0.78rem; letter-spacing: 0.08em; color: var(--text-dim); text-align: center; padding: 1rem;
  }
  .a6d-camera__complete { color: var(--status-working); font-size: 1rem; letter-spacing: 0.14em; }

  .a6d-camera__readout { position: absolute; right: 10px; bottom: 10px; display: flex; align-items: center; gap: 0.6rem; font-size: 0.64rem; color: var(--text-muted); background: rgba(8,9,11,0.55); padding: 0.3rem 0.6rem; border-radius: 6px; }
  .a6d-camera__readout b { color: var(--text); }

  .a6d-bbox {
    position: absolute; border: 1.5px solid #3fb950; border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4);
    transition: left 0.9s var(--ease), top 0.9s var(--ease), width 0.9s var(--ease), height 0.9s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .a6d-bbox--person { border-color: #d9a441; }
  .a6d-bbox.is-highlighted { box-shadow: 0 0 0 3px rgba(255,255,255,0.2), 0 0 16px rgba(63,185,80,0.4); }
  .a6d-bbox__label { position: absolute; top: -1.4rem; left: -1.5px; font-size: 0.56rem; letter-spacing: 0.03em; white-space: nowrap; color: #0a0f0a; background: #3fb950; padding: 0.12rem 0.4rem; border-radius: 3px 3px 3px 0; }
  .a6d-bbox--person .a6d-bbox__label { color: #1a1305; background: #d9a441; }
  .a6d-bbox__label b { font-weight: 700; }
  .a6d-bbox__status { position: absolute; bottom: -1.3rem; left: -1.5px; font-size: 0.54rem; letter-spacing: 0.06em; color: var(--accent); background: rgba(8,9,11,0.7); padding: 0.1rem 0.35rem; border-radius: 3px; white-space: nowrap; }

  /* ---------------- Map ---------------- */
  .a6d-map { position: relative; padding: 1rem; }
  .a6d-map__tag { position: absolute; top: 1rem; left: 1rem; z-index: 1; }
  .a6d-map__svg { width: 100%; height: auto; display: block; }
  .a6d-map__label { font: 500 8px var(--font-mono); letter-spacing: 0.02em; }
  .a6d-map-legend { display: grid; gap: 0.5rem; margin-top: 0.75rem; font-size: 0.76rem; color: var(--text-muted); }
  .a6d-map-legend li { display: flex; align-items: center; gap: 0.6rem; }
  .a6d-legend-swatch { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .a6d-legend-swatch--ring { background: transparent; border: 2px solid; }
  .a6d-legend-swatch--square { background: transparent; border: 1.5px solid var(--accent); border-radius: 3px; }
  .a6d-legend-swatch--dash { width: 16px; height: 0; border-top: 1.5px dashed var(--border-strong); border-radius: 0; }

  .a6d-map__svg [data-map-robot] { transition: transform 2.4s var(--ease); }
  .a6d-map__svg path[data-route-out], .a6d-map__svg path[data-route-back] { transition: stroke-dashoffset 2s var(--ease); }
  .a6d-map__svg path[data-route-out].is-drawn, .a6d-map__svg path[data-route-back].is-drawn { stroke-dashoffset: 0; }
  .a6d-map__svg [data-map-target-ring] { transition: opacity 0.3s var(--ease); }
  .a6d-map__svg [data-map-target-ring].is-locked { animation: a6d-ring-pulse 1.8s ease-in-out infinite; }
  @keyframes a6d-ring-pulse { 0%, 100% { r: 10; opacity: 0.5; } 50% { r: 14; opacity: 0.12; } }

  /* ---------------- Target / decision panel ---------------- */
  .a6d-target-panel, .a6d-twin-panel { padding: 1.2rem; }
  .a6d-target-panel__head, .a6d-twin-panel__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .a6d-target-status { font-size: 0.95rem; color: var(--accent); letter-spacing: 0.04em; }

  .a6d-decision-trace { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; font-size: 0.78rem; }
  .a6d-decision-trace > div { padding: 0.5rem 0.65rem; border: 1px solid var(--border); border-radius: 6px; }
  .a6d-decision-trace dt { font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-decision-trace dd { color: var(--text); margin-top: 0.15rem; }
  .a6d-decision-trace__decision { grid-column: 1 / -1; border-color: var(--accent-line) !important; background: var(--accent-soft); }
  .a6d-decision-trace__decision dd { color: var(--accent); font-weight: 600; }
  .a6d-decision-trace__idle { grid-column: 1 / -1; padding: 0.6rem 0.75rem; color: var(--text-dim); border: 1px dashed var(--border-strong); border-radius: 6px; }

  /* ---------------- Digital twin ---------------- */
  .a6d-twin { padding: 0.5rem; }
  .a6d-twin__svg { width: 100%; height: auto; display: block; }
  .a6d-twin__body { fill: var(--surface-raised); stroke: var(--accent-line); stroke-width: 1.5; }
  .a6d-twin__leg { transform-box: view-box; }
  .a6d-twin__leg--l1 { transform-origin: 88px 76px; }
  .a6d-twin__leg--l2 { transform-origin: 88px 85px; }
  .a6d-twin__leg--l3 { transform-origin: 88px 94px; }
  .a6d-twin__leg--r1 { transform-origin: 132px 76px; }
  .a6d-twin__leg--r2 { transform-origin: 132px 85px; }
  .a6d-twin__leg--r3 { transform-origin: 132px 94px; }
  .a6d-twin__thigh, .a6d-twin__shin { fill: none; stroke: var(--text-muted); stroke-width: 2.5; stroke-linecap: round; }
  .a6d-twin__foot { fill: var(--accent); }
  .a6d-twin__heading { fill: var(--accent); opacity: 0.85; }

  .a6d-twin.is-walking .a6d-twin__leg { animation: a6d-twin-step 0.9s ease-in-out infinite; }
  .a6d-twin.is-walking .a6d-twin__leg--r1,
  .a6d-twin.is-walking .a6d-twin__leg--l2,
  .a6d-twin.is-walking .a6d-twin__leg--r3 { animation-delay: 0.45s; }
  @keyframes a6d-twin-step { 0%, 100% { transform: rotate(-7deg); opacity: 1; } 50% { transform: rotate(7deg); opacity: 0.8; } }

  .a6d-twin__arm { transform-box: view-box; transform-origin: 118px 78px; transition: transform 0.9s var(--ease); }
  .a6d-twin__arm[data-pose="reach-target"] { transform: rotate(-38deg); }
  .a6d-twin__arm[data-pose="reach-bin"] { transform: rotate(48deg); }
  .a6d-twin__arm-upper, .a6d-twin__arm-lower { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; }
  .a6d-twin__gripper-finger { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; transform-box: fill-box; transform-origin: 0 0; transition: transform 0.4s var(--ease); }
  .a6d-twin__gripper[data-state="closed"] .a6d-twin__gripper-finger--a { transform: rotate(12deg); }
  .a6d-twin__gripper[data-state="closed"] .a6d-twin__gripper-finger--b { transform: rotate(-12deg); }

  /* ---------------- Mission timeline ---------------- */
  .a6d-timeline-panel { padding: 1.1rem 1.2rem; }
  .a6d-timeline-panel__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.9rem; }
  .a6d-mission-label { font-size: 0.72rem; color: var(--accent); letter-spacing: 0.02em; }
  .a6d-state-machine { display: flex; gap: 0.5rem; padding-bottom: 0.2rem; }
  .a6d-state {
    display: flex; align-items: center; gap: 0.4rem; flex: none;
    padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 999px;
    font-size: 0.7rem; color: var(--text-dim);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .a6d-state__num { color: var(--text-dim); font-size: 0.6rem; }
  .a6d-state.is-current { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .a6d-state.is-current .a6d-state__num { color: var(--accent); }

  /* ---------------- Event log ---------------- */
  .a6d-log { padding: 1.1rem; }
  .a6d-log__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }
  .a6d-log__head .a6d-panel-title { margin-bottom: 0; }
  .a6d-log__list { display: grid; gap: 0.1rem; max-height: 300px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
  .a6d-log__list li { display: flex; gap: 0.75rem; padding: 0.4rem 0.3rem; font-size: 0.78rem; border-bottom: 1px solid var(--border); }
  .a6d-log__list li:last-child { border-bottom: 0; }
  .a6d-log__time { color: var(--text-dim); flex: none; }
  .a6d-log__msg { color: var(--text-muted); }

  /* ---------------- Quick control ---------------- */
  .a6d-quickcontrol { padding: 1.1rem; }
  .a6d-quickcontrol__flag { display: inline-flex; margin-bottom: 1rem; }
  .a6d-dpad { display: grid; grid-template-columns: repeat(3, 2.9rem); grid-template-rows: repeat(3, 2.9rem); gap: 0.35rem; justify-content: center; margin-bottom: 0.9rem; }
  .a6d-dpad__btn { border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface-raised); color: var(--text); font-size: 1rem; transition: border-color 0.2s var(--ease), transform 0.15s var(--ease); }
  .a6d-dpad__btn:hover { border-color: var(--accent-line); }
  .a6d-dpad__btn:active { transform: scale(0.94); }
  .a6d-dpad__btn--up { grid-column: 2; grid-row: 1; }
  .a6d-dpad__btn--left { grid-column: 1; grid-row: 2; }
  .a6d-dpad__btn--stop { grid-column: 2; grid-row: 2; font-family: var(--font-mono); font-size: 0.58rem; color: var(--a6d-danger); border-color: var(--a6d-danger-line); background: var(--a6d-danger-bg); }
  .a6d-dpad__btn--right { grid-column: 3; grid-row: 2; }
  .a6d-dpad__btn--down { grid-column: 2; grid-row: 3; }
  .a6d-turn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .a6d-turn-row .btn { padding: 0.55rem 0.9rem; font-size: 0.64rem; }
  .a6d-toggle-btn { font-size: 0.62rem; letter-spacing: 0.06em; padding: 0.55rem 0.8rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); color: var(--text-muted); }
  .a6d-toggle-btn:hover { color: var(--accent); border-color: var(--accent-line); }
  .a6d-last-command { font-size: 0.76rem; color: var(--text-muted); padding-top: 0.75rem; border-top: 1px solid var(--border); }
  .a6d-last-command span { color: var(--accent); }

  /* ---------------- Completion / E-STOP banners ---------------- */
  .a6d-complete-banner, .a6d-estop-banner {
    padding: 1.1rem 1.3rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .a6d-complete-banner { border-left: 2px solid var(--status-working); }
  .a6d-estop-banner { border-left: 2px solid var(--a6d-danger); }
  .a6d-complete-banner__tag { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--status-working); font-weight: 700; }
  .a6d-estop-banner__tag { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--a6d-danger); font-weight: 700; }
  .a6d-complete-banner p, .a6d-estop-banner p { margin-top: 0.3rem; font-size: 0.85rem; color: var(--text-muted); }
  .a6d-complete-banner__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  /* ---------------- Person alert (fixed, slides from left) ---------------- */
  .a6d-alert {
    position: fixed; left: 24px; top: 120px; z-index: 400;
    width: min(320px, calc(100vw - 48px));
    padding: 1.1rem 1.25rem;
    background: var(--surface); background-image: var(--surface-grad);
    border: 1px solid var(--border); border-left: 2px solid var(--a6d-danger);
    border-radius: var(--radius); box-shadow: var(--shadow-lg);
    transform: translateX(-130%); opacity: 0;
    transition: transform 0.5s var(--ease), opacity 0.4s var(--ease);
  }
  .a6d-alert.is-visible { transform: translateX(0); opacity: 1; }
  .a6d-alert__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .a6d-alert__tag { font-size: 0.74rem; letter-spacing: 0.06em; color: var(--a6d-danger); font-weight: 700; }
  .a6d-alert__close { width: 1.75rem; height: 1.75rem; display: grid; place-items: center; border: 1px solid var(--border-strong); border-radius: 6px; color: var(--text-muted); flex: none; }
  .a6d-alert__close:hover { color: var(--text); border-color: var(--accent-line); }
  .a6d-alert__body { margin-top: 0.55rem; font-size: 0.88rem; color: var(--text-muted); }
  .a6d-alert__meta { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem 0.75rem; margin: 0.85rem 0; }
  .a6d-alert__meta dt { display: flex; align-items: center; gap: 0.35rem; font-size: 0.54rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-alert__meta dd { font-size: 0.76rem; color: var(--text); margin-top: 0.15rem; }
  .a6d-alert__sim { font-size: 0.5rem; letter-spacing: 0.06em; color: var(--status-dev); background: var(--status-dev-bg); border: 1px solid color-mix(in srgb, var(--status-dev) 40%, transparent); padding: 0.05rem 0.3rem; border-radius: 999px; }
  @media (max-width: 560px) { .a6d-alert { top: auto; bottom: 16px; left: 16px; right: 16px; width: auto; } }

  /* ---------------- Control authority ---------------- */
  .a6d-authority-col { padding: 1.1rem; opacity: 0.55; transition: opacity 0.3s var(--ease); }
  .a6d-authority-col.is-active-mode { opacity: 1; }
  .a6d-authority-col__label { font-size: 0.72rem; letter-spacing: 0.1em; color: var(--text-muted); display: block; margin-bottom: 0.75rem; }
  .a6d-authority-chain { display: grid; gap: 0.35rem; }
  .a6d-authority-chain li {
    padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 6px;
    font-size: 0.78rem; color: var(--text-dim); text-align: center;
