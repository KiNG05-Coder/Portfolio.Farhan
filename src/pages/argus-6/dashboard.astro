      targetSummary: 'TARGET 04 · DEPOSITED',
      targetLockStatus: 'DEPOSITED',
      showTargetDetail: true,
      decisionTrace: 'locked',
      mapRobot: { x: 60, y: 210, rot: -145 },
      mapRoute: 'both',
      mapTargetLocked: false,
      twinArm: 'reach-bin',
      twinGripper: 'open',
      twinMovement: 'ARM ACTIVE',
      autonomyNode: 'mission_manager',
      authorityNode: 'mission_manager',
    },
    complete: {
      label: 'COMPLETE',
      missionLabel: 'Mission complete',
      log: ['MISSION · Mission complete'],
      cameraComplete: true,
      targetSummary: 'MISSION COMPLETE',
      targetLockStatus: 'COMPLETE',
      showTargetDetail: true,
      decisionTrace: 'locked',
      mapRobot: { x: 60, y: 210, rot: -145 },
      mapRoute: 'both',
      mapTargetLocked: false,
      twinArm: 'default',
      twinGripper: 'open',
      twinMovement: 'IDLE',
      autonomyNode: null,
      authorityNode: null,
    },
    emergency_stop: {
      label: 'EMERGENCY STOP',
      missionLabel: 'EMERGENCY STOP — demo halted',
      log: ['SAFETY · EMERGENCY STOP (demo) — all demo motion halted'],
      targetSummary: 'HALTED',
      showTargetDetail: false,
      decisionTrace: 'idle',
      twinWalking: false,
      twinMovement: 'STOPPED',
      autonomyNode: null,
      authorityNode: null,
    },
  };

  // Guided WICE Presentation Mode — a dashboard playback/presentation mode,
  // NOT a third robot operating mode. The robot stays MANUAL / AUTONOMOUS;
  // this is a presenter-controlled walk through the same centralized
  // mission state (STATE_META / applyState) used everywhere else on this
  // page. Each stage maps to one mission state plus the narrative copy the
  // presenter needs — no separate simulation is created per panel.
  interface PresentationStage {
    id: string;
    state: StateId;
    title: string;
    currentStateText: string;
    keyConcept: string;
    presenterNote: string;
    emphasis: string[] | null;
    // Most stages log exactly what their mission state already logs (see
    // STATE_META[state].log) — that's the single source of truth for event
    // text, shared with the fast Run Autonomous Demo. Only presentation-only
    // beats that don't correspond 1:1 with a mission-state transition (the
    // intro, and the person incident sharing DETECT with Perception) need an
    // explicit override here.
    logLines?: string[];
  }

  const PRESENTATION_STAGES: PresentationStage[] = [
    {
      id: 'overview', state: 'idle', title: 'OVERVIEW',
      currentStateText: 'ARGUS-6 — a six-legged platform for environmental cleanup on difficult terrain.',
      keyConcept: 'A six-legged platform built for environmental cleanup on difficult terrain.',
      presenterNote: 'Introduce ARGUS-6, the six-legged robotic platform designed for environmental cleanup and operation on difficult terrain.',
      emphasis: null,
      logLines: ['SYSTEM · Guided WICE presentation started'],
    },
    {
      id: 'perception', state: 'detect', title: 'PERCEPTION',
      currentStateText: 'YOLO26n analyzes the camera stream and identifies candidate objects and people.',
      keyConcept: 'Detection is the input. It is not yet a decision.',
      presenterNote: 'The camera provides the visual input. YOLO26n identifies objects in the scene, but detection alone does not decide what the robot should collect.',
      emphasis: ['perception', 'targeting', 'architecture'],
    },
    {
      id: 'person-alert', state: 'detect', title: 'PERSON INCIDENT',
      currentStateText: 'A person detection is handled as an independent safety incident rather than becoming a trash target.',
      keyConcept: 'Incident alerts run independently of the collection pipeline.',
      presenterNote: 'The perception system also identifies people independently from the waste-target pipeline. This is treated as an incident alert rather than a collection target.',
      emphasis: ['perception', 'targeting', 'architecture'],
      logLines: ['AI · Person incident detected: P07'],
    },
    {
      id: 'target-selection', state: 'target_lock', title: 'TARGET SELECTION',
      currentStateText: 'The Target Manager combines confidence, apparent proximity, image position, and persistence before locking a target.',
      keyConcept: 'Detection ≠ Decision.',
      presenterNote: 'ARGUS-6 does not simply drive toward the first object YOLO detects. The Target Manager evaluates candidates and selects one target, then locks it so the robot doesn’t constantly switch between objects.',
      emphasis: ['targeting'],
    },
    {
      id: 'approach', state: 'approach', title: 'APPROACH',
      currentStateText: 'Navigation moves ARGUS-6 toward the selected target.',
      keyConcept: 'A locked target lets navigation commit to one approach path.',
      presenterNote: 'Once the target is locked, the navigation system generates movement intent to approach it.',
      emphasis: ['navigation'],
    },
    {
      id: 'align', state: 'align', title: 'ALIGN',
      currentStateText: 'The robot corrects its heading and positioning before stopping.',
      keyConcept: 'Alignment happens before the arm ever engages.',
      presenterNote: 'Before using the arm, the robot needs to position itself correctly relative to the object.',
      emphasis: ['navigation'],
    },
    {
      id: 'stop', state: 'stop', title: 'STOP',
      currentStateText: 'The robot stops before manipulation begins.',
      keyConcept: 'Locomotion and manipulation never compete for control.',
      presenterNote: 'The robot stops before manipulation so locomotion and arm movement are not competing for control.',
      emphasis: ['navigation', 'collection'],
    },
    {
      id: 'grab', state: 'grab', title: 'GRAB',
      currentStateText: 'The arm moves from DEFAULT and the gripper closes around the selected object.',
      keyConcept: 'Control now hands off from locomotion to manipulation.',
      presenterNote: 'The mission manager now transitions from locomotion to manipulation. The robotic arm positions the gripper and performs the pickup.',
      emphasis: ['collection'],
    },
    {
      id: 'verify', state: 'verify', title: 'VERIFY',
      currentStateText: 'The mission verifies the logical success condition before continuing.',
      keyConcept: 'Simulated verification, not a claim about a physical sensor.',
      presenterNote: 'The mission includes a verification stage before continuing. In the current concept simulation, this represents the logical verification step rather than a claim about a dedicated physical sensor.',
      emphasis: ['collection'],
    },
    {
      id: 'arm-default', state: 'arm_default', title: 'ARM DEFAULT',
      currentStateText: 'The arm returns to a safe default pose before locomotion resumes.',
      keyConcept: 'A safe travel configuration before locomotion resumes.',
      presenterNote: 'The arm returns to its default travel configuration before the robot resumes locomotion.',
      emphasis: ['collection'],
    },
    {
      id: 'return-to-bin', state: 'return_to_bin', title: 'RETURN TO BIN',
      currentStateText: 'ARGUS-6 returns toward its onboard collection bin.',
      keyConcept: 'The collection cycle continues until the object is deposited.',
      presenterNote: 'After collection, the robot returns to the configured collection location.',
      emphasis: ['navigation'],
    },
    {
      id: 'align-bin', state: 'align_bin', title: 'ALIGN BIN',
      currentStateText: 'The robot positions itself for controlled deposit.',
      keyConcept: 'The same align-before-manipulate principle as the initial pickup.',
      presenterNote: 'The robot positions itself before performing the deposit.',
      emphasis: ['navigation'],
    },
    {
      id: 'deposit', state: 'deposit', title: 'DEPOSIT',
      currentStateText: 'The gripper releases the collected object into the onboard bin.',
      keyConcept: 'Completes the collection cycle.',
      presenterNote: 'The arm deposits the collected waste, completing the collection cycle.',
      emphasis: ['collection'],
    },
    {
      id: 'complete', state: 'complete', title: 'COMPLETE',
      currentStateText: 'The simulated cleanup mission is complete.',
      keyConcept: 'Perception → decision → navigation → manipulation → return, one system.',
      presenterNote: 'This demonstrates the complete planned autonomous collection loop, from perception through target selection, navigation, manipulation and return.',
      emphasis: null,
    },
  ];

  // A stage's log is its own override when given, otherwise the log already
  // defined on its mission state — one source of truth for event text,
  // shared with the fast Run Autonomous Demo instead of duplicating it.
  const presentationStageLog = (stage: PresentationStage): string[] =>
    stage.logLines ?? STATE_META[stage.state].log ?? [];

  const PERSON_ALERT_STAGE_INDEX = PRESENTATION_STAGES.findIndex((s) => s.id === 'person-alert');

  const initDashboard = () => {
    document.querySelectorAll<HTMLElement>('[data-argus-dashboard]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---- collapsible on-page section nav ----
      const TOC_STORAGE_KEY = 'a6d-toc-collapsed';
      const toc = document.querySelector<HTMLElement>('[data-toc]');
      const tocToggle = toc?.querySelector<HTMLButtonElement>('[data-toc-toggle]');
      const setTocCollapsed = (collapsed: boolean) => {
        if (!toc || !tocToggle) return;
        toc.dataset.collapsed = String(collapsed);
        tocToggle.setAttribute('aria-expanded', String(!collapsed));
        tocToggle.setAttribute('aria-label', collapsed ? 'Expand section navigation' : 'Collapse section navigation');
        tocToggle.title = collapsed ? 'Expand section navigation' : 'Collapse section navigation';
        try { window.localStorage.setItem(TOC_STORAGE_KEY, String(collapsed)); } catch {}
      };
      if (toc && tocToggle) {
        let storedCollapsed = false;
        try { storedCollapsed = window.localStorage.getItem(TOC_STORAGE_KEY) === 'true'; } catch {}
        setTocCollapsed(storedCollapsed);
        tocToggle.addEventListener('click', () => setTocCollapsed(toc.dataset.collapsed !== 'true'));
      }

      // ---- synthetic demo clock ----
      let clockSeconds = 18 * 3600 + 42 * 60;
      const nextTime = () => {
        clockSeconds += 2 + Math.floor(Math.random() * 4);
        const h = String(Math.floor(clockSeconds / 3600) % 24).padStart(2, '0');
        const m = String(Math.floor(clockSeconds / 60) % 60).padStart(2, '0');
        const s = String(clockSeconds % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      };

      const logList = root.querySelector<HTMLElement>('[data-event-log]');
      let logSeeded = false;
      const logEvent = (msg: string) => {
        if (!logList) return;
        if (!logSeeded) {
          logList.innerHTML = '';
          logSeeded = true;
        }
        const li = document.createElement('li');
        li.innerHTML = `<span class="a6d-log__time mono">${nextTime()}</span><span class="a6d-log__msg">${msg}</span>`;
        logList.prepend(li);
        while (logList.children.length > 60) logList.removeChild(logList.lastElementChild as Node);
      };

      // ---- element refs ----
      const camStandby = root.querySelector<HTMLElement>('[data-cam-standby]');
      const camComplete = root.querySelector<HTMLElement>('[data-cam-complete]');
      const camFps = root.querySelector<HTMLElement>('[data-cam-fps]');
      const boxes = {
        t01: root.querySelector<HTMLElement>('[data-bbox="t01"]'),
        t02: root.querySelector<HTMLElement>('[data-bbox="t02"]'),
        t03: root.querySelector<HTMLElement>('[data-bbox="t03"]'),
        t04: root.querySelector<HTMLElement>('[data-bbox="t04"]'),
        person: root.querySelector<HTMLElement>('[data-bbox="person"]'),
      };
      const t04Status = root.querySelector<HTMLElement>('[data-bbox-status]');

      const targetSummaryEl = root.querySelector<HTMLElement>('[data-target-summary]');
      const targetDetailEl = root.querySelector<HTMLElement>('[data-target-detail]');
      const targetLockStatusEl = root.querySelector<HTMLElement>('[data-target-lock-status]');
      const decisionTraceEl = root.querySelector<HTMLElement>('[data-decision-trace]');

      const mapRobot = root.querySelector<SVGGElement>('[data-map-robot]');
      const routeOut = root.querySelector<SVGPathElement>('[data-route-out]');
      const routeBack = root.querySelector<SVGPathElement>('[data-route-back]');
      const mapTargetRing = root.querySelector<SVGCircleElement>('[data-map-target-ring]');

      const twin = root.querySelector<HTMLElement>('[data-twin]');
      const twinArmEl = root.querySelector<SVGGElement>('[data-twin-arm]');
      const twinGripperEl = root.querySelector<SVGGElement>('[data-twin-gripper]');
      const twinArmValue = root.querySelector<HTMLElement>('[data-twin-arm-value]');
      const twinGripperValue = root.querySelector<HTMLElement>('[data-twin-gripper-value]');
      const twinMovementValue = root.querySelector<HTMLElement>('[data-twin-movement-value]');

      const missionLabelEl = root.querySelector<HTMLElement>('[data-mission-label]');
      const stateItems = Array.from(root.querySelectorAll<HTMLElement>('[data-state-item]'));

      const autonomyNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-autonomy-node]'));
      const authorityNodes = Array.from(root.querySelectorAll<HTMLElement>('[data-authority-node]'));
      const authorityCols = Array.from(root.querySelectorAll<HTMLElement>('[data-authority]'));

      const completeBanner = root.querySelector<HTMLElement>('[data-complete-banner]');
      const estopBanner = root.querySelector<HTMLElement>('[data-estop-banner]');

      const lightingValue = root.querySelector<HTMLElement>('[data-lighting-value]');

      // ---- apply a single state to every panel (the one source of truth) ----
      let currentId: StateId = 'idle';
      const applyState = (id: StateId) => {
        currentId = id;
        const s = STATE_META[id];

        // camera
        if (camStandby) camStandby.hidden = !s.cameraStandby;
        if (camComplete) camComplete.hidden = !s.cameraComplete;
        if (camFps) camFps.textContent = s.fps ? String(s.fps) : '—';

        (Object.keys(boxes) as Array<keyof typeof boxes>).forEach((key) => {
          const el = boxes[key];
          if (!el) return;
          const cfg = s.boxes?.[key];
          if (!cfg) { el.hidden = true; return; }
          el.hidden = false;
          let rect: { left: number; top: number; width: number; height: number } | null = null;
          if (cfg.pos === 'fixed') rect = cfg.fixedStyle ?? null;
          else rect = T04_BOX[cfg.pos];
          if (rect) {
            el.style.left = `${rect.left}%`;
            el.style.top = `${rect.top}%`;
            el.style.width = `${rect.width}%`;
            el.style.height = `${rect.height}%`;
          }
          el.classList.toggle('is-highlighted', !!cfg.highlighted);
          if (key === 't04' && t04Status) t04Status.textContent = cfg.status ?? '';
        });

        // target manager
        if (targetSummaryEl) targetSummaryEl.textContent = s.targetSummary;
        if (targetDetailEl) targetDetailEl.hidden = !s.showTargetDetail;
        if (targetLockStatusEl && s.targetLockStatus) targetLockStatusEl.textContent = s.targetLockStatus;

        // decision trace
        if (decisionTraceEl) {
          if (s.decisionTrace === 'locked') {
            decisionTraceEl.innerHTML = `
              <div class="a6d-decision-trace__selected"><dt>Selected Target</dt><dd>PLASTIC_BOTTLE · ID 04</dd></div>
              <div><dt>Confidence</dt><dd>91%</dd></div>
              <div><dt>Image position</dt><dd>Center-right</dd></div>
              <div><dt>Estimated proximity</dt><dd>High</dd></div>
              <div><dt>Target persistence</dt><dd>Stable</dd></div>
              <div><dt>Safety check</dt><dd>PASS (simulated)</dd></div>
              <div class="a6d-decision-trace__why"><dt>Why?</dt><dd>High confidence + favorable image position + persistent detection + safe target classification.</dd></div>
            `;
          } else if (s.decisionTrace === 'analyzing') {
            decisionTraceEl.innerHTML = `<div class="a6d-decision-trace__idle">ANALYZING CANDIDATES…</div>`;
          } else if (s.decisionTrace === 'waiting') {
            decisionTraceEl.innerHTML = `<div class="a6d-decision-trace__idle">WAITING FOR TARGET SELECTION</div>`;
          } else {
            decisionTraceEl.innerHTML = `<div class="a6d-decision-trace__idle">Awaiting perception input.</div>`;
          }
        }

        // map
        if (mapRobot && s.mapRobot) {
          mapRobot.setAttribute('transform', `translate(${s.mapRobot.x},${s.mapRobot.y}) rotate(${s.mapRobot.rot})`);
        }
        if (routeOut) routeOut.classList.toggle('is-drawn', s.mapRoute === 'out' || s.mapRoute === 'both');
        if (routeBack) routeBack.classList.toggle('is-drawn', s.mapRoute === 'back' || s.mapRoute === 'both');
        if (mapTargetRing) mapTargetRing.classList.toggle('is-locked', !!s.mapTargetLocked);

        // digital twin
        if (twin) twin.classList.toggle('is-walking', !!s.twinWalking && !reduceMotion);
        if (twinArmEl && s.twinArm) twinArmEl.setAttribute('data-pose', s.twinArm);
        if (twinGripperEl && s.twinGripper) twinGripperEl.setAttribute('data-state', s.twinGripper);
        if (twinArmValue) twinArmValue.textContent = (s.twinArm ?? 'default').replace('-', ' ').toUpperCase();
        if (twinGripperValue) twinGripperValue.textContent = (s.twinGripper ?? 'open').toUpperCase();
        if (twinMovementValue) twinMovementValue.textContent = s.twinMovement ?? 'IDLE';

        // mission timeline
        if (missionLabelEl) missionLabelEl.textContent = s.missionLabel;
        stateItems.forEach((el) => el.classList.toggle('is-current', el.dataset.stateId === id));

        // autonomy stack — a state may highlight more than one node at once
        // (e.g. detect → YOLO26n and Perception together)
        autonomyNodes.forEach((el) => {
          const active = Array.isArray(s.autonomyNode)
            ? s.autonomyNode.includes(el.dataset.autonomyNode ?? '')
            : el.dataset.autonomyNode === s.autonomyNode;
          el.classList.toggle('is-active', active);
        });

        // control authority
        authorityNodes.forEach((el) => el.classList.toggle('is-active', el.dataset.authorityNode === s.authorityNode));

        // lighting ties loosely to mission activity — on while the robot is doing something
        if (lightingValue) {
          const on = id !== 'idle' && id !== 'complete' && id !== 'emergency_stop';
          lightingValue.textContent = on ? 'ON' : 'OFF';
        }

        // banners
        if (completeBanner) completeBanner.hidden = id !== 'complete';
        if (estopBanner) estopBanner.hidden = id !== 'emergency_stop';
      };

      // ---- mode ----
      const modeBtns = root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
      const manualControlButtons = root.querySelectorAll<HTMLButtonElement>(
        '.a6d-quickcontrol [data-cmd-btn], .a6d-quickcontrol [data-flashlight-btn]'
      );
      const quickcontrolLocked = root.querySelector<HTMLElement>('[data-quickcontrol-locked]');
      const setMode = (mode: string) => {
        modeBtns.forEach((b) => {
          const active = b.dataset.mode === mode;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        const autonomous = mode === 'autonomous';
        root.classList.toggle('is-mode-autonomous', autonomous);
        authorityCols.forEach((el) => el.classList.toggle('is-active-mode', el.dataset.authority === mode));
        // In AUTONOMOUS mode the mission system has control authority, so
        // the manual control preview goes greyed-out and unresponsive —
        // real <button disabled> (not just CSS) so keyboard/AT users get
        // the same "not available right now" state as pointer users.
        manualControlButtons.forEach((b) => (b.disabled = autonomous));
        if (quickcontrolLocked) quickcontrolLocked.hidden = !autonomous;
      };
      modeBtns.forEach((btn) => btn.addEventListener('click', () => setMode(btn.dataset.mode || 'manual')));
      setMode('manual');

      // ---- person alert ----
      const alertPanel = root.querySelector<HTMLElement>('[data-alert-panel]');
      const alertTime = alertPanel?.querySelector<HTMLElement>('[data-alert-time]');
      const alertGps = alertPanel?.querySelector<HTMLElement>('[data-alert-gps]');
      const alertSound = alertPanel?.querySelector<HTMLAudioElement>('[data-alert-sound]');
      let alertDismissedThisRun = false;
      // Simulated position near Dhaka, jittered a little each time so it
      // reads as a live fix rather than a hardcoded constant — still just
      // demo data, same as every other "Simulated" GPS value on this page.
      const BASE_LAT = 23.8103;
      const BASE_LON = 90.4125;
      const nextGpsFix = () => {
        const lat = BASE_LAT + (Math.random() - 0.5) * 0.01;
        const lon = BASE_LON + (Math.random() - 0.5) * 0.01;
        const ns = lat >= 0 ? 'N' : 'S';
        const ew = lon >= 0 ? 'E' : 'W';
        return `${Math.abs(lat).toFixed(4)}° ${ns}, ${Math.abs(lon).toFixed(4)}° ${ew}`;
      };
      const showPersonAlert = () => {
        if (!alertPanel || alertDismissedThisRun) return;
        const wasHidden = alertPanel.hidden;
        if (alertTime) alertTime.textContent = nextTime();
        if (alertGps) alertGps.textContent = nextGpsFix();
        alertPanel.hidden = false;
        requestAnimationFrame(() => alertPanel.classList.add('is-visible'));
        if (wasHidden && alertSound) {
          alertSound.loop = true;
          alertSound.currentTime = 0;
          alertSound.play().catch(() => {});
        }
      };
      const hidePersonAlert = () => {
        if (!alertPanel) return;
        alertPanel.classList.remove('is-visible');
        window.setTimeout(() => { if (alertPanel) alertPanel.hidden = true; }, 350);
        if (alertSound) {
          alertSound.pause();
          alertSound.currentTime = 0;
        }
      };
      alertPanel?.querySelector<HTMLButtonElement>('[data-alert-dismiss]')?.addEventListener('click', () => {
        alertDismissedThisRun = true;
        hidePersonAlert();
        logEvent('OPERATOR · Person alert dismissed');
      });

      // ---- demo engine (shared by manual advance, auto demo, guided presentation, replay) ----
      let demoTimer: number | undefined;
      let isRunning = false;

      const runBtn = root.querySelector<HTMLButtonElement>('[data-run-demo]');
      const wiceBtn = root.querySelector<HTMLButtonElement>('[data-run-wice]');

      // Guided WICE Presentation DOM refs. This is a dashboard playback mode
      // layered on top of the same mission state — not a robot mode.
      const wiceBar = root.querySelector<HTMLElement>('[data-wice-bar]');
      const wiceInfo = root.querySelector<HTMLElement>('[data-wice-info]');
      const wiceStageNumEl = root.querySelector<HTMLElement>('[data-wice-stage-num]');
      const wiceStageTitleEl = root.querySelector<HTMLElement>('[data-wice-stage-title]');
      const wiceInfoNumEl = root.querySelector<HTMLElement>('[data-wice-info-num]');
      const wiceInfoTitleEl = root.querySelector<HTMLElement>('[data-wice-info-title]');
      const wiceInfoCurrentEl = root.querySelector<HTMLElement>('[data-wice-info-current]');
      const wiceInfoConceptEl = root.querySelector<HTMLElement>('[data-wice-info-concept]');
      const wiceInfoNextBtn = root.querySelector<HTMLButtonElement>('[data-wice-info-next]');
      const wicePrevBtn = root.querySelector<HTMLButtonElement>('[data-wice-prev]');
      const wicePlayBtn = root.querySelector<HTMLButtonElement>('[data-wice-play]');
      const wicePauseBtn = root.querySelector<HTMLButtonElement>('[data-wice-pause]');
      const wiceNextBtn = root.querySelector<HTMLButtonElement>('[data-wice-next]');
      const wiceRestartBtn = root.querySelector<HTMLButtonElement>('[data-wice-restart]');
      const wiceExitBtn = root.querySelector<HTMLButtonElement>('[data-wice-exit]');
      const wiceNotesToggleBtn = root.querySelector<HTMLButtonElement>('[data-wice-notes-toggle]');
      const wiceNotesHideBtn = root.querySelector<HTMLButtonElement>('[data-wice-notes-hide]');
      const wiceNotesPanel = root.querySelector<HTMLElement>('[data-wice-notes]');
      const wiceNotesTextEl = root.querySelector<HTMLElement>('[data-wice-notes-text]');
      const targetCandidatesEl = root.querySelector<HTMLElement>('[data-target-candidates]');
      const candidateRows = Array.from(root.querySelectorAll<HTMLElement>('[data-candidate]'));
      const emphasisEls = Array.from(root.querySelectorAll<HTMLElement>('[data-emphasis-group]'));

      let wiceActive = false;
      let wiceStageIndex = 0;
      type PresentationPlayback = 'ready' | 'playing_stage' | 'paused' | 'transitioning' | 'completed';
      let wicePlayback: PresentationPlayback = 'ready';
      let wiceCancelIntro: (() => void) | null = null;
      let wiceEstopLatched = false;
      const totalStages = PRESENTATION_STAGES.length;

      const clearTimers = () => {
        if (demoTimer) { window.clearTimeout(demoTimer); demoTimer = undefined; }
        wiceCancelIntro?.();
        wiceCancelIntro = null;
      };

      const setRunning = (running: boolean) => {
        isRunning = running;
        runBtn?.toggleAttribute('disabled', running || wiceActive);
        wiceBtn?.toggleAttribute('disabled', running || wiceActive);
      };

      const enableReplay = () => {
        root.querySelectorAll<HTMLButtonElement>('[data-replay-btn]').forEach((b) => (b.disabled = false));
        root.querySelector<HTMLButtonElement>('[data-replay-run]')?.removeAttribute('disabled');
      };

      const runSequence = (onDone?: () => void) => {
        clearTimers();
        exitPresentation({ silent: true });
        setRunning(true);
        alertDismissedThisRun = false;
        hidePersonAlert();
        let i = 0;
        const step = () => {
          const id = SEQUENCE[i];
          applyState(id);
          STATE_META[id].log?.forEach((m) => logEvent(m));
          if (id === 'detect') window.setTimeout(showPersonAlert, 900);
          i++;
          if (i < SEQUENCE.length) {
            demoTimer = window.setTimeout(step, 2600);
          } else {
            setRunning(false);
            enableReplay();
            onDone?.();
          }
        };
        logEvent('SYSTEM · Autonomous demo started');
        step();
      };

      runBtn?.addEventListener('click', () => runSequence());
      root.querySelector<HTMLButtonElement>('[data-run-again]')?.addEventListener('click', () => runSequence());
      root.querySelector<HTMLButtonElement>('[data-replay-run]')?.addEventListener('click', () => runSequence());

      // ---- Guided WICE Presentation controller ----
      // ARGUS-6 Mission State Machine → WICE Presentation Controller →
      // Camera / Map / Target / Digital Twin (+ Event Log). The controller
      // never simulates a panel on its own — it only calls applyState()
      // (the one source of truth already used by the fast demo and replay)
      // and layers narration/timing on top.

      const runBeats = (beats: { delay: number; run: () => void }[], onDone: () => void): (() => void) => {
        let cancelled = false;
        let timer: number | undefined;
        const step = (i: number) => {
          if (cancelled) return;
          if (i >= beats.length) { onDone(); return; }
          beats[i].run();
          timer = window.setTimeout(() => step(i + 1), beats[i].delay);
        };
        step(0);
        return () => { cancelled = true; if (timer) window.clearTimeout(timer); };
      };

      const applyEmphasis = (groups: string[] | null) => {
        emphasisEls.forEach((el) => {
          const own = (el.dataset.emphasisGroup ?? '').split(' ').filter(Boolean);
          if (!wiceActive || !groups || groups.length === 0) {
            el.classList.remove('is-emphasis-dim', 'is-emphasis-active');
            return;
          }
          const match = own.some((g) => groups.includes(g));
          el.classList.toggle('is-emphasis-active', match);
          el.classList.toggle('is-emphasis-dim', !match);
        });
      };

      // Deterministic, index-derived timestamps (not the live demo clock) so
      // Previous/Next always reproduce the exact same log for a given stage.
      const presentationLogTime = (i: number) => {
        const totalSeconds = 18 * 3600 + 42 * 60 + i * 3 + (i % 3) * 2;
        const h = String(Math.floor(totalSeconds / 3600) % 24).padStart(2, '0');
        const m = String(Math.floor(totalSeconds / 60) % 60).padStart(2, '0');
        const s = String(totalSeconds % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      };

      // The event log is a pure function of "which stages have been reached
      // so far" — recomputed on every stage change, forward or backward, so
      // Previous restores it exactly rather than trying to undo prepends.
      const renderPresentationLog = (index: number) => {
        if (!logList) return;
        const lines: string[] = [];
        for (let i = 0; i <= index; i++) presentationStageLog(PRESENTATION_STAGES[i]).forEach((l) => lines.push(l));
        logList.innerHTML = lines
          .map((msg, i) => `<li><span class="a6d-log__time mono">${presentationLogTime(i)}</span><span class="a6d-log__msg">${msg}</span></li>`)
          .reverse()
          .join('');
        logSeeded = true;
      };

      // Resets the small bits of transient UI a stage's intro beats may have
      // overridden (candidate list, decision-trace visibility) back to the
      // baseline applyState() already established for the new stage.
      const settleStage = () => {
        if (targetCandidatesEl) targetCandidatesEl.hidden = true;
        if (decisionTraceEl) decisionTraceEl.style.visibility = 'visible';
        candidateRows.forEach((el) => el.classList.remove('is-selected'));
      };

      const updatePersonAlertForIndex = (index: number) => {
        if (index >= PERSON_ALERT_STAGE_INDEX && !alertDismissedThisRun) {
          showPersonAlert();
        } else if (index < PERSON_ALERT_STAGE_INDEX) {
          hidePersonAlert();
        }
      };

      const revealBox = (el: HTMLElement | null) => {
        if (!el) return;
        el.hidden = false;
        el.classList.remove('is-revealing');
        void el.offsetWidth;
        el.classList.add('is-revealing');
      };

      // Per-stage intro beats. Most stages just need to hold PLAYING_STAGE
      // long enough for the existing CSS transitions (bbox/map/twin, all
      // already driven by applyState) to settle — only a handful need a
      // hand-authored sequence beyond a single tween (staggered detections,
      // the candidate → decision → lock reveal, the arm/gripper sequences).
      const getStageBeats = (stage: PresentationStage): { delay: number; run: () => void }[] => {
        switch (stage.id) {
          case 'perception':
            return [
              { delay: 0, run: () => (['t01', 't02', 't03', 't04'] as const).forEach((k) => { const el = boxes[k]; if (el) el.hidden = true; }) },
              { delay: 260, run: () => revealBox(boxes.t01) },
              { delay: 420, run: () => revealBox(boxes.t02) },
              { delay: 420, run: () => revealBox(boxes.t03) },
              { delay: 480, run: () => revealBox(boxes.t04) },
              { delay: 420, run: () => {} },
            ];
          case 'person-alert':
            return [
              { delay: 350, run: () => showPersonAlert() },
              { delay: 550, run: () => {} },
            ];
          case 'target-selection':
            return [
              { delay: 0, run: () => {
                  if (targetCandidatesEl) targetCandidatesEl.hidden = false;
                  if (decisionTraceEl) decisionTraceEl.style.visibility = 'hidden';
                  if (targetDetailEl) targetDetailEl.hidden = true;
                  if (targetSummaryEl) targetSummaryEl.textContent = 'ANALYZING CANDIDATES';
                } },
              { delay: 900, run: () => {
                  candidateRows.find((el) => el.dataset.candidate === 't04')?.classList.add('is-selected');
                  if (targetSummaryEl) targetSummaryEl.textContent = 'TARGET 04 SELECTED';
                } },
              { delay: 900, run: () => {
                  if (targetCandidatesEl) targetCandidatesEl.hidden = true;
                  if (decisionTraceEl) decisionTraceEl.style.visibility = 'visible';
                  if (targetDetailEl) targetDetailEl.hidden = false;
                } },
              { delay: 600, run: () => {
                  if (targetSummaryEl) targetSummaryEl.textContent = 'TARGET 04 · LOCKED';
                  if (targetLockStatusEl) targetLockStatusEl.textContent = 'LOCKED';
                } },
            ];
          case 'approach':
            return [{ delay: 4200, run: () => {} }];
          case 'align': {
            const base = STATE_META.align.mapRobot!;
            return [
              { delay: 0, run: () => mapRobot?.setAttribute('transform', `translate(${base.x},${base.y}) rotate(${base.rot + 6})`) },
              { delay: 700, run: () => mapRobot?.setAttribute('transform', `translate(${base.x},${base.y}) rotate(${base.rot})`) },
              { delay: 1100, run: () => {} },
            ];
          }
          case 'stop':
            return [{ delay: 700, run: () => {} }];
          case 'grab':
            return [
              { delay: 0, run: () => { twinArmEl?.setAttribute('data-pose', 'default'); twinGripperEl?.setAttribute('data-state', 'open'); } },
              { delay: 700, run: () => twinArmEl?.setAttribute('data-pose', 'reach-target') },
              { delay: 700, run: () => { twinGripperEl?.setAttribute('data-state', 'closed'); if (t04Status) t04Status.textContent = 'COLLECTING'; } },
              { delay: 600, run: () => { if (t04Status) t04Status.textContent = 'COLLECTED ✓'; } },
            ];
          case 'verify':
            return [{ delay: 700, run: () => {} }];
          case 'arm-default':
            return [{ delay: 1100, run: () => {} }];
          case 'return-to-bin':
            return [{ delay: 3400, run: () => {} }];
          case 'align-bin': {
            const base = STATE_META.align_bin.mapRobot!;
            return [
              { delay: 0, run: () => mapRobot?.setAttribute('transform', `translate(${base.x},${base.y}) rotate(${base.rot - 6})`) },
              { delay: 650, run: () => mapRobot?.setAttribute('transform', `translate(${base.x},${base.y}) rotate(${base.rot})`) },
              { delay: 700, run: () => {} },
            ];
          }
          case 'deposit':
            return [
              { delay: 0, run: () => { twinArmEl?.setAttribute('data-pose', 'default'); twinGripperEl?.setAttribute('data-state', 'closed'); } },
              { delay: 700, run: () => twinArmEl?.setAttribute('data-pose', 'reach-bin') },
              { delay: 600, run: () => twinGripperEl?.setAttribute('data-state', 'open') },
              { delay: 600, run: () => twinArmEl?.setAttribute('data-pose', 'default') },
            ];
          default:
            return [{ delay: 400, run: () => {} }];
        }
      };

      const updateControlBarState = () => {
        const playing = wicePlayback === 'playing_stage';
        const atStart = wiceStageIndex === 0;
        const atEnd = wiceStageIndex === totalStages - 1;
        wicePrevBtn?.toggleAttribute('disabled', playing || atStart || wiceEstopLatched);
        wicePlayBtn?.toggleAttribute('disabled', playing || wiceEstopLatched);
        wicePauseBtn?.toggleAttribute('disabled', !playing || wiceEstopLatched);
        wiceNextBtn?.toggleAttribute('disabled', playing || atEnd || wiceEstopLatched);
        wiceInfoNextBtn?.toggleAttribute('disabled', playing || atEnd || wiceEstopLatched);
      };

      const renderStageChrome = () => {
        const stage = PRESENTATION_STAGES[wiceStageIndex];
        const num = String(wiceStageIndex + 1);
        if (wiceStageNumEl) wiceStageNumEl.textContent = num;
        if (wiceStageTitleEl) wiceStageTitleEl.textContent = stage.title;
        if (wiceInfoNumEl) wiceInfoNumEl.textContent = num;
        if (wiceInfoTitleEl) wiceInfoTitleEl.textContent = stage.title;
        if (wiceInfoCurrentEl) wiceInfoCurrentEl.textContent = stage.currentStateText;
        if (wiceInfoConceptEl) wiceInfoConceptEl.textContent = stage.keyConcept;
        if (wiceNotesTextEl) wiceNotesTextEl.textContent = stage.presenterNote;
        updateControlBarState();
      };

      // The single entry point for moving to any stage, forward or
      // backward: it always re-derives the full simulated state from
      // STATE_META via applyState(), so Previous restores camera, map,
      // target, twin, mission state, decision trace, timeline and log
      // exactly — not just the stage label.
      const goToStage = (index: number, animate: boolean) => {
        wiceCancelIntro?.();
        wiceCancelIntro = null;
        wiceStageIndex = Math.max(0, Math.min(totalStages - 1, index));
        const stage = PRESENTATION_STAGES[wiceStageIndex];
        applyState(stage.state);
        applyEmphasis(stage.emphasis);
        settleStage();
        if (!animate || stage.id !== 'person-alert') updatePersonAlertForIndex(wiceStageIndex);
        renderPresentationLog(wiceStageIndex);
        renderStageChrome();

        const finish = () => {
          wiceCancelIntro = null;
          wicePlayback = wiceStageIndex === totalStages - 1 ? 'completed' : 'paused';
          updateControlBarState();
        };

        if (animate) {
          wicePlayback = 'playing_stage';
          updateControlBarState();
          wiceCancelIntro = runBeats(getStageBeats(stage), finish);
        } else {
          finish();
        }
      };

      const startPresentation = () => {
        clearTimers();
        setRunning(true);
        wiceActive = true;
        wiceEstopLatched = false;
        alertDismissedThisRun = false;
        hidePersonAlert();
        root.classList.add('is-wice-active');
        if (wiceBar) wiceBar.hidden = false;
        if (wiceInfo) wiceInfo.hidden = false;
        goToStage(0, false);
      };

      function exitPresentation(opts?: { silent?: boolean }) {
        wiceCancelIntro?.();
        wiceCancelIntro = null;
        if (!wiceActive) return;
        wiceActive = false;
        wiceEstopLatched = false;
        root.classList.remove('is-wice-active');
        if (wiceBar) wiceBar.hidden = true;
        if (wiceInfo) wiceInfo.hidden = true;
        if (wiceNotesPanel) wiceNotesPanel.hidden = true;
        wiceNotesToggleBtn?.setAttribute('aria-expanded', 'false');
        applyEmphasis(null);
        if (targetCandidatesEl) targetCandidatesEl.hidden = true;
        if (decisionTraceEl) decisionTraceEl.style.visibility = 'visible';
        setRunning(false);
        if (!opts?.silent) {
          alertDismissedThisRun = false;
          hidePersonAlert();
          applyState('idle');
          if (logList) logList.innerHTML = '<li><span class="a6d-log__time mono">—</span><span class="a6d-log__msg">SYSTEM READY · Press Run Autonomous Demo to begin.</span></li>';
          logSeeded = false;
        }
      }

      const restartPresentation = () => {
        wiceCancelIntro?.();
        wiceCancelIntro = null;
        wiceEstopLatched = false;
        alertDismissedThisRun = false;
        hidePersonAlert();
        goToStage(0, false);
      };

      wiceBtn?.addEventListener('click', startPresentation);
      wicePrevBtn?.addEventListener('click', () => { if (wiceStageIndex > 0) goToStage(wiceStageIndex - 1, false); });
      wiceNextBtn?.addEventListener('click', () => { if (wiceStageIndex < totalStages - 1) goToStage(wiceStageIndex + 1, true); });
      wiceInfoNextBtn?.addEventListener('click', () => { if (wiceStageIndex < totalStages - 1) goToStage(wiceStageIndex + 1, true); });
      wicePlayBtn?.addEventListener('click', () => { if (wicePlayback !== 'playing_stage') goToStage(wiceStageIndex, true); });
      wicePauseBtn?.addEventListener('click', () => {
        if (wicePlayback !== 'playing_stage') return;
        wiceCancelIntro?.();
        wiceCancelIntro = null;
        wicePlayback = 'paused';
        updateControlBarState();
      });
      wiceRestartBtn?.addEventListener('click', restartPresentation);
      wiceExitBtn?.addEventListener('click', () => exitPresentation());
      wiceNotesToggleBtn?.addEventListener('click', () => {
        const show = wiceNotesPanel?.hidden ?? true;
        if (wiceNotesPanel) wiceNotesPanel.hidden = !show;
        wiceNotesToggleBtn.setAttribute('aria-expanded', String(show));
      });
      wiceNotesHideBtn?.addEventListener('click', () => {
        if (wiceNotesPanel) wiceNotesPanel.hidden = true;
        wiceNotesToggleBtn?.setAttribute('aria-expanded', 'false');
      });

      // ---- STOP / RESET ----
      const freezeMapRobot = () => {
        if (!mapRobot) return;
        const computed = getComputedStyle(mapRobot).transform;
        if (computed && computed !== 'none') {
          mapRobot.style.transition = 'none';
          mapRobot.setAttribute('transform', mapRobot.getAttribute('transform') || '');
          void mapRobot.getBoundingClientRect();
          mapRobot.style.transition = '';
        }
      };

      const stopSimulation = () => {
        const wasIdle = !isRunning && !wiceActive && currentId === 'idle';
        clearTimers();
        freezeMapRobot();
        setRunning(false);
        if (wiceActive) {
          wiceEstopLatched = true;
          wicePlayback = 'paused';
          updateControlBarState();
        }
        if (twin) twin.classList.remove('is-walking');
        applyState('emergency_stop');
        if (!wasIdle) logEvent('SAFETY · EMERGENCY STOP (demo) — all demo motion halted');
      };
      root.querySelectorAll<HTMLButtonElement>('[data-stop-btn]').forEach((btn) => btn.addEventListener('click', stopSimulation));

      const resetDemo = () => {
        exitPresentation({ silent: true });
        clearTimers();
        setRunning(false);
        alertDismissedThisRun = false;
        hidePersonAlert();
        applyState('idle');
        if (logList) logList.innerHTML = '<li><span class="a6d-log__time mono">—</span><span class="a6d-log__msg">SYSTEM READY · Press Run Autonomous Demo to begin.</span></li>';
        logSeeded = false;
      };
      root.querySelectorAll<HTMLButtonElement>('[data-reset-demo]').forEach((btn) => btn.addEventListener('click', resetDemo));

      // ---- replay (scrub through completed states) ----
      root.querySelectorAll<HTMLButtonElement>('[data-replay-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (btn.disabled) return;
          clearTimers();
          exitPresentation({ silent: true });
          setRunning(false);
          const id = btn.dataset.stateId as StateId;
          applyState(id);
        });
      });

      // ---- manual control preview (independent of the mission engine) ----
      const lastCommandEl = root.querySelector<HTMLElement>('[data-last-command]');
      root.querySelectorAll<HTMLButtonElement>('[data-cmd-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.dataset.cmd || '';
          if (lastCommandEl) lastCommandEl.textContent = cmd;
          logEvent(`CONTROL · Demo command: ${cmd} (control preview — not sent to robot)`);
        });
      });

      const flashlightBtn = root.querySelector<HTMLButtonElement>('[data-flashlight-btn]');
      const flashlightState = root.querySelector<HTMLElement>('[data-flashlight-state]');
      flashlightBtn?.addEventListener('click', () => {
        const isOn = flashlightState?.textContent === 'ON';
        if (flashlightState) flashlightState.textContent = isOn ? 'OFF' : 'ON';
        logEvent(`LIGHTING · Flashlight toggled ${isOn ? 'OFF' : 'ON'} (concept demo)`);
      });

      // ---- initial paint ----
      applyState('idle');
    });
  };

  initDashboard();
  document.addEventListener('astro:page-load', initDashboard);
</script>

<style>
  .a6d {
    --a6d-danger: #e5484d;
    --a6d-danger-bg: rgba(229, 72, 77, 0.12);
    --a6d-danger-line: rgba(229, 72, 77, 0.4);
  }

  /* Several elements in this component set their own `display` (grid/flex)
     for when they're shown, which otherwise silently beats the browser's
     default `[hidden]{display:none}` UA rule (author origin always wins
     over UA origin for non-important declarations, regardless of
     specificity). Force it explicitly so `hidden` always works here. */
  .a6d [hidden] { display: none !important; }

  /* ---------------- Persistent banner ---------------- */
  .a6d-banner {
    background: var(--bg-elev);
    border-bottom: 1px solid var(--border);
  }
  .a6d-banner__inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.5rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    color: var(--status-dev);
  }
  .a6d-banner__dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--status-dev);
    box-shadow: 0 0 0 3px var(--status-dev-bg);
  }

  /* ---------------- Hero ---------------- */
  .a6d-hero {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .a6d-hero__inner { position: relative; z-index: 1; max-width: 46rem; }
  .a6d-hero__title { font-size: clamp(2rem, 5.5vw, 3.2rem); letter-spacing: -0.03em; margin-top: 0.75rem; }
  .a6d-hero__desc { margin-top: 1rem; font-size: clamp(1rem, 2.2vw, 1.1rem); color: var(--text-muted); max-width: 58ch; }
  .a6d-hero__links { margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap; }

  /* ---------------- TOC ---------------- */
  .a6d-toc {
    position: sticky; top: 4.25rem; z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .a6d-toc .container { display: flex; align-items: center; gap: 1rem; }
  .a6d-toc__label { font-size: 0.62rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--text-dim); flex: none; padding-block: 0.75rem; }
  @media (max-width: 620px) { .a6d-toc__label { display: none; } }
  .a6d-toc ul { display: flex; gap: 0.25rem; padding-block: 0.5rem; white-space: nowrap; min-width: 0; flex: 1; -webkit-overflow-scrolling: touch; }
  .a6d-toc a { display: inline-block; padding: 0.4rem 0.7rem; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); border-radius: 5px; transition: color 0.2s var(--ease), background 0.2s var(--ease); }
  .a6d-toc__toggle {
    flex: none;
    display: grid; place-items: center;
    width: 1.8rem; height: 1.8rem;
    border: 1px solid var(--border-strong); border-radius: 6px;
    color: var(--text-muted);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .a6d-toc__toggle:hover { color: var(--accent); border-color: var(--accent-line); }
  .a6d-toc__toggle-icon { display: inline-block; font-size: 0.7rem; transition: transform 0.25s var(--ease); }
  .a6d-toc[data-collapsed="true"] .a6d-toc__toggle-icon { transform: rotate(180deg); }
  .a6d-toc[data-collapsed="true"] .a6d-toc__label,
  .a6d-toc[data-collapsed="true"] ul { display: none; }
  .a6d-toc[data-collapsed="true"] .container { padding-block: 0.3rem; }
  .a6d-toc a:hover { color: var(--text); background: rgba(255, 255, 255, 0.04); }

  .a6d-section { padding-block: clamp(2.75rem, 6vw, 5rem); }
  .band { border-block: 1px solid var(--border); background: var(--bg-elev); }

  /* Local copies of page-scoped grid utilities from the main ARGUS-6 page. */
  .two-col { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .two-col { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
    .two-col--wide-left { grid-template-columns: 0.85fr 1.15fr; }
  }
  .prose--wide { max-width: none; margin-top: 2rem; }

  /* ---------------- Shared bits ---------------- */
  .a6d-demo-chip {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono); font-size: 0.58rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--status-dev); background: var(--status-dev-bg);
    border: 1px solid color-mix(in srgb, var(--status-dev) 40%, transparent);
    padding: 0.18rem 0.5rem; border-radius: 999px; white-space: nowrap;
  }
  .a6d-panel-title { font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text); margin-bottom: 0.75rem; }
  .a6d-panel-subtitle { font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); margin: 1rem 0 0.6rem; }
  .a6d-microcaveat { font-size: 0.66rem; letter-spacing: 0.04em; color: var(--text-dim); }

  .a6d-metric-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.6rem; margin: 0.75rem 0; }
  .a6d-metric-grid--wide { grid-template-columns: 1fr; }
  @media (min-width: 420px) { .a6d-metric-grid--wide { grid-template-columns: repeat(2, 1fr); } }
  .a6d-metric-grid > div { padding: 0.55rem 0.7rem; border: 1px solid var(--border); border-radius: var(--radius-sm); }
  .a6d-metric-grid dt { font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-metric-grid dd { font-size: 0.86rem; color: var(--text); margin-top: 0.15rem; }

  /* ---------------- Command center grid ---------------- */
  .a6d-command { padding-block: clamp(1.75rem, 4vw, 2.5rem); }
  .a6d-command__container { display: grid; gap: 1.25rem; }
  .a6d-grid-2 { display: grid; gap: 1.25rem; }
  @media (min-width: 940px) {
    .a6d-grid-2 { grid-template-columns: 1fr 1fr; align-items: start; }
    .a6d-grid-2--camera { grid-template-columns: 1.7fr 1fr; }
    .a6d-grid-2--log { grid-template-columns: 1.2fr 1fr; }
  }
  /* Grid/flex items default to a content-based min-width, which lets
     unbroken content (long button rows, long labels) force a track wider
     than the viewport instead of wrapping within it. Force them to
     actually respect their track/container width everywhere in this
     layout. */
  .a6d-command__container > *,
  .a6d-grid-2 > *,
  .a6d-statusbar > *,
  .a6d-decision-trace > *,
  .a6d-metric-grid > * {
    min-width: 0;
  }

  /* ---------------- Status bar ---------------- */
  .a6d-statusbar {
    padding: 0.9rem 1.2rem;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.9rem 1.4rem;
  }
  .a6d-statusbar__id { display: grid; gap: 0.1rem; }
  .a6d-statusbar__name { font-size: 1rem; letter-spacing: 0.08em; font-weight: 600; }
  .a6d-statusbar__task { font-size: 0.62rem; letter-spacing: 0.1em; color: var(--text-dim); text-transform: uppercase; }
  .a6d-statusbar__flag { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.62rem; letter-spacing: 0.1em; color: var(--status-dev); }
  .a6d-statusbar__flag-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--status-dev); box-shadow: 0 0 0 3px var(--status-dev-bg); }

  .a6d-mode-select { display: inline-flex; border: 1px solid var(--border-strong); border-radius: 999px; padding: 0.2rem; gap: 0.2rem; }
  .a6d-mode-btn { font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.4rem 0.85rem; border-radius: 999px; color: var(--text-muted); transition: background 0.2s var(--ease), color 0.2s var(--ease); }
  .a6d-mode-btn.is-active { background: var(--accent-soft); color: var(--accent); }

  .a6d-demo-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-left: auto; }
  .a6d-run-btn, .a6d-wice-btn { font-size: 0.7rem; padding: 0.6rem 1rem; }
  .a6d-run-btn:disabled, .a6d-wice-btn:disabled { opacity: 0.45; pointer-events: none; }

  .a6d-stop-btn {
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
    padding: 0.6rem 1.1rem;
    color: var(--a6d-danger); background: var(--a6d-danger-bg);
    border: 1px solid var(--a6d-danger-line); border-radius: var(--radius-sm);
    transition: background 0.2s var(--ease), transform 0.15s var(--ease);
  }
  .a6d-stop-btn:hover { background: color-mix(in srgb, var(--a6d-danger) 20%, transparent); }
  .a6d-stop-btn:active { transform: scale(0.97); }

  /* ---------------- Guided WICE Presentation control bar ---------------- */
  .a6d-wice-bar {
    padding: 0.85rem 1.1rem;
    display: grid; gap: 0.6rem;
    border-left: 2px solid var(--accent);
  }
  .a6d-wice-bar__top { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; }
  .a6d-wice-bar__label { font-size: 0.68rem; letter-spacing: 0.12em; color: var(--text); font-weight: 600; }
  .a6d-wice-bar__guided {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.6rem; letter-spacing: 0.1em; color: var(--accent);
  }
  .a6d-wice-bar__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .a6d-wice-bar__spacer { flex: 1; }
  .a6d-wice-bar__controls { display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap; }
  .a6d-wice-bar__stage { font-size: 0.7rem; color: var(--text-dim); letter-spacing: 0.03em; }
  .a6d-wice-bar__stage-title { margin-left: 0.5rem; color: var(--accent); letter-spacing: 0.08em; }

  .a6d-wice-ctrl {
    font-size: 0.62rem; letter-spacing: 0.06em; padding: 0.4rem 0.75rem;
    border: 1px solid var(--border-strong); border-radius: 6px; color: var(--text-muted);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease), opacity 0.2s var(--ease);
  }
  .a6d-wice-ctrl:hover:not(:disabled) { color: var(--accent); border-color: var(--accent-line); }
  .a6d-wice-ctrl:disabled { opacity: 0.4; pointer-events: none; }
  .a6d-wice-ctrl--primary { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); font-weight: 600; }
  .a6d-wice-ctrl--notes[aria-expanded="true"] { color: var(--accent); border-color: var(--accent-line); }

  .a6d-wice-notes {
    padding: 0.75rem 0.9rem; border: 1px dashed var(--border-strong); border-radius: var(--radius-sm);
    display: grid; gap: 0.4rem; justify-items: start;
  }
  .a6d-wice-notes__label { font-size: 0.58rem; letter-spacing: 0.12em; color: var(--text-dim); }
  .a6d-wice-notes__text { font-size: 0.82rem; color: var(--text-muted); margin: 0; max-width: 62ch; }

  /* ---------------- Guided WICE Presentation info panel ---------------- */
  .a6d-wice-info { padding: 1rem 1.2rem; border-left: 2px solid var(--accent-line); display: grid; gap: 0.4rem; }
  .a6d-wice-info__eyebrow { font-size: 0.58rem; letter-spacing: 0.14em; color: var(--text-dim); }
  .a6d-wice-info__stage { font-size: 0.66rem; letter-spacing: 0.08em; color: var(--accent); }
  .a6d-wice-info__title { font-size: 1.05rem; letter-spacing: 0.02em; margin: 0.1rem 0 0.4rem; }
  .a6d-wice-info__row { display: grid; gap: 0.1rem; margin-top: 0.3rem; }
  .a6d-wice-info__key { font-size: 0.56rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-wice-info__row p { margin: 0; font-size: 0.88rem; color: var(--text); }
  .a6d-wice-info__next { margin-top: 0.6rem; justify-self: start; font-size: 0.68rem; padding: 0.55rem 0.9rem; }
  .a6d-wice-info__next:disabled { opacity: 0.45; pointer-events: none; }

  /* ---------------- Target candidates (Stage 4 reveal) ---------------- */
  .a6d-target-candidates { margin: 0.75rem 0; }
  .a6d-candidate-list { display: grid; gap: 0.3rem; }
  .a6d-candidate-list li {
    display: grid; grid-template-columns: auto 1fr auto; gap: 0.75rem; align-items: baseline;
    padding: 0.45rem 0.65rem; border: 1px solid var(--border); border-radius: 6px;
    font-size: 0.78rem; color: var(--text-muted);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease), color 0.3s var(--ease);
  }
  .a6d-candidate-list li.is-selected { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); font-weight: 600; }

  /* ---------------- Guided presentation emphasis (subtle, not hiding) ---------------- */
  .a6d[data-argus-dashboard] [data-emphasis-group] {
    transition: opacity 0.3s var(--ease), filter 0.3s var(--ease);
  }
  .a6d.is-wice-active [data-emphasis-group].is-emphasis-dim { opacity: 0.5; filter: saturate(0.65); }
  .a6d.is-wice-active [data-emphasis-group].is-emphasis-active { box-shadow: 0 0 0 1px var(--accent-line); border-radius: var(--radius-sm); }
  /* The fast-demo completion / e-stop banners have their own dedicated
     treatment inside the presentation control bar / info panel — avoid
     showing both at once, since their buttons (Run Again / Reset) would
     otherwise hijack the presenter out of guided mode. */
  .a6d.is-wice-active .a6d-complete-banner,
  .a6d.is-wice-active .a6d-estop-banner {
    display: none !important;
  }

  /* Bounding boxes appearing during the Stage 2 perception reveal */
  .a6d-bbox.is-revealing { animation: a6d-bbox-in 0.4s var(--ease); }
  @keyframes a6d-bbox-in { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }

  /* ---------------- Camera ---------------- */
  .a6d-camera { padding: 1rem; }
  .a6d-camera__viewport {
    position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-sm); overflow: hidden;
    background: radial-gradient(ellipse at 30% 20%, rgba(91,157,255,0.08), transparent 55%), linear-gradient(180deg, #0c1016 0%, #0a0d12 55%, #05070a 100%);
    border: 1px solid var(--border-strong);
  }
  .a6d-camera__horizon { position: absolute; left: 0; right: 0; bottom: 0; height: 42%; background: linear-gradient(180deg, transparent, rgba(63,185,80,0.05) 40%, rgba(20,26,20,0.35)); border-top: 1px solid rgba(255,255,255,0.05); }
  .a6d-camera__scanlines { position: absolute; inset: 0; background: repeating-linear-gradient(180deg, rgba(255,255,255,0.025) 0px, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 3px); mix-blend-mode: overlay; pointer-events: none; }
  .a6d-camera__vignette { position: absolute; inset: 0; box-shadow: inset 0 0 6rem rgba(0,0,0,0.6); pointer-events: none; }

  .a6d-camera__corner { position: absolute; width: 16px; height: 16px; border: 1.5px solid rgba(91,157,255,0.55); }
  .a6d-camera__corner--tl { top: 10px; left: 10px; border-right: 0; border-bottom: 0; }
  .a6d-camera__corner--tr { top: 10px; right: 10px; border-left: 0; border-bottom: 0; }
  .a6d-camera__corner--bl { bottom: 10px; left: 10px; border-right: 0; border-top: 0; }
  .a6d-camera__corner--br { bottom: 10px; right: 10px; border-left: 0; border-top: 0; }

  .a6d-camera__tag { position: absolute; top: 12px; left: 34px; display: flex; align-items: center; gap: 0.4rem; font-size: 0.6rem; letter-spacing: 0.1em; color: var(--status-dev); background: rgba(8,9,11,0.55); padding: 0.2rem 0.5rem; border-radius: 4px; }

  .a6d-camera__standby, .a6d-camera__complete {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-size: 0.78rem; letter-spacing: 0.08em; color: var(--text-dim); text-align: center; padding: 1rem;
  }
  .a6d-camera__complete { color: var(--status-working); font-size: 1rem; letter-spacing: 0.14em; }

  .a6d-camera__readout { position: absolute; right: 10px; bottom: 10px; display: flex; align-items: center; gap: 0.6rem; font-size: 0.64rem; color: var(--text-muted); background: rgba(8,9,11,0.55); padding: 0.3rem 0.6rem; border-radius: 6px; }
  .a6d-camera__readout b { color: var(--text); }

  .a6d-bbox {
    position: absolute; border: 1.5px solid #3fb950; border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.4);
    transition: left 0.9s var(--ease), top 0.9s var(--ease), width 0.9s var(--ease), height 0.9s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .a6d-bbox--person { border-color: #d9a441; }
  .a6d-bbox.is-highlighted { box-shadow: 0 0 0 3px rgba(255,255,255,0.2), 0 0 16px rgba(63,185,80,0.4); }
  .a6d-bbox__label { position: absolute; top: -1.4rem; left: -1.5px; font-size: 0.56rem; letter-spacing: 0.03em; white-space: nowrap; color: #0a0f0a; background: #3fb950; padding: 0.12rem 0.4rem; border-radius: 3px 3px 3px 0; }
  .a6d-bbox--person .a6d-bbox__label { color: #1a1305; background: #d9a441; }
  .a6d-bbox__label b { font-weight: 700; }
  .a6d-bbox__status { position: absolute; bottom: -1.3rem; left: -1.5px; font-size: 0.54rem; letter-spacing: 0.06em; color: var(--accent); background: rgba(8,9,11,0.7); padding: 0.1rem 0.35rem; border-radius: 3px; white-space: nowrap; }

  /* ---------------- Map ---------------- */
  .a6d-map { position: relative; padding: 1rem; }
  .a6d-map__tag { position: absolute; top: 1rem; left: 1rem; z-index: 1; }
  .a6d-map__svg { width: 100%; height: auto; display: block; }
  .a6d-map__label { font: 500 8px var(--font-mono); letter-spacing: 0.02em; }
  .a6d-map-legend { display: grid; gap: 0.5rem; margin-top: 0.75rem; font-size: 0.76rem; color: var(--text-muted); }
  .a6d-map-legend li { display: flex; align-items: center; gap: 0.6rem; }
  .a6d-legend-swatch { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .a6d-legend-swatch--ring { background: transparent; border: 2px solid; }
  .a6d-legend-swatch--square { background: transparent; border: 1.5px solid var(--accent); border-radius: 3px; }
  .a6d-legend-swatch--dash { width: 16px; height: 0; border-top: 1.5px dashed var(--border-strong); border-radius: 0; }

  .a6d-map__svg [data-map-robot] { transition: transform 2.4s var(--ease); }
  .a6d-map__svg path[data-route-out], .a6d-map__svg path[data-route-back] { transition: stroke-dashoffset 2s var(--ease); }
  .a6d-map__svg path[data-route-out].is-drawn, .a6d-map__svg path[data-route-back].is-drawn { stroke-dashoffset: 0; }
  .a6d-map__svg [data-map-target-ring] { transition: opacity 0.3s var(--ease); }
  .a6d-map__svg [data-map-target-ring].is-locked { animation: a6d-ring-pulse 1.8s ease-in-out infinite; }
  @keyframes a6d-ring-pulse { 0%, 100% { r: 10; opacity: 0.5; } 50% { r: 14; opacity: 0.12; } }

  /* ---------------- Target / decision panel ---------------- */
  .a6d-target-panel, .a6d-twin-panel { padding: 1.2rem; }
  .a6d-target-panel__head, .a6d-twin-panel__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .a6d-target-status { font-size: 0.95rem; color: var(--accent); letter-spacing: 0.04em; }

  .a6d-decision-trace { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.5rem; font-size: 0.78rem; }
  .a6d-decision-trace > div { padding: 0.5rem 0.65rem; border: 1px solid var(--border); border-radius: 6px; }
  .a6d-decision-trace dt { font-size: 0.56rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .a6d-decision-trace dd { color: var(--text); margin-top: 0.15rem; }
  .a6d-decision-trace__selected { grid-column: 1 / -1; border-color: var(--accent-line) !important; background: var(--accent-soft); }
  .a6d-decision-trace__selected dd { color: var(--accent); font-weight: 600; font-size: 0.88rem; }
  .a6d-decision-trace__why { grid-column: 1 / -1; }
  .a6d-decision-trace__why dd { color: var(--text-muted); line-height: 1.5; }
  .a6d-decision-trace__idle { grid-column: 1 / -1; padding: 0.6rem 0.75rem; color: var(--text-dim); border: 1px dashed var(--border-strong); border-radius: 6px; }

  /* ---------------- Digital twin ---------------- */
  .a6d-twin { padding: 0.5rem; }
  .a6d-twin__svg { width: 100%; height: auto; display: block; }
  .a6d-twin__body { fill: var(--surface-raised); stroke: var(--accent-line); stroke-width: 1.5; }
  .a6d-twin__leg { transform-box: view-box; }
  .a6d-twin__leg--l1 { transform-origin: 88px 76px; }
  .a6d-twin__leg--l2 { transform-origin: 88px 85px; }
  .a6d-twin__leg--l3 { transform-origin: 88px 94px; }
  .a6d-twin__leg--r1 { transform-origin: 132px 76px; }
  .a6d-twin__leg--r2 { transform-origin: 132px 85px; }
  .a6d-twin__leg--r3 { transform-origin: 132px 94px; }
  .a6d-twin__thigh, .a6d-twin__shin { fill: none; stroke: var(--text-muted); stroke-width: 2.5; stroke-linecap: round; }
  .a6d-twin__foot { fill: var(--accent); }
  .a6d-twin__heading { fill: var(--accent); opacity: 0.85; }

  .a6d-twin.is-walking .a6d-twin__leg { animation: a6d-twin-step 0.9s ease-in-out infinite; }
  .a6d-twin.is-walking .a6d-twin__leg--r1,
  .a6d-twin.is-walking .a6d-twin__leg--l2,
  .a6d-twin.is-walking .a6d-twin__leg--r3 { animation-delay: 0.45s; }
  @keyframes a6d-twin-step { 0%, 100% { transform: rotate(-7deg); opacity: 1; } 50% { transform: rotate(7deg); opacity: 0.8; } }

  .a6d-twin__arm { transform-box: view-box; transform-origin: 118px 78px; transition: transform 0.9s var(--ease); }
  .a6d-twin__arm[data-pose="reach-target"] { transform: rotate(-38deg); }
  .a6d-twin__arm[data-pose="reach-bin"] { transform: rotate(48deg); }
  .a6d-twin__arm-upper, .a6d-twin__arm-lower { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; }
  .a6d-twin__gripper-finger { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; transform-box: fill-box; transform-origin: 0 0; transition: transform 0.4s var(--ease); }
  .a6d-twin__gripper[data-state="closed"] .a6d-twin__gripper-finger--a { transform: rotate(12deg); }
  .a6d-twin__gripper[data-state="closed"] .a6d-twin__gripper-finger--b { transform: rotate(-12deg); }

  /* ---------------- Mission timeline ---------------- */
  .a6d-timeline-panel { padding: 1.1rem 1.2rem; }
  .a6d-timeline-panel__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; margin-bottom: 0.9rem; }
  .a6d-mission-label { font-size: 0.72rem; color: var(--accent); letter-spacing: 0.02em; }
  .a6d-state-machine { display: flex; gap: 0.5rem; padding-bottom: 0.2rem; }
  .a6d-state {
    display: flex; align-items: center; gap: 0.4rem; flex: none;
    padding: 0.5rem 0.75rem; border: 1px solid var(--border); border-radius: 999px;
    font-size: 0.7rem; color: var(--text-dim);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease), background 0.2s var(--ease);
  }
  .a6d-state__num { color: var(--text-dim); font-size: 0.6rem; }
  .a6d-state.is-current { color: var(--accent); border-color: var(--accent-line); background: var(--accent-soft); }
  .a6d-state.is-current .a6d-state__num { color: var(--accent); }

  /* ---------------- Event log ---------------- */
  .a6d-log { padding: 1.1rem; }
  .a6d-log__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.6rem; }
  .a6d-log__head .a6d-panel-title { margin-bottom: 0; }
  .a6d-log__list { display: grid; gap: 0.1rem; max-height: 300px; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--border-strong) transparent; }
  .a6d-log__list li { display: flex; gap: 0.75rem; padding: 0.4rem 0.3rem; font-size: 0.78rem; border-bottom: 1px solid var(--border); }
  .a6d-log__list li:last-child { border-bottom: 0; }
  .a6d-log__time { color: var(--text-dim); flex: none; }
  .a6d-log__msg { color: var(--text-muted); }

  /* ---------------- Quick control ---------------- */
  .a6d-quickcontrol { padding: 1.1rem; }
  .a6d-quickcontrol__flag { display: inline-flex; margin-bottom: 1rem; }
  /* AUTONOMOUS mode: the mission system has control authority, so the
     manual controls read as unavailable — dimmed, and (via the real
     `disabled` attribute set in JS) inert to click and keyboard alike. */
  .a6d-quickcontrol__locked {
    font-size: 0.68rem; letter-spacing: 0.06em; color: var(--accent);
    margin-bottom: 1rem;
  }
  .a6d-quickcontrol__body {
    transition: opacity 0.25s var(--ease);
  }
  .a6d.is-mode-autonomous .a6d-quickcontrol__body {
    opacity: 0.4;
  }
  .a6d-dpad__btn:disabled,
  .a6d-turn-row .btn:disabled,
  .a6d-toggle-btn:disabled {
    cursor: not-allowed;
    pointer-events: none;
  }
  .a6d-dpad { display: grid; grid-template-columns: repeat(3, 2.9rem); grid-template-rows: repeat(3, 2.9rem); gap: 0.35rem; justify-content: center; margin-bottom: 0.9rem; }
  .a6d-dpad__btn { border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: var(--surface-raised); color: var(--text); font-size: 1rem; transition: border-color 0.2s var(--ease), transform 0.15s var(--ease); }
  .a6d-dpad__btn:hover { border-color: var(--accent-line); }
  .a6d-dpad__btn:active { transform: scale(0.94); }
  .a6d-dpad__btn--up { grid-column: 2; grid-row: 1; }
  .a6d-dpad__btn--left { grid-column: 1; grid-row: 2; }
  .a6d-dpad__btn--stop { grid-column: 2; grid-row: 2; font-family: var(--font-mono); font-size: 0.58rem; color: var(--a6d-danger); border-color: var(--a6d-danger-line); background: var(--a6d-danger-bg); }
  .a6d-dpad__btn--right { grid-column: 3; grid-row: 2; }
  .a6d-dpad__btn--down { grid-column: 2; grid-row: 3; }
  .a6d-turn-row { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 0.9rem; }
  .a6d-turn-row .btn { padding: 0.55rem 0.9rem; font-size: 0.64rem; }
  .a6d-toggle-btn { font-size: 0.62rem; letter-spacing: 0.06em; padding: 0.55rem 0.8rem; border: 1px solid var(--border-strong); border-radius: var(--radius-sm); color: var(--text-muted); }
  .a6d-toggle-btn:hover { color: var(--accent); border-color: var(--accent-line); }
  .a6d-last-command { font-size: 0.76rem; color: var(--text-muted); padding-top: 0.75rem; border-top: 1px solid var(--border); }
  .a6d-last-command span { color: var(--accent); }

  /* ---------------- Completion / E-STOP banners ---------------- */
  .a6d-complete-banner, .a6d-estop-banner {
    padding: 1.1rem 1.3rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;
  }
  .a6d-complete-banner { border-left: 2px solid var(--status-working); }
  .a6d-estop-banner { border-left: 2px solid var(--a6d-danger); }
  .a6d-complete-banner__tag { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--status-working); font-weight: 700; }
  .a6d-estop-banner__tag { font-size: 0.78rem; letter-spacing: 0.1em; color: var(--a6d-danger); font-weight: 700; }
  .a6d-complete-banner p, .a6d-estop-banner p { margin-top: 0.3rem; font-size: 0.85rem; color: var(--text-muted); }
  .a6d-complete-banner__actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  /* ---------------- Person alert (fixed, slides from left) ---------------- */
  .a6d-alert {
    position: fixed; left: 24px; top: 120px; z-index: 400;
    width: min(320px, calc(100vw - 48px));
    padding: 1.1rem 1.25rem;
    background: var(--surface); background-image: var(--surface-grad);
