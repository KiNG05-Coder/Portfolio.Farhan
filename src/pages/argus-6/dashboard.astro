    | 'complete' | 'emergency_stop';

  const SEQUENCE: StateId[] = [
    'idle', 'detect', 'target_lock', 'approach', 'align', 'stop', 'grab',
    'verify', 'deposit', 'arm_default', 'return_to_base', 'complete',
  ];

  // Box geometry per phase — left/top/width/height as percentages of the
  // camera viewport. Shared by every state that shows target 04 so the box
  // only needs one definition per "phase" of the approach.
