<script>
  const MISSION_STATES = [
    'DETECT', 'APPROACH', 'ALIGN', 'STOP', 'GRAB', 'VERIFY', 'ARM DEFAULT',
    'RETURN TO BIN', 'ALIGN BIN', 'DEPOSIT', 'RESUME',
  ];

  const initDashboard = () => {
    document.querySelectorAll<HTMLElement>('[data-argus-dashboard]').forEach((root) => {
      if (root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      // ---- synthetic demo clock, continues from the seed log ----
      let clockSeconds = 15 * 3600 + 42 * 60 + 44;
      const nextTime = () => {
        clockSeconds += 3 + Math.floor(Math.random() * 5);
        const h = String(Math.floor(clockSeconds / 3600) % 24).padStart(2, '0');
        const m = String(Math.floor(clockSeconds / 60) % 60).padStart(2, '0');
        const s = String(clockSeconds % 60).padStart(2, '0');
        return `${h}:${m}:${s}`;
      };

      const logList = root.querySelector<HTMLElement>('[data-event-log]');
      const logEvent = (msg: string) => {
        if (!logList) return;
        const li = document.createElement('li');
        li.innerHTML = `<span class="a6d-log__time mono">${nextTime()}</span><span class="a6d-log__msg">${msg}</span>`;
        logList.prepend(li);
        while (logList.children.length > 40) logList.removeChild(logList.lastElementChild as Node);
      };

      // ---- mode selector ----
      const modeBtns = root.querySelectorAll<HTMLButtonElement>('[data-mode-btn]');
      const modeValues = root.querySelectorAll<HTMLElement>('[data-mode-value]');
      const modeExplainEls = root.querySelectorAll<HTMLElement>('[data-mode-explain]');
      modeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.dataset.mode || 'manual';
          modeBtns.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', String(active));
          });
          modeExplainEls.forEach((el) => {
            el.classList.toggle('is-active', el.dataset.modeExplain === mode);
          });
          const label = mode === 'autonomous' ? 'AUTONOMOUS' : 'MANUAL';
          modeValues.forEach((el) => (el.textContent = label));
          logEvent(`Demo mode set to ${label}`);
        });
      });

      // ---- movement / command buttons ----
      const lastCommandEl = root.querySelector<HTMLElement>('[data-last-command]');
      const movementValueEl = root.querySelector<HTMLElement>('[data-movement-value]');
      root.querySelectorAll<HTMLButtonElement>('[data-cmd-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.dataset.cmd || '';
          if (lastCommandEl) lastCommandEl.textContent = cmd;
          if (movementValueEl) movementValueEl.textContent = cmd === 'STOP' ? 'STOPPED' : cmd;
          logEvent(`Demo command: ${cmd} (control preview — not sent to robot)`);
        });
      });

      // ---- arm joints ----
      const jointState: Record<string, number> = { base: 90, shoulder: 45, elbow: 110 };
      const armValueEl = root.querySelector<HTMLElement>('[data-arm-value]');
      root.querySelectorAll<HTMLButtonElement>('[data-arm-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const joint = btn.dataset.joint || '';
          const delta = parseInt(btn.dataset.delta || '0', 10);
          jointState[joint] = Math.max(0, Math.min(180, (jointState[joint] ?? 90) + delta * 5));
          const out = root.querySelector<HTMLElement>(`[data-joint-value="${joint}"]`);
          if (out) out.textContent = `${jointState[joint]}°`;
          if (armValueEl) armValueEl.textContent = 'ADJUSTING (DEMO)';
          logEvent(`Demo command: ${joint.toUpperCase()} ${jointState[joint]}° (control preview)`);
        });
      });

      // ---- gripper ----
      const gripperStateEl = root.querySelector<HTMLElement>('[data-gripper-state-value]');
      root.querySelectorAll<HTMLButtonElement>('[data-gripper-btn]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const isOpen = btn.dataset.gripperValue === 'OPEN';
          const next = isOpen ? 'CLOSE' : 'OPEN';
          btn.dataset.gripperValue = next;
          btn.textContent = next;
          if (gripperStateEl) gripperStateEl.textContent = next;
          logEvent(`Demo command: GRIPPER ${next} (control preview)`);
        });
      });

      // ---- flashlight ----
      const flashlightBtn = root.querySelector<HTMLButtonElement>('[data-flashlight-btn]');
      const flashlightState = root.querySelector<HTMLElement>('[data-flashlight-state]');
      const flashlightDot = root.querySelector<HTMLElement>('[data-flashlight-dot]');
      flashlightBtn?.addEventListener('click', () => {
        const isOn = flashlightDot?.classList.contains('a6d-health-dot--off') === false;
        const next = !isOn;
        flashlightDot?.classList.toggle('a6d-health-dot--off', !next);
        if (flashlightState) flashlightState.textContent = `${next ? 'ON' : 'OFF'} — CONCEPT`;
        logEvent(`Flashlight toggled ${next ? 'ON' : 'OFF'} (concept demo)`);
      });

      // ---- camera detection chips <-> bounding boxes ----
      root.querySelectorAll<HTMLButtonElement>('[data-detection-chip]').forEach((chip) => {
        chip.addEventListener('click', () => {
          const key = chip.dataset.detection;
          const active = chip.classList.toggle('is-active');
          const box = root.querySelector<HTMLElement>(`[data-bbox="${key}"]`);
          box?.classList.toggle('is-highlighted', active);
        });
      });

      // ---- target cards ----
      const targetValueEl = root.querySelector<HTMLElement>('[data-target-value]');
      root.querySelectorAll<HTMLButtonElement>('[data-target-card]').forEach((card) => {
        card.addEventListener('click', () => {
          root.querySelectorAll<HTMLButtonElement>('[data-target-card]').forEach((c) => {
            const selected = c === card;
            c.classList.toggle('is-selected', selected);
            const statusEl = c.querySelector<HTMLElement>('[data-target-status]');
            if (statusEl) statusEl.textContent = selected ? 'Locked' : 'Waiting';
          });
          const id = card.dataset.target;
          if (targetValueEl) targetValueEl.textContent = `LOCKED — T${id}`;
          logEvent(`Demo target lock: TARGET ${id}`);
        });
      });

      // ---- mission state advance ----
      const missionValueEl = root.querySelector<HTMLElement>('[data-mission-value]');
      const advanceBtn = root.querySelector<HTMLButtonElement>('[data-mission-advance]');
      const stateItems = Array.from(root.querySelectorAll<HTMLElement>('[data-state-item]'));
      let stateIndex = stateItems.findIndex((el) => el.classList.contains('is-current'));
      if (stateIndex < 0) stateIndex = 0;
      advanceBtn?.addEventListener('click', () => {
        stateIndex = (stateIndex + 1) % stateItems.length;
        stateItems.forEach((el, i) => el.classList.toggle('is-current', i === stateIndex));
        const label = MISSION_STATES[stateIndex] || stateItems[stateIndex]?.textContent || '';
        if (missionValueEl) missionValueEl.textContent = label;
        logEvent(`Demo mission state → ${label}`);
      });

      // ---- alert dismiss ----
      root.querySelector<HTMLButtonElement>('[data-alert-dismiss]')?.addEventListener('click', () => {
        const panel = root.querySelector<HTMLElement>('[data-alert-panel]');
        if (panel) panel.hidden = true;
        logEvent('Demo alert dismissed by operator');
      });

      // ---- E-STOP ----
      const estopConfirm = root.querySelector<HTMLElement>('[data-estop-confirm]');
      root.querySelector<HTMLButtonElement>('[data-estop-btn]')?.addEventListener('click', () => {
        if (movementValueEl) movementValueEl.textContent = 'STOPPED';
        if (missionValueEl) missionValueEl.textContent = 'HALTED (DEMO)';
        if (lastCommandEl) lastCommandEl.textContent = 'E-STOP';
        if (estopConfirm) estopConfirm.hidden = false;
        logEvent('EMERGENCY STOP (demo) — all demo motion halted');
      });
    });
  };

  initDashboard();
  document.addEventListener('astro:page-load', initDashboard);
</script>

