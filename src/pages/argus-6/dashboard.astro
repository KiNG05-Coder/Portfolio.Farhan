    boxes?: Partial<Record<'t01' | 't02' | 't03' | 't04' | 'person', { pos: keyof typeof T04_BOX | 'fixed'; highlighted?: boolean; status?: string; fixedStyle?: { left: number; top: number; width: number; height: number } }>>;
    fps?: number;
    targetSummary: string;
    targetLockStatus?: string;
    showTargetDetail?: boolean;
    decisionTrace?: 'idle' | 'analyzing' | 'locked';
    mapRobot?: { x: number; y: number; rot: number };
    mapRoute?: 'none' | 'out' | 'back' | 'both';
    mapTargetLocked?: boolean;
    twinWalking?: boolean;
    twinArm?: 'default' | 'reach-target' | 'reach-bin';
    twinGripper?: 'open' | 'closed';
