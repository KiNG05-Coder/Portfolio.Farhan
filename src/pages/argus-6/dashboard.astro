---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Callout from '../../components/Callout.astro';
import Pipeline from '../../components/Pipeline.astro';
import { link } from '../../lib/link';

const sections = [
  ['command', 'Command Center'],
  ['authority', 'Control Authority'],
  ['autonomy', 'Autonomy Stack'],
  ['replay', 'Mission Replay'],
  ['health', 'System Health'],
  ['safety', 'Safety'],
  ['fit', 'Architecture Fit'],
  ['controller', 'Controller Mapping'],
  ['status-table', 'Implementation Status'],
  ['comparison', 'Today vs. Planned'],
];

// Server-rendered scaffolding only — the rich per-state behaviour (camera,
// map, digital twin, decision trace, autonomy highlight, log lines) lives in
// the client-side state machine below. This array just gives the timeline /
// replay strip something to render before JS runs.
const missionSequence = [
  ['idle', 'IDLE'],
  ['detect', 'DETECT'],
  ['target_lock', 'TARGET LOCK'],
  ['approach', 'APPROACH'],
  ['align', 'ALIGN'],
  ['stop', 'STOP'],
  ['grab', 'GRAB'],
  ['verify', 'VERIFY'],
  ['arm_default', 'ARM DEFAULT'],
  ['return_to_bin', 'RETURN TO BIN'],
  ['align_bin', 'ALIGN BIN'],
  ['deposit', 'DEPOSIT'],
  ['complete', 'COMPLETE'],
];

const autonomyStackNodes: [string, string][] = [
  ['usb_camera', 'USB Camera'],
  ['yolo', 'YOLO26n'],
  ['perception', 'Perception'],
  ['target_manager', 'Target Manager'],
  ['mission_manager', 'Mission Manager'],
  ['navigation', 'Navigation'],
  ['ros2', 'ROS 2'],
  ['pi', 'Raspberry Pi'],
  ['serial', 'Serial Bridge'],
  ['esp8266', 'ESP8266'],
  ['ik_gait', 'IK + Gait'],
  ['servos', 'Servos'],
];

const healthComponents = [
  { name: 'Raspberry Pi 4', state: 'ONLINE', tone: 'ok' },
  { name: 'ESP8266', state: 'ONLINE', tone: 'ok' },
  { name: 'USB Camera', state: 'CONNECTED', tone: 'ok' },
  { name: 'NEO-M8N GPS', state: 'CONNECTED', tone: 'ok' },
  { name: 'MPU6050 IMU', state: 'CONNECTED', tone: 'ok' },
  { name: 'Light Sensor (BH1750)', state: 'CONNECTED', tone: 'ok' },
  { name: 'ROS 2', state: 'RUNNING', tone: 'ok' },
  { name: 'SQLite', state: 'READY', tone: 'ok' },
  { name: 'FastAPI', state: 'RUNNING', tone: 'ok' },
];

const implementationStatus: [string, string][] = [
  ['Dashboard UI', 'Concept'],
  ['Raspberry Pi autonomy stack', 'Planned'],
  ['FastAPI', 'Planned'],
  ['WebSocket telemetry', 'Planned'],
  ['ROS 2 integration', 'Planned'],
  ['Live camera', 'Planned'],
  ['AI telemetry', 'Planned'],
  ['Mission control', 'Planned'],
  ['Manual controller integration', 'Planned'],
];

const builtToday = [
  'Six-legged locomotion',
  '18 × TD-8120MG servos (2 × PCA9685)',
  'IK / gait system',
  'Robotic arm',
  'Two-finger gripper',
  'Manual operation',
  'ESP8266 low-level control',
];

const plannedSystem = [
  'Raspberry Pi 4 autonomy stack',
  'ROS 2',
  'YOLO26n perception',
  'Object detection / tracking',
  'Person detection & incident alerts',
  'GPS/IMU localization',
  'Autonomous navigation',
  'Target management',
  'Mission management',
  'Web dashboard',
  'Pi ↔ ESP8266 integration',
  'Automatic lighting',
];
---

<BaseLayout
  title="ARGUS-6 Mission Control — Concept Simulation | Farhan Saif"
  description="An interactive concept simulation of the planned ARGUS-6 autonomous mission-control dashboard — AI perception, navigation, target locking, mission management and system health, with no connection to the physical robot."
  path="/argus-6/dashboard"
>
  <div class="a6d" data-argus-dashboard>
    {/* ---------------- COMPACT PERSISTENT BANNER ---------------- */}
    <div class="a6d-banner">
      <div class="container a6d-banner__inner">
        <span class="a6d-banner__dot" aria-hidden="true"></span>
        <span class="mono">CONCEPT SIMULATION · NO ROBOT CONNECTION</span>
      </div>
    </div>

    {/* ---------------- HERO ---------------- */}
    <section class="a6d-hero">
      <span class="grid-bg" aria-hidden="true" data-parallax="0.14"></span>
      <div class="container a6d-hero__inner">
        <p class="eyebrow" data-reveal>ARGUS-6 · Interface Concept</p>
        <h1 class="a6d-hero__title" data-reveal>ARGUS-6 Mission Control</h1>
        <p class="a6d-hero__desc" data-reveal>
          A simulated operator dashboard for the planned ARGUS-6 autonomy
          stack. Press <strong>Run Autonomous Demo</strong> below and watch
          perception, navigation, the robot and the mission log move as one
          system — all of it simulated, none of it connected to hardware.
        </p>
        <div class="a6d-hero__links" data-reveal>
          <a class="btn btn--primary" href={link('/argus-6')}>
            View physical prototype <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href={link('/documentation')}>Documentation</a>
        </div>
      </div>
    </section>

    {/* ---------------- ON-PAGE NAV ---------------- */}
    <nav class="a6d-toc" aria-label="Dashboard sections" data-toc>
      <div class="container">
        <span class="a6d-toc__label mono">Sections</span>
        <ul class="scroll-x" data-toc-list>
          {sections.map(([id, label]) => <li><a href={`#${id}`} class="mono">{label}</a></li>)}
        </ul>
        <button
          type="button"
          class="a6d-toc__toggle"
          data-toc-toggle
          aria-expanded="true"
          aria-label="Collapse section navigation"
          title="Collapse section navigation"
        >
          <span class="a6d-toc__toggle-icon" aria-hidden="true">▾</span>
        </button>
      </div>
    </nav>

    {/* ================================================================
        COMMAND CENTER — everything above the fold, one cohesive grid
        driven by the client-side mission state machine.
        ================================================================ */}
    <section class="section a6d-command" id="command">
      <div class="container a6d-command__container">

        {/* ---- Top status / control bar ---- */}
        <div class="a6d-statusbar panel">
          <div class="a6d-statusbar__id">
            <span class="a6d-statusbar__name mono">ARGUS-6</span>
            <span class="a6d-statusbar__task mono">Environmental Cleanup</span>
          </div>

          <span class="a6d-statusbar__flag mono">
            <span class="a6d-statusbar__flag-dot" aria-hidden="true"></span>
            CONCEPT SIMULATION
          </span>

          <div class="a6d-mode-select" role="group" aria-label="Operating mode (simulated)">
            <button type="button" class="a6d-mode-btn is-active" data-mode-btn data-mode="manual" aria-pressed="true">Manual</button>
            <button type="button" class="a6d-mode-btn" data-mode-btn data-mode="autonomous" aria-pressed="false">Autonomous</button>
          </div>

          <div class="a6d-demo-actions">
            <button type="button" class="btn btn--primary a6d-run-btn" data-run-demo>▶ Run Autonomous Demo</button>
            <button type="button" class="btn a6d-wice-btn" data-run-wice>WICE Demo Mode</button>
          </div>

          <button type="button" class="a6d-stop-btn mono" data-stop-btn>STOP</button>
        </div>

        {/* ---- Guided WICE Presentation control bar (hidden unless presentation mode is active) ----
             This is a dashboard playback/presentation mode only — it does not add a third robot
             operating mode. The robot stays MANUAL / AUTONOMOUS; this bar just steps a presenter
             through the same centralized mission state used everywhere else on the page. */}
        <div class="a6d-wice-bar panel" data-wice-bar hidden>
          <div class="a6d-wice-bar__top">
            <span class="a6d-wice-bar__label mono">WICE DEMO</span>
            <span class="a6d-wice-bar__guided mono"><span class="a6d-wice-bar__dot" aria-hidden="true"></span>GUIDED</span>
            <button type="button" class="a6d-wice-ctrl a6d-wice-ctrl--notes" data-wice-notes-toggle aria-expanded="false">Presenter Notes</button>
          </div>

          <div class="a6d-wice-bar__controls">
            <button type="button" class="a6d-wice-ctrl" data-wice-prev aria-label="Previous stage">← Previous Stage</button>
            <button type="button" class="a6d-wice-ctrl" data-wice-play aria-label="Play current stage">▶ Play Stage</button>
            <button type="button" class="a6d-wice-ctrl" data-wice-pause aria-label="Pause">⏸ Pause</button>
            <button type="button" class="a6d-wice-ctrl a6d-wice-ctrl--primary" data-wice-next aria-label="Next stage">Next Stage →</button>
            <span class="a6d-wice-bar__spacer" aria-hidden="true"></span>
            <button type="button" class="a6d-wice-ctrl" data-wice-restart aria-label="Restart presentation">↻ Restart</button>
            <button type="button" class="a6d-wice-ctrl" data-wice-exit aria-label="Exit guided presentation">Exit WICE</button>
          </div>

          <p class="a6d-wice-bar__stage mono">
            Stage <span data-wice-stage-num>1</span> of <span data-wice-stage-total>14</span>
            <span class="a6d-wice-bar__stage-title" data-wice-stage-title>OVERVIEW</span>
          </p>

          <div class="a6d-wice-notes" data-wice-notes hidden>
            <span class="a6d-wice-notes__label mono">Presenter Notes</span>
            <p class="a6d-wice-notes__text" data-wice-notes-text>—</p>
            <button type="button" class="a6d-wice-ctrl" data-wice-notes-hide>Hide Notes</button>
          </div>
        </div>

        {/* ---- Guided WICE Presentation — stage information panel ---- */}
        <div class="a6d-wice-info panel" data-wice-info hidden aria-live="polite">
          <span class="a6d-wice-info__eyebrow mono">WICE DEMO</span>
          <p class="a6d-wice-info__stage mono">STAGE <span data-wice-info-num>1</span> / <span data-wice-info-total>14</span></p>
          <h3 class="a6d-wice-info__title" data-wice-info-title>OVERVIEW</h3>
          <div class="a6d-wice-info__row">
            <span class="a6d-wice-info__key mono">Current State</span>
            <p data-wice-info-current>—</p>
          </div>
          <div class="a6d-wice-info__row">
            <span class="a6d-wice-info__key mono">Key Concept</span>
            <p data-wice-info-concept>—</p>
          </div>
          <button type="button" class="btn btn--primary a6d-wice-info__next" data-wice-info-next>Next Stage →</button>
        </div>

        <p class="a6d-microcaveat mono">All panels below are driven by one simulated mission state — nothing here reads from live hardware.</p>

        {/* ---- Camera + Map ---- */}
        <div class="a6d-grid-2 a6d-grid-2--camera">
          <div class="a6d-camera panel" id="camera" data-emphasis-group="perception">
            <div class="a6d-camera__viewport">
              <span class="a6d-camera__scanlines" aria-hidden="true"></span>
              <span class="a6d-camera__vignette" aria-hidden="true"></span>
              <span class="a6d-camera__horizon" aria-hidden="true"></span>

              <span class="a6d-camera__corner a6d-camera__corner--tl" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--tr" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--bl" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--br" aria-hidden="true"></span>

              <span class="a6d-camera__tag mono">● AI CAMERA <span class="a6d-demo-chip">SIM</span></span>

              <div class="a6d-camera__standby mono" data-cam-standby>STANDBY — press Run Autonomous Demo</div>
              <div class="a6d-camera__complete mono" data-cam-complete hidden>MISSION COMPLETE</div>

              <div class="a6d-bbox" data-bbox="t01" hidden><span class="a6d-bbox__label mono">CAN <b>0.82</b> · ID 01</span></div>
              <div class="a6d-bbox" data-bbox="t02" hidden><span class="a6d-bbox__label mono">CONTAINER <b>0.85</b> · ID 02</span></div>
              <div class="a6d-bbox" data-bbox="t03" hidden><span class="a6d-bbox__label mono">CAN <b>0.79</b> · ID 03</span></div>
              <div class="a6d-bbox a6d-bbox--primary" data-bbox="t04" hidden>
                <span class="a6d-bbox__label mono">PLASTIC_BOTTLE <b>0.91</b> · ID 04</span>
                <span class="a6d-bbox__status mono" data-bbox-status></span>
              </div>
              <div class="a6d-bbox a6d-bbox--person" data-bbox="person" hidden><span class="a6d-bbox__label mono">PERSON <b>0.96</b> · ID P07</span></div>

              <div class="a6d-camera__readout mono">
                <span>FPS <b data-cam-fps>—</b></span>
                <span>MODEL <b>YOLO26n</b></span>
              </div>
            </div>
          </div>

          <div class="a6d-map panel" id="map" data-emphasis-group="navigation">
            <span class="a6d-demo-chip a6d-map__tag">SIM · LIVE MAP</span>
            <svg viewBox="0 0 400 260" class="a6d-map__svg" role="img" aria-label="Simulated map of ARGUS-6's position, route, targets and mission boundary">
              <defs>
                <pattern id="a6d-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="400" height="260" fill="url(#a6d-grid)" />
              <polygon points="20,20 380,20 380,240 20,240" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" stroke-dasharray="6 5" />

              <path data-route-out d="M 60 210 C 120 170, 140 120, 190 100 S 280 70, 320 50" fill="none" stroke="#5b9dff" stroke-width="2.5" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" stroke-linecap="round" />
              <path data-route-back d="M 320 50 S 140 120, 60 210" fill="none" stroke="#3fb950" stroke-width="2.5" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" stroke-linecap="round" />
              <path d="M 60 210 C 120 170, 140 120, 190 100 S 280 70, 320 50" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1.5" stroke-dasharray="1 6" stroke-linecap="round" />

              <circle cx="120" cy="170" r="4" fill="#8b949e" />
              <circle cx="190" cy="100" r="4" fill="#8b949e" />
              <circle cx="280" cy="70" r="4" fill="#8b949e" />

              <g data-map-target="t01" transform="translate(230,196)"><circle r="7" fill="rgba(139,148,158,0.18)" /><circle r="3.5" fill="#8b949e" /></g>
              <g data-map-target="t02" transform="translate(255,175)"><circle r="7" fill="rgba(139,148,158,0.18)" /><circle r="3.5" fill="#8b949e" /></g>
              <g data-map-target="t03" transform="translate(150,150)"><circle r="7" fill="rgba(139,148,158,0.18)" /><circle r="3.5" fill="#8b949e" /></g>
              <g data-map-target="t04" transform="translate(320,50)">
                <circle r="10" fill="rgba(63,185,80,0.18)" data-map-target-ring />
                <circle r="4" fill="#3fb950" />
                <text x="13" y="4" class="a6d-map__label" fill="#9aa2ad">T04</text>
              </g>

              <g transform="translate(60,210)">
                <rect x="-9" y="-9" width="18" height="18" rx="3" fill="#171b22" stroke="#5b9dff" stroke-width="1.5" />
                <text x="15" y="4" class="a6d-map__label" fill="#9aa2ad">BIN</text>
              </g>

              <g data-map-robot transform="translate(60,210) rotate(-35)">
                <polygon points="0,-11 8,9 0,4 -8,9" fill="#5b9dff" stroke="#0a0f18" stroke-width="1" />
              </g>
            </svg>
            <ul class="a6d-map-legend">
              <li><span class="a6d-legend-swatch" style="background:#5b9dff"></span>ARGUS-6</li>
              <li><span class="a6d-legend-swatch a6d-legend-swatch--ring" style="border-color:#3fb950"></span>Locked target</li>
              <li><span class="a6d-legend-swatch a6d-legend-swatch--square"></span>Onboard bin (deposit point once the robot returns)</li>
              <li><span class="a6d-legend-swatch a6d-legend-swatch--dash"></span>Mission boundary</li>
            </ul>
          </div>
        </div>

        {/* ---- Target/Decision + Digital Twin ---- */}
        <div class="a6d-grid-2">
          <div class="panel a6d-target-panel" id="target" data-emphasis-group="targeting">
            <div class="a6d-target-panel__head">
              <h3 class="a6d-panel-title mono">Target Manager</h3>
              <span class="a6d-demo-chip">SIM</span>
            </div>
            <p class="a6d-target-status mono" data-target-summary>SEARCHING FOR TARGET</p>

            <div class="a6d-target-candidates" data-target-candidates hidden>
              <p class="a6d-panel-subtitle mono">Target Candidates</p>
              <ul class="a6d-candidate-list" data-candidate-list>
                <li data-candidate="t01"><span class="mono">ID 01</span><span>CAN</span><span class="mono">82%</span></li>
                <li data-candidate="t02"><span class="mono">ID 02</span><span>CONTAINER</span><span class="mono">85%</span></li>
                <li data-candidate="t03"><span class="mono">ID 03</span><span>CAN</span><span class="mono">79%</span></li>
                <li data-candidate="t04"><span class="mono">ID 04</span><span>PLASTIC BOTTLE</span><span class="mono">91%</span></li>
              </ul>
            </div>

            <dl class="a6d-metric-grid a6d-metric-grid--wide" data-target-detail hidden>
              <div><dt class="mono">Candidates</dt><dd class="mono">4</dd></div>
              <div><dt class="mono">Confidence</dt><dd class="mono">91%</dd></div>
              <div><dt class="mono">Position</dt><dd class="mono">Right</dd></div>
              <div><dt class="mono">Status</dt><dd class="mono" data-target-lock-status>WAITING</dd></div>
            </dl>

            <h4 class="a6d-panel-subtitle mono">Why did ARGUS-6 choose this target?</h4>
            <dl class="a6d-decision-trace mono" data-decision-trace>
              <div class="a6d-decision-trace__idle" data-decision-idle>Awaiting perception input.</div>
            </dl>
          </div>

          <div class="panel a6d-twin-panel" id="twin" data-emphasis-group="navigation collection">
            <div class="a6d-twin-panel__head">
              <h3 class="a6d-panel-title mono">ARGUS-6 Digital Twin</h3>
              <span class="a6d-demo-chip">SIM</span>
            </div>
            <div class="a6d-twin" data-twin>
              <svg viewBox="0 0 220 170" class="a6d-twin__svg" role="img" aria-label="Schematic top-down view of the ARGUS-6 hexapod, showing six legs, the body, and the robotic arm">
                <g class="a6d-twin__legs">
                  {[
                    { leg: 'l1', hip: [88, 76], knee: [55, 62], foot: [28, 50] },
                    { leg: 'l2', hip: [88, 85], knee: [50, 85], foot: [18, 85] },
                    { leg: 'l3', hip: [88, 94], knee: [55, 108], foot: [28, 120] },
                    { leg: 'r1', hip: [132, 76], knee: [165, 62], foot: [192, 50] },
                    { leg: 'r2', hip: [132, 85], knee: [170, 85], foot: [202, 85] },
                    { leg: 'r3', hip: [132, 94], knee: [165, 108], foot: [192, 120] },
                  ].map(({ leg, hip, knee, foot }) => (
                    <g class:list={['a6d-twin__leg', `a6d-twin__leg--${leg}`]} data-leg={leg}>
                      <path class="a6d-twin__thigh" d={`M ${hip[0]} ${hip[1]} L ${knee[0]} ${knee[1]}`} />
                      <path class="a6d-twin__shin" d={`M ${knee[0]} ${knee[1]} L ${foot[0]} ${foot[1]}`} />
                      <circle class="a6d-twin__foot" cx={foot[0]} cy={foot[1]} r="3" />
                    </g>
                  ))}
                </g>
                <rect class="a6d-twin__body" x="88" y="70" width="44" height="30" rx="8" />
                <g class="a6d-twin__arm" data-twin-arm>
                  <path class="a6d-twin__arm-upper" d="M 118 78 L 140 62" />
                  <path class="a6d-twin__arm-lower" d="M 140 62 L 156 48" />
                  <g class="a6d-twin__gripper" data-twin-gripper transform="translate(156,48)">
                    <path class="a6d-twin__gripper-finger a6d-twin__gripper-finger--a" d="M 0 0 L 8 -5" />
                    <path class="a6d-twin__gripper-finger a6d-twin__gripper-finger--b" d="M 0 0 L 8 5" />
                  </g>
                </g>
                <polygon class="a6d-twin__heading" points="110,58 116,70 110,66 104,70" />
              </svg>
            </div>
            <dl class="a6d-metric-grid a6d-metric-grid--wide">
              <div><dt class="mono">Leg servos</dt><dd class="mono">18/18</dd></div>
              <div><dt class="mono">Arm</dt><dd class="mono" data-twin-arm-value>DEFAULT</dd></div>
              <div><dt class="mono">Gripper</dt><dd class="mono" data-twin-gripper-value>OPEN</dd></div>
              <div><dt class="mono">Movement</dt><dd class="mono" data-twin-movement-value>IDLE</dd></div>
            </dl>
          </div>
        </div>

        {/* ---- Mission timeline ---- */}
        <div class="panel a6d-timeline-panel" id="mission" data-emphasis-group="collection">
          <div class="a6d-timeline-panel__head">
            <h3 class="a6d-panel-title mono">Autonomous Mission</h3>
            <span class="a6d-mission-label mono" data-mission-label>MISSION READY — awaiting demo start</span>
          </div>
          <ol class="a6d-state-machine scroll-x" data-mission-timeline>
            {missionSequence.map(([id, label], i) => (
              <li class:list={['a6d-state', { 'is-current': i === 0 }]} data-state-item data-state-id={id}>
                <span class="a6d-state__num mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="a6d-state__label mono">{label}</span>
              </li>
            ))}
          </ol>
        </div>

        {/* ---- Event log + quick control ---- */}
        <div class="a6d-grid-2 a6d-grid-2--log">
          <div class="panel a6d-log" id="log">
            <div class="a6d-log__head">
              <h3 class="a6d-panel-title mono">Event Log</h3>
              <span class="a6d-demo-chip">SIMULATED</span>
            </div>
            <ul class="a6d-log__list" data-event-log>
              <li><span class="a6d-log__time mono">—</span><span class="a6d-log__msg">SYSTEM READY · Press Run Autonomous Demo to begin.</span></li>
            </ul>
          </div>

          <div class="panel a6d-quickcontrol">
            <h3 class="a6d-panel-title mono">Manual Control Preview</h3>
            <span class="a6d-demo-chip a6d-quickcontrol__flag">NOT CONNECTED TO ROBOT</span>
            <p class="a6d-quickcontrol__locked mono" data-quickcontrol-locked hidden>
              AUTONOMOUS · Mission system has control authority
            </p>
            <div class="a6d-quickcontrol__body">
              <div class="a6d-dpad">
                <button type="button" class="a6d-dpad__btn a6d-dpad__btn--up" data-cmd-btn data-cmd="FORWARD" aria-label="Forward">↑</button>
                <button type="button" class="a6d-dpad__btn a6d-dpad__btn--left" data-cmd-btn data-cmd="LEFT" aria-label="Left">←</button>
