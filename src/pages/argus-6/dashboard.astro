---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Callout from '../../components/Callout.astro';
import Pipeline from '../../components/Pipeline.astro';
import { link } from '../../lib/link';

const sections = [
  ['status-bar', 'Status'],
  ['camera', 'Camera'],
  ['map', 'Map'],
  ['controls', 'Controls'],
  ['mission', 'Mission'],
  ['targets', 'Targets'],
  ['telemetry', 'AI & State'],
  ['health', 'System Health'],
  ['safety', 'Safety'],
  ['fit', 'Architecture Fit'],
  ['controller', 'Controller Mapping'],
  ['status-table', 'Implementation Status'],
  ['comparison', 'Today vs. Planned'],
];

const missionStates = [
  'DETECT',
  'APPROACH',
  'ALIGN',
  'STOP',
  'GRAB',
  'VERIFY',
  'ARM DEFAULT',
  'RETURN TO BIN',
  'ALIGN BIN',
  'DEPOSIT',
  'RESUME',
];
const currentStateIndex = 1; // APPROACH — demo starting point

const seedLog = [
  { time: '15:42:44', msg: 'Return-to-bin initiated' },
  { time: '15:42:39', msg: 'Arm returned to default' },
  { time: '15:42:35', msg: 'Pickup sequence initiated' },
  { time: '15:42:33', msg: 'Robot stopped' },
  { time: '15:42:31', msg: 'Alignment complete' },
  { time: '15:42:24', msg: 'Approach initiated' },
  { time: '15:42:19', msg: 'Target 04 locked' },
  { time: '15:42:18', msg: 'Target 04 detected' },
];

const targets = [
  { id: '01', label: 'TARGET 01', kind: 'Plastic bottle', confidence: '94%', position: 'Left', status: 'Locked' },
  { id: '02', label: 'TARGET 02', kind: 'Plastic container', confidence: '89%', position: 'Right', status: 'Waiting' },
  { id: '03', label: 'TARGET 03', kind: 'Can', confidence: '84%', position: 'Center', status: 'Waiting' },
];

const healthComponents = [
  { name: 'Raspberry Pi 4', state: 'ONLINE', tone: 'ok' },
  { name: 'ESP8266', state: 'ONLINE', tone: 'ok' },
  { name: 'Camera', state: 'CONNECTED', tone: 'ok' },
  { name: 'GPS', state: 'CONNECTED', tone: 'ok' },
  { name: 'IMU', state: 'CONNECTED', tone: 'ok' },
  { name: 'Light Sensor', state: 'CONNECTED', tone: 'ok' },
  { name: 'ROS 2', state: 'RUNNING', tone: 'ok' },
  { name: 'SQLite', state: 'READY', tone: 'ok' },
  { name: 'FastAPI', state: 'RUNNING', tone: 'ok' },
];

const implementationStatus: [string, string][] = [
  ['Dashboard UI', 'Concept'],
  ['Raspberry Pi backend', 'Planned'],
  ['FastAPI', 'Planned'],
  ['WebSocket telemetry', 'Planned'],
  ['ROS 2 integration', 'Planned'],
  ['Live camera', 'Planned'],
  ['AI telemetry', 'Planned'],
  ['Mission control', 'Planned'],
  ['Manual controller integration', 'Planned'],
];

const builtToday = [
  'Six-legged locomotion',
  '18-servo platform',
  'IK / gait system',
  'Robotic arm',
  'Gripper',
  'Trash collection mechanism',
  'ESP8266 low-level control',
];

const plannedSystem = [
  'Raspberry Pi high-level computer',
  'ROS 2',
  'YOLO26n perception',
  'Object tracking',
  'Target Manager',
  'GPS/IMU localization',
  'Autonomous navigation',
  'Mission Manager',
  'Dashboard',
  'Manual controller integration',
  'Persistent person alerts',
  'BH1750 lighting system',
  'Full autonomous collection workflow',
];
---

<BaseLayout
  title="ARGUS-6 Mission Control — Concept Dashboard | Farhan Saif"
  description="Concept interface for the planned ARGUS-6 robotic mission-control dashboard, covering AI perception, telemetry, navigation, mission management, manual control and system health."
  path="/argus-6/dashboard"
>
  <div class="a6d" data-argus-dashboard>
    {/* ---------------- HERO ---------------- */}
    <section class="a6d-hero">
      <span class="grid-bg" aria-hidden="true" data-parallax="0.14"></span>
      <div class="container a6d-hero__inner">
        <p class="eyebrow" data-reveal>ARGUS-6 · Interface Concept</p>
        <h1 class="a6d-hero__title" data-reveal>ARGUS-6 Mission Control</h1>
        <p class="a6d-hero__sub mono" data-reveal>Concept Dashboard</p>
        <p class="a6d-hero__desc" data-reveal>
          An interface concept for monitoring, commanding and managing the
          planned autonomous ARGUS-6 robotic platform.
        </p>
        <div class="a6d-hero__badge-row" data-reveal>
          <span class="a6d-flag">
            <span class="a6d-flag__dot" aria-hidden="true"></span>
            CONCEPT — NOT LIVE
          </span>
        </div>
        <p class="a6d-hero__note" data-reveal>
          Designed to illustrate the planned operator interface. The current
          ARGUS-6 prototype is not connected to this interface.
        </p>
        <div class="a6d-hero__links" data-reveal>
          <a class="btn" href={link('/argus-6')}>← Back to ARGUS-6</a>
          <a class="btn" href={link('/documentation')}>Documentation</a>
        </div>
      </div>
    </section>

    {/* ---------------- ON-PAGE NAV ---------------- */}
    <nav class="a6d-toc" aria-label="Dashboard sections">
      <div class="container">
        <span class="a6d-toc__label mono">Sections</span>
        <ul class="scroll-x">
          {sections.map(([id, label]) => <li><a href={`#${id}`} class="mono">{label}</a></li>)}
        </ul>
      </div>
    </nav>

    {/* ---------------- TOP STATUS BAR ---------------- */}
    <section class="section a6d-section" id="status-bar">
      <div class="container">
        <div class="a6d-statusbar panel" data-reveal>
          <div class="a6d-statusbar__id">
            <span class="a6d-statusbar__name mono">ARGUS-6</span>
            <span class="a6d-statusbar__mode mono">CONCEPT MODE</span>
          </div>

          <div class="a6d-mode-select" role="group" aria-label="Operating mode (demo)">
            <button type="button" class="a6d-mode-btn is-active" data-mode-btn data-mode="manual" aria-pressed="true">Manual</button>
            <button type="button" class="a6d-mode-btn" data-mode-btn data-mode="autonomous" aria-pressed="false">Autonomous</button>
          </div>

          <ul class="a6d-telemetry-strip">
            <li><span class="a6d-telemetry-strip__label mono">Connection</span><span class="a6d-telemetry-strip__value mono">Concept</span></li>
            <li><span class="a6d-telemetry-strip__label mono">Battery</span><span class="a6d-telemetry-strip__value mono">11.7 V</span></li>
            <li><span class="a6d-telemetry-strip__label mono">CPU</span><span class="a6d-telemetry-strip__value mono">34%</span></li>
            <li><span class="a6d-telemetry-strip__label mono">RAM</span><span class="a6d-telemetry-strip__value mono">2.1 / 4 GB</span></li>
            <li><span class="a6d-telemetry-strip__label mono">Temp</span><span class="a6d-telemetry-strip__value mono">48°C</span></li>
            <li><span class="a6d-telemetry-strip__label mono">GPS</span><span class="a6d-telemetry-strip__value mono">Simulated</span></li>
            <li><span class="a6d-telemetry-strip__label mono">IMU</span><span class="a6d-telemetry-strip__value mono">Simulated</span></li>
            <li><span class="a6d-telemetry-strip__label mono">ESP8266</span><span class="a6d-telemetry-strip__value mono">Simulated</span></li>
          </ul>
        </div>
        <p class="a6d-microcaveat mono">All values on this page are static demo data — nothing is read from a live robot.</p>
      </div>
    </section>

    {/* ---------------- CAMERA + ALERT ---------------- */}
    <section class="section band a6d-section" id="camera">
      <div class="container">
        <SectionHeading
          eyebrow="Perception"
          title="Live Camera"
          lead="This is a mission-control mock-up of the planned perception view, not a real video stream."
        />
        <div class="two-col a6d-camera-grid">
          <div class="a6d-camera panel" data-reveal>
            <div class="a6d-camera__viewport">
              <span class="a6d-camera__scanlines" aria-hidden="true"></span>
              <span class="a6d-camera__vignette" aria-hidden="true"></span>
              <span class="a6d-camera__horizon" aria-hidden="true"></span>
              <span class="a6d-camera__reticle" aria-hidden="true"></span>

              <span class="a6d-camera__corner a6d-camera__corner--tl" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--tr" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--bl" aria-hidden="true"></span>
              <span class="a6d-camera__corner a6d-camera__corner--br" aria-hidden="true"></span>

              <span class="a6d-camera__tag mono">● SIMULATED CAMERA FEED</span>

              <div class="a6d-bbox" style="left:12%; top:52%; width:16%; height:20%;" data-bbox="trash" data-reveal-none>
                <span class="a6d-bbox__label mono">TRASH <b>0.91</b> · ID 04</span>
              </div>
              <div class="a6d-bbox" style="left:34%; top:44%; width:11%; height:26%;" data-bbox="bottle">
                <span class="a6d-bbox__label mono">PLASTIC BOTTLE <b>0.87</b> · ID 01</span>
              </div>
              <div class="a6d-bbox a6d-bbox--person" style="left:66%; top:18%; width:18%; height:52%;" data-bbox="person">
                <span class="a6d-bbox__label mono">PERSON <b>0.96</b> · ID 02</span>
              </div>

              <div class="a6d-camera__readout mono">
                <span>FPS <b>28</b></span>
                <span>MODEL <b>YOLO26n</b></span>
                <span class="a6d-demo-chip">DEMO VALUES</span>
              </div>
            </div>

            <div class="a6d-detection-chips" role="group" aria-label="Simulated detections">
              <button type="button" class="a6d-chip" data-detection-chip data-detection="trash">Trash · 0.91</button>
              <button type="button" class="a6d-chip" data-detection-chip data-detection="bottle">Plastic bottle · 0.87</button>
              <button type="button" class="a6d-chip" data-detection-chip data-detection="person">Person · 0.96</button>
            </div>
          </div>

          <div class="a6d-alert-col">
            <div class="a6d-alert panel" data-reveal data-alert-panel>
              <div class="a6d-alert__head">
                <span class="a6d-alert__tag mono">PERSON DETECTED</span>
                <button type="button" class="a6d-alert__close" data-alert-dismiss aria-label="Dismiss alert">✕</button>
              </div>
              <p class="a6d-alert__body">Potential human detected in camera view.</p>
              <dl class="a6d-alert__meta">
                <div><dt class="mono">Time</dt><dd class="mono">15:42:12</dd></div>
                <div><dt class="mono">Confidence</dt><dd class="mono">0.96</dd></div>
                <div><dt class="mono">Tracking ID</dt><dd class="mono">02</dd></div>
              </dl>
              <span class="a6d-demo-chip a6d-demo-chip--tag">PLANNED AI INCIDENT ALERT</span>
            </div>
            <p class="a6d-alert-note">
              Demonstrates the planned persistent behaviour: an alert like this
              stays visible until an operator dismisses it — it does not
              auto-hide.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- MAP ---------------- */}
    <section class="section a6d-section" id="map">
      <div class="container">
        <SectionHeading
          eyebrow="Navigation"
          title="Simulated Map"
          lead="A conceptual visualization of the planned navigation view — position, route, targets and mission boundary. Built with SVG, not a mapping service."
        />
        <div class="a6d-map-grid">
          <div class="a6d-map panel" data-reveal>
            <span class="a6d-demo-chip a6d-map__tag">SIMULATED MAP</span>
            <svg viewBox="0 0 400 260" class="a6d-map__svg" role="img" aria-label="Simulated map of ARGUS-6's position, route, targets and mission boundary">
              <defs>
                <pattern id="a6d-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(255,255,255,0.05)" stroke-width="1"/>
                </pattern>
              </defs>
              <rect width="400" height="260" fill="url(#a6d-grid)" />
              <polygon points="20,20 380,20 380,240 20,240" fill="none" stroke="rgba(255,255,255,0.16)" stroke-width="1.5" stroke-dasharray="6 5" />
              <path d="M 60 210 C 120 170, 140 120, 190 100 S 280 70, 320 50" fill="none" stroke="#5b9dff" stroke-width="2" stroke-dasharray="1 8" stroke-linecap="round" />
              <circle cx="120" cy="170" r="4" fill="#8b949e" />
              <circle cx="190" cy="100" r="4" fill="#8b949e" />
              <circle cx="280" cy="70" r="4" fill="#8b949e" />
              <g transform="translate(320,50)">
                <circle r="9" fill="rgba(63,185,80,0.15)" />
                <circle r="4" fill="#3fb950" />
                <text x="12" y="4" class="a6d-map__label" fill="#9aa2ad">TARGET 01</text>
              </g>
              <g transform="translate(230,190)">
                <circle r="9" fill="rgba(217,164,65,0.15)" />
                <circle r="4" fill="#d9a441" />
                <text x="12" y="4" class="a6d-map__label" fill="#9aa2ad">TARGET 02</text>
              </g>
              <g transform="translate(60,210)">
                <rect x="-8" y="-8" width="16" height="16" rx="3" fill="#171b22" stroke="#5b9dff" stroke-width="1.5" />
                <text x="14" y="4" class="a6d-map__label" fill="#9aa2ad">BIN</text>
              </g>
              <g transform="translate(190,100) rotate(-35)">
                <polygon points="0,-11 8,9 0,4 -8,9" fill="#5b9dff" stroke="#0a0f18" stroke-width="1" />
              </g>
              <text x="202" y="126" class="a6d-map__label a6d-map__label--strong" fill="#e7e9ee">ARGUS-6</text>
            </svg>
          </div>
          <ul class="a6d-map-legend">
            <li><span class="a6d-legend-swatch" style="background:#5b9dff"></span>ARGUS-6</li>
            <li><span class="a6d-legend-swatch a6d-legend-swatch--ring" style="border-color:#3fb950"></span>Target 01</li>
            <li><span class="a6d-legend-swatch a6d-legend-swatch--ring" style="border-color:#d9a441"></span>Target 02</li>
            <li><span class="a6d-legend-swatch a6d-legend-swatch--square"></span>Collection bin</li>
            <li><span class="a6d-legend-swatch a6d-legend-swatch--dot"></span>Waypoints</li>
            <li><span class="a6d-legend-swatch a6d-legend-swatch--dash"></span>Mission boundary</li>
          </ul>
        </div>
      </div>
    </section>

    {/* ---------------- CONTROLS ---------------- */}
    <section class="section band a6d-section" id="controls">
      <div class="container">
        <SectionHeading
          eyebrow="Manual Control"
          title="Control Preview"
          lead="A mock-up of the planned manual controls. Buttons update a demo status readout only."
        />
        <span class="a6d-demo-chip a6d-controls__flag">CONTROL PREVIEW — NOT CONNECTED TO ROBOT</span>

        <div class="two-col a6d-controls-grid">
          <div class="panel a6d-controlpad" data-reveal>
            <h3 class="a6d-panel-title mono">Movement</h3>
            <div class="a6d-dpad">
              <button type="button" class="a6d-dpad__btn a6d-dpad__btn--up" data-cmd-btn data-cmd="FORWARD" aria-label="Forward">↑</button>
              <button type="button" class="a6d-dpad__btn a6d-dpad__btn--left" data-cmd-btn data-cmd="LEFT" aria-label="Left">←</button>
              <button type="button" class="a6d-dpad__btn a6d-dpad__btn--stop" data-cmd-btn data-cmd="STOP" aria-label="Stop">STOP</button>
              <button type="button" class="a6d-dpad__btn a6d-dpad__btn--right" data-cmd-btn data-cmd="RIGHT" aria-label="Right">→</button>
              <button type="button" class="a6d-dpad__btn a6d-dpad__btn--down" data-cmd-btn data-cmd="BACKWARD" aria-label="Backward">↓</button>
            </div>
            <div class="a6d-turn-row">
              <button type="button" class="btn" data-cmd-btn data-cmd="TURN LEFT">Turn Left</button>
              <button type="button" class="btn" data-cmd-btn data-cmd="TURN RIGHT">Turn Right</button>
            </div>
            <p class="a6d-last-command mono">Last command: <span data-last-command>none</span></p>
          </div>

          <div class="panel a6d-armpad" data-reveal>
            <h3 class="a6d-panel-title mono">Arm</h3>
            <ul class="a6d-joint-list">
              <li>
                <span class="a6d-joint-name mono">Base</span>
                <div class="a6d-joint-controls">
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="base" data-delta="-1" aria-label="Decrease base angle">−</button>
                  <span class="a6d-joint-value mono" data-joint-value="base">90°</span>
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="base" data-delta="1" aria-label="Increase base angle">+</button>
                </div>
              </li>
              <li>
                <span class="a6d-joint-name mono">Shoulder</span>
                <div class="a6d-joint-controls">
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="shoulder" data-delta="-1" aria-label="Decrease shoulder angle">−</button>
                  <span class="a6d-joint-value mono" data-joint-value="shoulder">45°</span>
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="shoulder" data-delta="1" aria-label="Increase shoulder angle">+</button>
                </div>
              </li>
              <li>
                <span class="a6d-joint-name mono">Elbow</span>
                <div class="a6d-joint-controls">
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="elbow" data-delta="-1" aria-label="Decrease elbow angle">−</button>
                  <span class="a6d-joint-value mono" data-joint-value="elbow">110°</span>
                  <button type="button" class="a6d-joint-btn" data-arm-btn data-joint="elbow" data-delta="1" aria-label="Increase elbow angle">+</button>
                </div>
              </li>
              <li>
                <span class="a6d-joint-name mono">Gripper</span>
                <button type="button" class="a6d-gripper-btn mono" data-gripper-btn data-gripper-value="OPEN">OPEN</button>
              </li>
            </ul>

            <h3 class="a6d-panel-title mono a6d-panel-title--spaced">Mode</h3>
            <div class="a6d-mode-explain">
              <div class="a6d-mode-explain__item" data-mode-explain="manual">
                <span class="mono">MANUAL</span>
                <p>Operator has control authority.</p>
              </div>
              <div class="a6d-mode-explain__item" data-mode-explain="autonomous">
                <span class="mono">AUTONOMOUS</span>
                <p>Mission system has control authority.</p>
              </div>
            </div>
            <p class="a6d-mode-note text-muted">
              The planned architecture supports switching between the two
              without interrupting telemetry.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- MISSION ---------------- */}
    <section class="section a6d-section" id="mission">
      <div class="container">
        <SectionHeading
          eyebrow="Mission System"
          title="Mission Management"
          lead="ENVIRONMENTAL CLEANUP — DEMO. The planned mission state machine, shown mid-run at a fixed demo state."
        />
        <div class="two-col two-col--wide-left">
          <div>
            <ol class="a6d-state-machine" data-mission-states>
              {missionStates.map((s, i) => (
                <li class:list={['a6d-state', { 'is-current': i === currentStateIndex }]} data-state-item data-index={i}>
                  <span class="a6d-state__num mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="a6d-state__label mono">{s}</span>
                </li>
              ))}
            </ol>
            <button type="button" class="btn a6d-advance-btn" data-mission-advance>Advance demo state →</button>
          </div>
          <div class="panel a6d-mission-card" data-reveal>
            <dl class="a6d-mission-meta">
              <div><dt class="mono">Target</dt><dd class="mono">Trash #04</dd></div>
              <div><dt class="mono">Distance</dt><dd class="mono">8.4 m</dd></div>
              <div><dt class="mono">Target status</dt><dd class="mono">LOCKED</dd></div>
            </dl>
            <Callout variant="caution" title="Demonstration values">
              <p>Target, distance and status figures on this panel are fixed demo values, not live mission data.</p>
            </Callout>
          </div>
        </div>
      </div>
    </section>

    {/* ---------------- TARGET SELECTION ---------------- */}
    <section class="section band a6d-section" id="targets">
      <div class="container">
        <SectionHeading
          eyebrow="Perception"
          title="Target Selection"
          lead="Simulated detections a target-management system would choose between. Select a card to preview the planned lock behaviour."
        />
        <div class="a6d-target-grid stagger">
          {targets.map((t) => (
            <button
              type="button"
              class:list={['a6d-target-card', { 'is-selected': t.status === 'Locked' }]}
              data-target-card
              data-target={t.id}
              data-reveal
            >
              <span class="a6d-target-card__id mono">{t.label}</span>
              <span class="a6d-target-card__kind">{t.kind}</span>
              <dl class="a6d-target-card__meta">
                <div><dt class="mono">Confidence</dt><dd class="mono">{t.confidence}</dd></div>
                <div><dt class="mono">Position</dt><dd class="mono">{t.position}</dd></div>
              </dl>
              <span class="a6d-target-card__status mono" data-target-status>{t.status}</span>
            </button>
          ))}
        </div>
        <Callout title="Target lock">
          <p>Prevents rapid switching between competing detections — the planned system commits to one target until it is collected or lost.</p>
        </Callout>
      </div>
    </section>

    {/* ---------------- AI STATUS + ROBOT STATE ---------------- */}
    <section class="section a6d-section" id="telemetry">
      <div class="container">
        <SectionHeading
          eyebrow="Telemetry"
          title="AI Status & Robot State"
          lead="A snapshot of the planned perception pipeline and the robot's overall demo state."
        />
        <div class="two-col">
          <div class="panel a6d-ai-card" data-reveal>
            <h3 class="a6d-panel-title mono">AI Status</h3>
            <p class="a6d-ai-model mono">Model: <b>YOLO26n</b></p>
            <Pipeline
              label="Perception pipeline"
              variant="stack"
              compact
              steps={['Camera', 'Detection', 'Tracking', 'Target Manager', 'Mission Manager']}
            />
            <dl class="a6d-metric-grid">
              <div><dt class="mono">Detections</dt><dd class="mono">3</dd></div>
              <div><dt class="mono">Tracked objects</dt><dd class="mono">3</dd></div>
              <div><dt class="mono">Model confidence</dt><dd class="mono">94%</dd></div>
              <div><dt class="mono">FPS</dt><dd class="mono">28</dd></div>
            </dl>
            <span class="a6d-demo-chip">DEMO / NOT BENCHMARKED</span>
          </div>

          <div class="panel a6d-state-card" data-reveal>
            <h3 class="a6d-panel-title mono">Robot State</h3>
            <dl class="a6d-metric-grid a6d-metric-grid--wide">
              <div><dt class="mono">Robot state</dt><dd class="mono">WALKING</dd></div>
              <div><dt class="mono">Mode</dt><dd class="mono" data-mode-value>MANUAL</dd></div>
